        echo "Steam Controller 2026: active (${DETECTED_STEAM_CONTROLLER:-forced})"
    fi
    if [[ "${AUTO_HDR_SWITCH:-0}" -eq 1 ]]; then
        echo "HDR auto-switch: ${HDR_AUTO_TARGET:-unavailable} (state=${HDR_AUTO_STATE:-unknown})"
    fi
    if [[ "$BENCH_ACTIVE" -eq 1 ]]; then
        echo "Benchmark mode: enabled (duration=${BENCH_DURATION}s)"
    fi
    echo "Exported launch variables:"
    env | LC_ALL=C sort | awk -F= '
        $1 ~ /^(PROTON_|DXVK_|VKD3D_|MESA_|ENABLE_|SDL_|WAYLANDDRV_|WINE_|FSR_|MLFG_|AMD_|RADV_|VKBASALT_|MANGOHUD|LOW_LATENCY_LAYER)/ ||
        $1 == "STEAM_COMPAT_CONFIG" {
            print
        }'
    exit 0
fi

LAST_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/steam-auto-profiler"
LAUNCH_DURATION=0
CRASH_HINT=""
CRASH_RECOVERY=""

save_safe_mode_profile() {
    local target="$1" tmp_file
    [[ -n "$target" ]] || return 1
    mkdir -p "$(dirname "$target")"
    tmp_file="${target}.tmp.$$"
    if [[ -f "$target" ]]; then
        grep -vE '^[[:space:]]*(USE_XWAYLAND|USE_SAFEDX12)=' "$target" > "$tmp_file" || true
    else
        : > "$tmp_file"
    fi
    printf 'USE_XWAYLAND=1\nUSE_SAFEDX12=1\n' >> "$tmp_file"
    mv -f "$tmp_file" "$target"
}

write_last_log() {
    local app_log="$LAST_LOG_DIR/last-${APPID:-launch}.log"
    local exit_code="${1:-0}"
    shift || true
    mkdir -p "$LAST_LOG_DIR"
    {
        printf 'timestamp=%s\n' "$(date -Is)"
        printf 'appid=%s\n' "${APPID:-unknown}"
        printf 'class=%s\n' "${AUTO_CLASS:-unknown}"
        printf 'gpu=%s\n' "${GPU_VENDOR:-unknown}"
        printf 'gamescope=%s\n' "$GAMESCOPE_SESSION"
        printf 'vrr_cap=%s\n' "${AUTO_VRR_CAP:-0}"
        printf 'duration_sec=%s\n' "${LAUNCH_DURATION:-0}"
        printf 'command='
        printf '%q ' "$@"
        printf '\n'
        printf 'exported_variables:\n'
        env | LC_ALL=C sort | awk -F= '
            $1 ~ /^(PROTON_|DXVK_|VKD3D_|WINE_|MESA_|ENABLE_|SDL_|WAYLANDDRV_|FSR_|MLFG_|AMD_|RADV_|VKBASALT_|LOW_LATENCY_LAYER)/ ||
            $1 == "STEAM_COMPAT_CONFIG" { print }
        '
        printf 'exit_code=%s\n' "$exit_code"
        if [[ -n "$CRASH_HINT" ]]; then
            printf 'crash_hint=%s\n' "$CRASH_HINT"
        fi
        if [[ -n "$CRASH_RECOVERY" ]]; then
            printf 'crash_recovery=%s\n' "$CRASH_RECOVERY"
        fi
    } > "$app_log"
    tail -n 200 "$app_log" > "$app_log.tmp"
    mv -f "$app_log.tmp" "$app_log"
    cp "$app_log" "$LAST_LOG_DIR/last-launch.log"
}

run_with_scheduler() {
    if command -v game-performance >/dev/null 2>&1; then
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run game-performance "$@"
        else
            game-performance "$@"
        fi
    elif command -v powerprofilesctl >/dev/null 2>&1; then
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run powerprofilesctl launch -p performance -- "$@"
        else
            powerprofilesctl launch -p performance -- "$@"
        fi
    elif command -v systemctl >/dev/null 2>&1 &&
         systemctl is-active --quiet ananicy-cpp.service; then
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run "$@"
        else
            "$@"
        fi
    elif command -v gamemoderun >/dev/null 2>&1; then
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run gamemoderun "$@"
        else
            gamemoderun "$@"
        fi
    else
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run "$@"
        else
            "$@"
        fi
    fi
}

NET_BOOST_BIN=""
for net_candidate in "$SCRIPT_DIR/steam-net-boost" "$HOME/.local/bin/steam-net-boost" "/usr/local/bin/steam-net-boost"; do
    if [[ -x "$net_candidate" ]]; then
        NET_BOOST_BIN="$net_candidate"
        break
    fi
done

NET_BOOST_ACTIVE=0
HDR_RESTORE_OUTPUT=""
LAUNCH_HOOKS_CLEANED=0

# shellcheck disable=SC2317
# shellcheck disable=SC2329
cleanup_launch_hooks() {
    [[ "$LAUNCH_HOOKS_CLEANED" -eq 0 ]] || return 0
    LAUNCH_HOOKS_CLEANED=1
    if [[ "$NET_BOOST_ACTIVE" -eq 1 && -n "$NET_BOOST_BIN" ]]; then
        sudo -n "$NET_BOOST_BIN" off --pid "$$" >/dev/null 2>&1 || true
    fi
    if [[ -n "$HDR_RESTORE_OUTPUT" ]] && command -v kscreen-doctor >/dev/null 2>&1; then
        kscreen-doctor "output.${HDR_RESTORE_OUTPUT}.hdr.disable" >/dev/null 2>&1 || true
    fi
}

if [[ "$USE_NET_OPT" -eq 1 && -n "$NET_BOOST_BIN" ]]; then
    NET_BOOST_ACTIVE=1
    trap cleanup_launch_hooks EXIT INT TERM
    sudo -n "$NET_BOOST_BIN" on --pid "$$" >/dev/null 2>&1 || true
fi

if [[ -n "$HDR_AUTO_TARGET" && "$HDR_AUTO_STATE" == "disabled" ]] && command -v kscreen-doctor >/dev/null 2>&1; then
    HDR_RESTORE_OUTPUT="$HDR_AUTO_TARGET"
    trap cleanup_launch_hooks EXIT INT TERM
    kscreen-doctor "output.${HDR_AUTO_TARGET}.hdr.enable" >/dev/null 2>&1 || true
fi

if [[ "$BENCH_ACTIVE" -eq 1 ]]; then
    mkdir -p "$BENCH_CSV_DIR"
fi

record_benchmark_results() {
    [[ "$BENCH_ACTIVE" -eq 1 && -d "$BENCH_CSV_DIR" ]] || return 0
    local fsr4_active=0
    if [[ "${PROTON_FSR4_UPGRADE:-0}" -eq 1 || "${PROTON_FSR4_RDNA3_UPGRADE:-0}" -eq 1 ]]; then
        fsr4_active=1
    fi
    python3 - "$BENCH_CSV_DIR" "$BENCH_DIR" "${APPID:-unknown}" "${AUTO_CLASS:-standard}" \
        "${GPU_VENDOR:-unknown}" "$fsr4_active" "${USE_MLFG:-0}" \
        "${USE_XWAYLAND:-0}" "${USE_SAFEDX12:-0}" "${AUTO_VRR_CAP:-0}" \
        "${LAUNCH_DURATION:-0}" <<'PY' 2>/dev/null || true
import csv
import datetime
import json
import math
import sys
from pathlib import Path

(
    csv_dir_s, bench_dir_s, appid, game_class, gpu,
    fsr4, mlfg, xwayland, safedx12, vrr_cap, duration_s,
) = sys.argv[1:12]

csv_dir = Path(csv_dir_s)
csv_files = sorted(csv_dir.glob("*.csv"), key=lambda p: p.stat().st_size, reverse=True)
if not csv_files:
    sys.exit(0)

csv_path = csv_files[0]
frametimes = []
with csv_path.open("r", encoding="utf-8", errors="ignore", newline="") as fh:
    reader = csv.reader(fh)
    ft_idx = None
    fps_idx = None
    for row in reader:
        if not row:
            continue
        lower = [c.strip().lower() for c in row]
        if ft_idx is None and fps_idx is None:
            if "frametime" in lower or "fps" in lower:
                ft_idx = lower.index("frametime") if "frametime" in lower else None
                fps_idx = lower.index("fps") if "fps" in lower else None
            continue
        val = None
        if ft_idx is not None and ft_idx < len(row):
            try:
                ft = float(row[ft_idx])
                if ft > 0:
                    val = ft
            except ValueError:
                pass
        if val is None and fps_idx is not None and fps_idx < len(row):
            try:
                fps = float(row[fps_idx])
                if fps > 0:
                    val = 1000.0 / fps
            except ValueError:
                pass
        if val is not None:
            frametimes.append(val)

if not frametimes:
    sys.exit(0)

s_ft = sorted(frametimes)
n = len(s_ft)
mean_ft = sum(s_ft) / n
avg_fps = round(1000.0 / mean_ft, 2)
p99_idx = min(n - 1, max(0, int(math.ceil(0.99 * n)) - 1))
p99_ft = round(s_ft[p99_idx], 2)
k_1pct = max(1, int(math.ceil(n * 0.01)))
worst_1pct = s_ft[-k_1pct:]
low_1pct_fps = round(1000.0 / (sum(worst_1pct) / len(worst_1pct)), 2)

record = {
    "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
    "appid": appid,
    "class": game_class,
    "gpu": gpu,
    "fsr4": fsr4 == "1",
    "mlfg": mlfg == "1",
    "xwayland": xwayland == "1",
    "safedx12": safedx12 == "1",
    "vrr_cap": int(vrr_cap) if vrr_cap.isdigit() else 0,
    "duration_sec": int(duration_s) if duration_s.isdigit() else 0,
    "samples": n,
    "avg_fps": avg_fps,
    "low_1pct_fps": low_1pct_fps,
    "p99_frametime_ms": p99_ft,
}

bench_dir = Path(bench_dir_s)
bench_dir.mkdir(parents=True, exist_ok=True)
out_file = bench_dir / f"{appid}.json"
existing = []
if out_file.is_file():
    try:
        loaded = json.loads(out_file.read_text(encoding="utf-8"))
        if isinstance(loaded, list):
            existing = loaded
    except (OSError, json.JSONDecodeError):
        existing = []
existing.append(record)
out_file.write_text(json.dumps(existing, indent=2) + "\n", encoding="utf-8")
PY
    rm -rf "$BENCH_CSV_DIR"
}

if [[ "$USE_KEEP_OVERLAY" -eq 1 ]]; then
    if [[ -n "$ORIG_LD_PRELOAD" ]]; then
        export LD_PRELOAD="$ORIG_LD_PRELOAD"
    else
        unset LD_PRELOAD
    fi
else
    export LD_PRELOAD=""
fi

LAUNCH_START_SEC="$SECONDS"
if run_with_scheduler "$@" "${EXTRA_ARGS[@]}"; then
    launch_exit=0
else
    launch_exit=$?
fi
LAUNCH_DURATION=$((SECONDS - LAUNCH_START_SEC))

CRASH_THRESHOLD_SEC="${SAP_CRASH_THRESHOLD_SEC:-20}"
if [[ "$launch_exit" -ne 0 &&
      "${NATIVE_RUNTIME:-0}" -ne 1 &&
      "$LAUNCH_DURATION" -lt "$CRASH_THRESHOLD_SEC" &&
      ( "$USE_XWAYLAND" -eq 0 || "$USE_SAFEDX12" -eq 0 ) ]]; then
    CRASH_HINT="fast_crash_detected duration=${LAUNCH_DURATION}s exit_code=${launch_exit} suggested_safe_mode=USE_XWAYLAND=1,USE_SAFEDX12=1"
    if [[ "${NO_GUI:-0}" -ne 1 &&
          "$GAMESCOPE_SESSION" -eq 0 &&
          -n "$PROFILE_FILE" &&
          (-n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}") ]]; then
        CRASH_PROMPT="Title (AppID: ${APPID}) exited with code ${launch_exit} after ${LAUNCH_DURATION}s while experimental Wayland/DX12 options were active.\n\nSave Safe Mode (USE_XWAYLAND=1, USE_SAFEDX12=1) for the next launch?"
        SAVE_SAFE_MODE=0
        if command -v kdialog >/dev/null 2>&1; then
            if env -u LD_LIBRARY_PATH -u LD_PRELOAD QT_QPA_PLATFORM="wayland;xcb" \
                kdialog --title "Steam Auto-Profiler: Fast Crash Detected" \
                --yesno "$CRASH_PROMPT" 2>/dev/null; then
                SAVE_SAFE_MODE=1
            fi
        elif command -v zenity >/dev/null 2>&1; then
            if env -u LD_LIBRARY_PATH -u LD_PRELOAD GDK_BACKEND="wayland,x11" \
                zenity --question --title="Steam Auto-Profiler: Fast Crash Detected" \
                --text="$CRASH_PROMPT" 2>/dev/null; then
                SAVE_SAFE_MODE=1
            fi
        fi
        if [[ "$SAVE_SAFE_MODE" -eq 1 ]]; then
            save_safe_mode_profile "$PROFILE_FILE"
            CRASH_RECOVERY="safe_mode_saved"
        fi
    fi
fi

record_benchmark_results
write_last_log "$launch_exit" "$@" "${EXTRA_ARGS[@]}"
exit "$launch_exit"
