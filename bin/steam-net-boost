#!/usr/bin/env bash

set -euo pipefail

if [[ "$(id -u)" -eq 0 ]]; then
    export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
else
    for _snb_dir in /usr/sbin /usr/bin /sbin /bin; do
        case ":${PATH:-}:" in
            *:"$_snb_dir":*) ;;
            *) PATH="${PATH:+${PATH}:}$_snb_dir" ;;
        esac
    done
    export PATH
fi

STATE_DIR="${STEAM_NET_BOOST_STATE_DIR:-/run/steam-net-boost}"
MODE=""
IFACE=""
PID=""

usage() { echo "Usage: steam-net-boost {on|off|status} [--iface IFACE] [--pid PID]" >&2; }
valid_iface() {
    [[ "$1" =~ ^[a-zA-Z0-9_.:-]+$ && "$1" != *..* && -d "/sys/class/net/$1" ]]
}
default_iface() {
    ip -o -4 route show to default 2>/dev/null | awk 'NR==1 {print $5; exit}'
}
ensure_state() {
    [[ ! -L "$STATE_DIR" ]] || { echo "Refusing symlink state directory" >&2; exit 1; }
    [[ -e "$STATE_DIR" ]] || mkdir -p "$STATE_DIR"
    [[ -d "$STATE_DIR" ]] || { echo "Invalid state directory" >&2; exit 1; }
    if [[ "$(id -u)" -eq 0 ]]; then
        chown root:root "$STATE_DIR" 2>/dev/null || true
        chmod 700 "$STATE_DIR" 2>/dev/null || true
    fi
}
prune_stale() {
    local iface="${1:-}" f p
    [[ -d "$STATE_DIR" ]] || return 0
    for f in "$STATE_DIR"/*.pid; do
        [[ -f "$f" ]] || continue
        p="$(cat "$f" 2>/dev/null || true)"
        if [[ -n "$iface" && "$f" != "$STATE_DIR/$iface."*".pid" ]]; then
            continue
        fi
        if [[ ! "$p" =~ ^[0-9]+$ ]] || ! kill -0 "$p" 2>/dev/null; then
            rm -f "$f"
        fi
    done
}
eee_state() {
    ethtool --show-eee "$1" 2>/dev/null | awk -F: '
        /EEE status/ {v=$2} /enabled:/ {v=$2}
        END {gsub(/[[:space:]]/, "", v); if (tolower(v) ~ /disabled|no/) print "off"; else if (tolower(v) ~ /enabled|yes/) print "on"; else print "unknown"}'
}
is_cake() {
    if command -v systemctl >/dev/null 2>&1 && (
        systemctl is-active --quiet wan-cake-shaper.service 2>/dev/null ||
        systemctl is-active --quiet cake-shaper.service 2>/dev/null
    ); then
        return 0
    fi
    local qdisc_out
    qdisc_out="$(tc qdisc show dev "$1" 2>/dev/null || true)"
    if grep -Eiq '(^|[[:space:]])qdisc[[:space:]]+cake([[:space:]]|$).*((bandwidth|rate)[[:space:]]+[0-9]|parent[[:space:]]+[0-9a-fA-F]+:)' <<<"$qdisc_out"; then
        return 0
    fi
    if grep -Eiq '(^|[[:space:]])qdisc[[:space:]]+htb([[:space:]]|$)' <<<"$qdisc_out" &&
       grep -Eiq '(^|[[:space:]])qdisc[[:space:]]+cake([[:space:]]|$)' <<<"$qdisc_out"; then
        return 0
    fi
    return 1
}
root_qdisc() {
    tc qdisc show dev "$1" 2>/dev/null | awk 'NR==1 {print $2}'
}
parse() {
    [[ $# -gt 0 ]] || { usage; exit 2; }
    MODE="$1"; shift
    [[ "$MODE" == on || "$MODE" == off || "$MODE" == status ]] || { usage; exit 2; }
    while (($#)); do
        case "$1" in
            --iface) (($# >= 2)) || { usage; exit 2; }; IFACE="$2"; shift 2 ;;
            --pid) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { usage; exit 2; }; PID="$2"; shift 2 ;;
            --) shift; (($# == 0)) || { usage; exit 2; } ;;
            *) [[ -z "$IFACE" ]] || { usage; exit 2; }; IFACE="$1"; shift ;;
        esac
    done
    IFACE="${IFACE:-$(default_iface)}"
    if [[ -z "$IFACE" ]] || ! valid_iface "$IFACE"; then
        echo "Invalid network interface: ${IFACE:-<none>}" >&2
        exit 2
    fi
    [[ -n "$PID" ]] || PID="${PPID:-$$}"
}
on() {
    local state="$STATE_DIR/$IFACE.state" pidfile="$STATE_DIR/$IFACE.$PID.pid" count=0 old_eee static_cake=no orig_qdisc f
    prune_stale "$IFACE"
    [[ -f "$pidfile" ]] && return 0
    [[ -f "$state" ]] && count="$(awk -F= '$1=="count"{print $2}' "$state")"
    if (( count == 0 )); then
        old_eee="$(eee_state "$IFACE")"
        static_cake="$(is_cake "$IFACE" && echo yes || echo no)"
        orig_qdisc="$(root_qdisc "$IFACE")"
        printf 'count=0\neee=%s\ncake=%s\nqdisc=%s\ntx=%s\n' \
            "$old_eee" "$static_cake" "${orig_qdisc:-fq_codel}" \
            "$(cat "/sys/class/net/$IFACE/tx_queue_len" 2>/dev/null || echo 1000)" > "$state"
        if [[ "$static_cake" != yes ]] && command -v tc >/dev/null 2>&1; then
            tc qdisc replace dev "$IFACE" root cake diffserv4 triple-isolate 2>/dev/null ||
                tc qdisc replace dev "$IFACE" root fq_codel 2>/dev/null || true
        fi
        if [[ "$static_cake" != yes ]]; then
            ethtool --set-eee "$IFACE" eee off 2>/dev/null || true
            ip link set dev "$IFACE" txqueuelen 500 2>/dev/null || true
        fi
    fi
    printf '%s\n' "$PID" > "$pidfile"
    count=0
    for f in "$STATE_DIR/$IFACE."*.pid; do
        [[ -f "$f" ]] && count=$((count + 1))
    done
    sed -i "s/^count=.*/count=$count/" "$state"
}
off() {
    local state="$STATE_DIR/$IFACE.state" pidfile="$STATE_DIR/$IFACE.$PID.pid" count=0 old orig_qdisc f
    prune_stale "$IFACE"
    rm -f "$pidfile"
    [[ -f "$state" ]] || return 0
    for f in "$STATE_DIR/$IFACE."*.pid; do
        [[ -f "$f" ]] && count=$((count + 1))
    done
    sed -i "s/^count=.*/count=$count/" "$state"
    (( count > 0 )) && return 0
    old="$(awk -F= '$1=="eee"{print $2}' "$state")"
    if [[ "$(awk -F= '$1=="cake"{print $2}' "$state")" != yes ]]; then
        orig_qdisc="$(awk -F= '$1=="qdisc"{print $2}' "$state")"
        if [[ "$orig_qdisc" == "cake" ]]; then
            tc qdisc replace dev "$IFACE" root cake 2>/dev/null || true
        elif [[ "$orig_qdisc" != "htb" ]]; then
            tc qdisc replace dev "$IFACE" root fq_codel 2>/dev/null || true
        fi
        ip link set dev "$IFACE" txqueuelen "$(awk -F= '$1=="tx"{print $2}' "$state")" 2>/dev/null || true
        if [[ "$old" == on ]]; then
            ethtool --set-eee "$IFACE" eee on 2>/dev/null || true
        elif [[ "$old" == off ]]; then
            ethtool --set-eee "$IFACE" eee off 2>/dev/null || true
        fi
    fi
    rm -f "$state"
}
status() {
    local state="$STATE_DIR/$IFACE.state" count=0 static=no f p qdisc
    [[ ! -L "$STATE_DIR" ]] || { echo "Refusing symlink state directory" >&2; exit 1; }
    if [[ -d "$STATE_DIR" ]]; then
        if [[ -r "$STATE_DIR" ]]; then
            if [[ -r "$state" ]]; then
                [[ "$(awk -F= '$1=="cake"{print $2}' "$state")" == yes ]] && static=yes
            elif is_cake "$IFACE"; then
                static=yes
            fi
            for f in "$STATE_DIR/$IFACE."*.pid; do
                [[ -f "$f" && -r "$f" ]] || continue
                p="$(cat "$f" 2>/dev/null || true)"
                if [[ "$p" =~ ^[0-9]+$ ]] && { kill -0 "$p" 2>/dev/null || [[ -d "/proc/$p" ]]; }; then
                    count=$((count + 1))
                fi
            done
        else
            count="unknown"
            if is_cake "$IFACE"; then
                static=yes
            fi
        fi
    elif is_cake "$IFACE"; then
        static=yes
    fi
    qdisc="$(root_qdisc "$IFACE")"
    printf 'interface=%s active_sessions=%s qdisc=%s static_cake=%s eee=%s\n' \
        "$IFACE" "$count" "${qdisc:-unknown}" "$static" "$(eee_state "$IFACE")"
}

with_state_lock() {
    local fn="$1"
    if command -v flock >/dev/null 2>&1; then
        (
            flock -x 9
            "$fn"
        ) 9>"$STATE_DIR/.lock"
    else
        "$fn"
    fi
}

parse "$@"
case "$MODE" in
    on)
        ensure_state
        with_state_lock on
        ;;
    off)
        ensure_state
        with_state_lock off
        ;;
    status)
        status
        ;;
esac
