if [[ "$AUTO_NATIVE_LINUX" -eq 1 ]]; then
    NATIVE_RUNTIME=1
    for launch_arg in "$@"; do
        case "${launch_arg,,}" in
            *proton*|*wine*|*umu-run*) NATIVE_RUNTIME=0 ;;
        esac
    done
    [[ "$NATIVE_RUNTIME" -eq 1 ]] || unset NATIVE_RUNTIME
fi

if [[ "$AUTO_NATIVE_LINUX" -eq 1 && "${NATIVE_RUNTIME:-0}" -eq 1 ]]; then
    unset PROTON_ADD_CONFIG STEAM_COMPAT_CONFIG PROTON_MLFG_UPGRADE MLFG_UPGRADE
    unset PROTON_FSR4_UPGRADE PROTON_FSR4_RDNA3_UPGRADE PROTON_USE_OPTISCALER
    unset LOW_LATENCY_LAYER LOW_LATENCY_LAYER_REFLEX
    while IFS='=' read -r env_name _; do
        case "$env_name" in
            PROTON_*|WINE_*|DXVK_*|VKD3D_*)
                unset "$env_name"
                ;;
        esac
    done < <(env)
fi

