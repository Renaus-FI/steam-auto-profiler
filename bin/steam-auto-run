#!/usr/bin/env bash

# Context-aware pre-launch orchestrator for Steam on Linux.

set -euo pipefail

ORIG_LD_PRELOAD="${LD_PRELOAD:-}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DETECT_BIN=""
for candidate in "$SCRIPT_DIR/steam-auto-detect" "$HOME/.local/bin/steam-auto-detect" "/usr/local/bin/steam-auto-detect"; do
    if [[ -x "$candidate" ]]; then
        DETECT_BIN="$candidate"
        break
    fi
done

PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/steam-auto-profiler/profiles"
mkdir -p "$PROFILE_DIR"

usage() {
    cat <<'EOF'
Usage:
  steam-auto-run %command%
  steam-auto-run [OPTIONS] [APPID]

Options:
  --help, -h        Show this help message
  --inspect         Run the heuristic scanner
  --configure       Force-open the optional configuration GUI
  --reset APPID     Remove a saved profile
  --doctor, --check-system
                    Run a read-only CachyOS system readiness audit

Environment overrides:
  FORCE_GUI=1       Re-open the GUI for a saved profile
  NO_GUI=1          Run silently
  VRR_CAP=<fps>     Override the calculated VRR frame cap
  XWAYLAND=1        Force XWayland
  MLFG=1            Enable frame generation
  NETOPT=1          Enable the optional network profile
  SDL=1             Prefer native SDL/Steam Input emulation
  KEEP_OVERLAY=1    Preserve LD_PRELOAD for Steam Overlay
  NO_NTSYNC=1       Disable NTSync for legacy titles
  NO_DECORATION=1   Disable WM decorations
  PRIME=1           Use prime-run for hybrid GPU launch
  FSR4=0            Disable the native FSR4 upgrade
  FSR_HUD=1         Enable the FSR/DLSS HUD indicator
EOF
}

run_doctor() {
    echo "=== Steam Auto-Profiler: CachyOS System Doctor ==="

    local kernel
    kernel="$(uname -r)"
    echo "[INFO] Kernel: $kernel"
    if [[ -c /dev/ntsync ]]; then
        echo "[OK] /dev/ntsync is character-device accessible"
    else
        echo "[WARN] /dev/ntsync is unavailable; Proton may fall back to fsync/esync (override: PROTON_NO_NTSYNC=1)"
    fi

    local pstate=""
    if [[ -r /sys/devices/system/cpu/amd_pstate/status ]]; then
        pstate="$(cat /sys/devices/system/cpu/amd_pstate/status)"
    elif [[ -r /sys/devices/system/cpu/intel_pstate/status ]]; then
        pstate="$(cat /sys/devices/system/cpu/intel_pstate/status)"
    fi
    [[ -n "$pstate" ]] && echo "[INFO] CPU P-State: $pstate" || echo "[INFO] CPU P-State: managed outside amd_pstate/intel_pstate"

    if [[ -r /sys/kernel/sched_ext/state ]]; then
        local sched_ext
        sched_ext="$(cat /sys/kernel/sched_ext/state)"
        echo "[INFO] sched-ext state: $sched_ext"
    else
        echo "[INFO] sched-ext state: unavailable"
    fi
    if command -v scxctl >/dev/null 2>&1; then
        echo "[INFO] scxctl get: $(scxctl get 2>/dev/null | tr '\n' ' ')"
    elif command -v scx_loader >/dev/null 2>&1; then
        echo "[INFO] scx_loader: installed"
    else
        echo "[INFO] sched-ext loader: not detected"
    fi

    if (pgrep -x gamemoded >/dev/null 2>&1) &&
       systemctl is-active --quiet ananicy-cpp.service 2>/dev/null; then
        echo "[WARN] gamemode and ananicy-cpp are both active; this may cause process-niceness conflicts"
    elif systemctl is-active --quiet ananicy-cpp.service 2>/dev/null; then
        echo "[INFO] ananicy-cpp is active"
    else
        echo "[OK] No gamemode/ananicy-cpp conflict detected"
    fi

    if command -v eac-status >/dev/null 2>&1; then
        if [[ "$(id -u)" -eq 0 ]]; then
            echo "[INFO] Easy Anti-Cheat readiness:"
            eac-status 2>&1 | sed 's/^/  /' || true
        elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
            echo "[INFO] Easy Anti-Cheat readiness:"
            sudo -n eac-status 2>&1 | sed 's/^/  /' || true
        else
            local lockdown_state
            lockdown_state="$(head -n1 /sys/kernel/security/lockdown 2>/dev/null || echo "unknown")"
            echo "[OK] Easy Anti-Cheat (Linux v2): eac-status is installed"
            echo "[INFO] Kernel: $kernel; lockdown: $lockdown_state"
            echo "[INFO] Run 'sudo eac-status' for full hardware-attestation details"
        fi
    elif [[ "$kernel" == *-cachyos-eac* ]]; then
        echo "[INFO] CachyOS EAC kernel detected: $kernel"
        echo "[INFO] Verify Secure Boot, TPM 2.0, lockdown=integrity and IOMMU for Linux EAC v2"
    else
        echo "[INFO] eac-status is not installed and no -cachyos-eac kernel is active"
    fi

    local max_map
    max_map="$(sysctl -n vm.max_map_count 2>/dev/null || true)"
    if [[ -n "$max_map" ]] && (( max_map >= 2147483642 )); then
        echo "[OK] vm.max_map_count=$max_map"
    elif [[ -n "$max_map" ]]; then
        echo "[WARN] vm.max_map_count=$max_map; CachyOS recommends >= 2147483642"
    else
        echo "[WARN] vm.max_map_count could not be read"
    fi

    local nvme_schedulers=0
    for scheduler_file in /sys/block/nvme*/queue/scheduler; do
        [[ -r "$scheduler_file" ]] || continue
        nvme_schedulers=1
        echo "[INFO] NVMe scheduler $(dirname "$(dirname "$scheduler_file")" | xargs basename): $(cat "$scheduler_file")"
    done
    (( nvme_schedulers == 1 )) || echo "[INFO] No NVMe block devices detected"

    local env_conf="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
    if [[ -d "$env_conf" ]]; then
        local cache_lines=""
        cache_lines="$(grep -hE 'MESA_SHADER_CACHE_MAX_SIZE|__GL_SHADER_DISK_CACHE_(SIZE|SKIP_CLEANUP)' "$env_conf"/*.conf 2>/dev/null || true)"
        if [[ -n "$cache_lines" ]]; then
            echo "[OK] Shader cache environment settings:"
            printf '%s\n' "$cache_lines" | sed 's/^/  /'
        else
            echo "[INFO] No MESA/NVIDIA shader cache override found in $env_conf"
        fi
    else
        echo "[INFO] $env_conf does not exist"
    fi

    local compat_dir="${HOME}/.steam/steam/compatibilitytools.d"
    local flatpak_compat="${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"
    local found_proton=0
    for proton_dir in "$compat_dir" "$flatpak_compat"; do
        [[ -d "$proton_dir" ]] || continue
        for tool in "$proton_dir"/*; do
            [[ -d "$tool" ]] || continue
            local tool_name
            tool_name="$(basename "$tool")"
            case "$tool_name" in
                *proton-cachyos-slr*|*Proton-EM*|*Proton-GE*|*Experimental*)
                    echo "[INFO] Proton compatibility tool: $tool_name"
                    found_proton=1
                    ;;
                *proton-cachyos-native*)
                    echo "[WARN] Native Proton-CachyOS detected: prefer proton-cachyos-slr under SteamRT3/SteamRT4"
                    found_proton=1
                    ;;
            esac
        done
    done
    (( found_proton == 1 )) || echo "[INFO] No community Proton compatibility tool directory was detected"
}

CONFIGURE_ONLY=0
case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    --inspect|-i)
        if [[ -n "$DETECT_BIN" ]]; then
            exec "$DETECT_BIN" --inspect "${2:-}"
        fi
        echo "Error: steam-auto-detect not found." >&2
        exit 1
        ;;
    --doctor|--check-system)
        run_doctor
        exit 0
        ;;
    --reset)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: steam-auto-run --reset APPID" >&2
            exit 2
        fi
        rm -f "$PROFILE_DIR/$2.env"
        echo "Profile reset for AppID $2."
        exit 0
        ;;
    --configure)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: steam-auto-run --configure APPID" >&2
            exit 2
        fi
        export SteamAppId="$2"
        export FORCE_GUI=1
        CONFIGURE_ONLY=1
        shift 2
        ;;
esac

COMMAND_TOKEN_COUNT=0
for launch_arg in "$@"; do
    if [[ "$launch_arg" == *"%command%"* ]]; then
        COMMAND_TOKEN_COUNT=$((COMMAND_TOKEN_COUNT + 1))
    fi
done
if [[ "$COMMAND_TOKEN_COUNT" -gt 1 ]]; then
    echo "Error: refusing to wrap multiple %command% tokens." >&2
    exit 2
fi
if [[ "$CONFIGURE_ONLY" -eq 0 && "$#" -eq 0 ]]; then
    echo "Error: empty launch command. Set Steam launch options to: steam-auto-run %command%" >&2
    exit 2
fi

detect_gpu_vendor() {
    local vendor_file
    for vendor_file in /sys/class/drm/card*/device/vendor; do
        [[ -r "$vendor_file" ]] || continue
        case "$(cat "$vendor_file" 2>/dev/null)" in
            0x1002) echo amd; return ;;
            0x10de) echo nvidia; return ;;
            0x8086) echo intel; return ;;
        esac
    done
    echo unknown
}

detect_vrr_cap() {
    if [[ -n "${VRR_CAP:-}" ]]; then
        echo "$VRR_CAP"
        return
    fi

    local hz=""
    if command -v kscreen-doctor >/dev/null 2>&1; then
        hz=$(
            kscreen-doctor -o 2>/dev/null \
                | grep -oE '[0-9]+(\.[0-9]+)?Hz' \
                | tr -d 'Hz' | sort -nr | head -n1 | cut -d. -f1
        )
    elif command -v wlr-randr >/dev/null 2>&1; then
        hz=$(
            wlr-randr 2>/dev/null \
                | awk '/current/ {for(i=1;i<=NF;i++) if($i ~ /Hz/) print $(i-1)}' \
                | sort -nr | head -n1 | cut -d. -f1
        )
    elif command -v xrandr >/dev/null 2>&1; then
        hz=$(
            xrandr --current 2>/dev/null \
                | grep -oE '[0-9]+\.[0-9]+\*' \
                | tr -d '*' | sort -nr | head -n1 | cut -d. -f1
        )
    fi

    if [[ -n "$hz" ]] && (( hz > 60 )); then
        echo $((hz * 94 / 100))
    else
        echo 0
    fi
}

detect_rdna3() {
    local modalias
    for modalias in /sys/class/drm/card*/device/uevent; do
        [[ -r "$modalias" ]] || continue
        if grep -qiE 'PCI_ID=1002:(744C|745E|747E|7480|740F)' "$modalias"; then
            echo 1
            return
        fi
    done
    if command -v lspci >/dev/null 2>&1 &&
        lspci -nn 2>/dev/null | grep -qiE '1002:(744c|745e|747e|7480|740f)'; then
        echo 1
        return
    fi
    echo 0
}

GPU_VENDOR="$(detect_gpu_vendor)"
AUTO_VRR_CAP="$(detect_vrr_cap)"
AUTO_RDNA3="$(detect_rdna3)"

export LD_PRELOAD=""

if [[ "$GPU_VENDOR" == "amd" ]]; then
    export AMD_VULKAN_ICD="${AMD_VULKAN_ICD:-RADV}"
    export RADV_PERFTEST="${RADV_PERFTEST:-sam}"
fi

export MESA_DISK_CACHE_SINGLE_FILE="${MESA_DISK_CACHE_SINGLE_FILE:-1}"
export MESA_SHADER_CACHE_MAX_SIZE="${MESA_SHADER_CACHE_MAX_SIZE:-64G}"
export PROTON_LOCAL_SHADER_CACHE="${PROTON_LOCAL_SHADER_CACHE:-1}"
export PROTON_USE_PIPEWIRE="${PROTON_USE_PIPEWIRE:-1}"

APPID="${SteamAppId:-${STEAM_COMPAT_APP_ID:-${GAMEID:-}}}"
APPID="${APPID#umu-}"
PROFILE_FILE=""
[[ -n "$APPID" ]] && PROFILE_FILE="$PROFILE_DIR/$APPID.env"

USE_XWAYLAND=0
USE_MLFG=0
USE_OPTISCALER=0
USE_SHARPEN=0
USE_NET_OPT=0
USE_SDL=0
USE_CEF_FIX=0
USE_FSR_HUD=0
USE_VULKAN=0
USE_SAFEDX12=0
USE_KEEP_OVERLAY=0
USE_NO_NTSYNC=0
USE_NO_DECORATION=0

AUTO_CLASS="standard"
AUTO_PRESET="standard"
AUTO_OPTISCALER=0
AUTO_SHARPEN=0
AUTO_NET_OPT=0
AUTO_CEF_FIX=0
AUTO_REASON=""

if [[ -n "$DETECT_BIN" ]]; then
    eval "$("$DETECT_BIN" "$APPID")"
fi

SKIP_GUI=0
if [[ -n "$PROFILE_FILE" && -f "$PROFILE_FILE" && "${FORCE_GUI:-0}" -ne 1 ]]; then
    # shellcheck disable=SC1090
    source "$PROFILE_FILE"
    SKIP_GUI=1
else
    USE_OPTISCALER="$AUTO_OPTISCALER"
    USE_SHARPEN="$AUTO_SHARPEN"
    USE_NET_OPT="$AUTO_NET_OPT"
    USE_CEF_FIX="$AUTO_CEF_FIX"
    if [[ "$AUTO_CLASS" == "competitive-anticheat" ]]; then
        USE_SHARPEN=0
        USE_NO_DECORATION=0
    fi
fi

flag_kd() { [[ "${1:-0}" -eq 1 ]] && echo on || echo off; }
flag_zn() { [[ "${1:-0}" -eq 1 ]] && echo TRUE || echo FALSE; }

GAMESCOPE_SESSION=0
if [[ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" || "${XDG_CURRENT_DESKTOP:-}" == "gamescope" ]]; then
    GAMESCOPE_SESSION=1
fi

if [[ "$SKIP_GUI" -eq 0 &&
      ( "$GAMESCOPE_SESSION" -eq 0 || "${FORCE_GUI:-0}" -eq 1 ) &&
      "${NO_GUI:-0}" -ne 1 &&
      (-n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}") ]]; then
    SELECTED=""
    EXIT_CODE=1
    DIALOG_TEXT="Detected class: [$AUTO_CLASS] - ${AUTO_REASON:-Ready}\nSelect launch options:"

    if command -v kdialog >/dev/null 2>&1; then
        SELECTED=$(
            env -u LD_LIBRARY_PATH -u LD_PRELOAD QT_QPA_PLATFORM="wayland;xcb" \
                kdialog --title "Steam Auto-Profiler (AppID: ${APPID:-Local})" \
                --separate-output --checklist "$DIALOG_TEXT" \
                xwayland "Use XWayland instead of native Wayland" "$(flag_kd "$USE_XWAYLAND")" \
                mlfg "Enable frame generation" "$(flag_kd "$USE_MLFG")" \
                optiscaler "Optional upscaler bridge" "$(flag_kd "$USE_OPTISCALER")" \
                sharpen "Post-process sharpening" "$(flag_kd "$USE_SHARPEN")" \
                netopt "Session network QoS" "$(flag_kd "$USE_NET_OPT")" \
                cef "CEF launcher Wayland fix" "$(flag_kd "$USE_CEF_FIX")" \
                keepoverlay "Preserve Steam Overlay (LD_PRELOAD)" "$(flag_kd "$USE_KEEP_OVERLAY")" \
                ntsync "Disable NTSync (legacy title)" "$(flag_kd "$USE_NO_NTSYNC")" \
                nodecor "Disable window decorations" "$(flag_kd "$USE_NO_DECORATION")" \
                remember "Save profile for future launches" off 2>/dev/null
        )
        EXIT_CODE=$?
    elif command -v zenity >/dev/null 2>&1; then
        SELECTED=$(
            env -u LD_LIBRARY_PATH -u LD_PRELOAD GDK_BACKEND="wayland,x11" \
                zenity --list --checklist --title="Steam Auto-Profiler" \
                --text="$DIALOG_TEXT" --column="" --column="Code" --column="Setting" \
                --hide-column=2 --separator=$'\n' \
                "$(flag_zn "$USE_XWAYLAND")" xwayland "Use XWayland instead of native Wayland" \
                "$(flag_zn "$USE_MLFG")" mlfg "Enable frame generation" \
                "$(flag_zn "$USE_OPTISCALER")" optiscaler "Optional upscaler bridge" \
                "$(flag_zn "$USE_SHARPEN")" sharpen "Post-process sharpening" \
                "$(flag_zn "$USE_NET_OPT")" netopt "Session network QoS" \
                "$(flag_zn "$USE_CEF_FIX")" cef "CEF launcher Wayland fix" \
                "$(flag_zn "$USE_KEEP_OVERLAY")" keepoverlay "Preserve Steam Overlay (LD_PRELOAD)" \
                "$(flag_zn "$USE_NO_NTSYNC")" ntsync "Disable NTSync (legacy title)" \
                "$(flag_zn "$USE_NO_DECORATION")" nodecor "Disable window decorations" \
                FALSE remember "Save profile for future launches" 2>/dev/null
        )
        EXIT_CODE=$?
    fi

    if [[ "$EXIT_CODE" -eq 0 ]]; then
        USE_XWAYLAND=0
        USE_MLFG=0
        USE_OPTISCALER=0
        USE_SHARPEN=0
        USE_NET_OPT=0
        USE_CEF_FIX=0
        USE_KEEP_OVERLAY=0
        USE_NO_NTSYNC=0
        USE_NO_DECORATION=0
        SAVE_PROFILE=0

        for choice in $SELECTED; do
            case "$choice" in
                xwayland) USE_XWAYLAND=1 ;;
                mlfg) USE_MLFG=1 ;;
                optiscaler) USE_OPTISCALER=1 ;;
                sharpen) USE_SHARPEN=1 ;;
                netopt) USE_NET_OPT=1 ;;
                cef) USE_CEF_FIX=1 ;;
                keepoverlay) USE_KEEP_OVERLAY=1 ;;
                ntsync) USE_NO_NTSYNC=1 ;;
                nodecor) USE_NO_DECORATION=1 ;;
                remember) SAVE_PROFILE=1 ;;
            esac
        done

        if [[ "$SAVE_PROFILE" -eq 1 && -n "$PROFILE_FILE" ]]; then
            cat >"$PROFILE_FILE" <<EOF
USE_XWAYLAND=$USE_XWAYLAND
USE_MLFG=$USE_MLFG
USE_OPTISCALER=$USE_OPTISCALER
USE_SHARPEN=$USE_SHARPEN
USE_NET_OPT=$USE_NET_OPT
USE_CEF_FIX=$USE_CEF_FIX
USE_KEEP_OVERLAY=$USE_KEEP_OVERLAY
USE_NO_NTSYNC=$USE_NO_NTSYNC
USE_NO_DECORATION=$USE_NO_DECORATION
AUTO_PRESET=$AUTO_PRESET
EOF
        fi
    fi
fi

[[ "${XWAYLAND:-0}" -eq 1 ]] && USE_XWAYLAND=1
[[ "${MLFG:-0}" -eq 1 ]] && USE_MLFG=1
[[ "${OPTISCALER:-0}" -eq 1 ]] && USE_OPTISCALER=1
[[ "${SHARPEN:-0}" -eq 1 || "${RCAS:-0}" -eq 1 ]] && USE_SHARPEN=1
[[ "${NETOPT:-0}" -eq 1 ]] && USE_NET_OPT=1
[[ "${CEF:-0}" -eq 1 ]] && USE_CEF_FIX=1
[[ "${VULKAN:-0}" -eq 1 ]] && USE_VULKAN=1
[[ "${SDL:-0}" -eq 1 ]] && USE_SDL=1
[[ "${FSR_HUD:-0}" -eq 1 ]] && USE_FSR_HUD=1
[[ "${KEEP_OVERLAY:-0}" -eq 1 ]] && USE_KEEP_OVERLAY=1
[[ "${SAFEDX12:-0}" -eq 1 ]] && USE_SAFEDX12=1
[[ "${NO_NTSYNC:-0}" -eq 1 ]] && USE_NO_NTSYNC=1
[[ "${NO_DECORATION:-0}" -eq 1 ]] && USE_NO_DECORATION=1

if [[ "$AUTO_CLASS" == "competitive-anticheat" ]]; then
    USE_OPTISCALER=0
    USE_MLFG=0
    USE_NO_DECORATION=0
    export PROTON_USE_OPTISCALER=0
    # Async shader pipelines must stay disabled for anti-cheat/multiplayer titles.
    export PROTON_DXVK_SAREK=0
    export PROTON_DXVK_GPLASYNC=0
    export PROTON_DXVK_LLASYNC=0
    export WAYLANDDRV_SHORTCUT_INHIBIT=0
    export NO_DECORATION=0
    export NO_WM_DECORATION=0
    export PROTON_NO_WM_DECORATION=0
    export WINE_NO_WM_DECORATION=0
    export PROTON_DXVK_LOWLATENCY=1
    export PROTON_VKD3D_LOWLATENCY=1
fi

if [[ "$GAMESCOPE_SESSION" -eq 1 ]]; then
    : # Gamescope owns display backend and window flags.
elif [[ "$USE_XWAYLAND" -eq 1 ]]; then
    export PROTON_ENABLE_WAYLAND=0
    export SDL_VIDEODRIVER=x11
else
    export PROTON_ENABLE_WAYLAND=1
    export PROTON_USE_WAYLAND="${PROTON_USE_WAYLAND:-1}"
    export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland,x11}"
    export WINE_DISABLE_VULKAN_OPWR="${WINE_DISABLE_VULKAN_OPWR:-1}"
    if [[ "${DXVK_NO_HDR:-0}" != "1" ]]; then
        export DXVK_HDR="${DXVK_HDR:-1}"
    fi
fi

if [[ "$GPU_VENDOR" == "nvidia" ]]; then
    export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
    export DXVK_NVAPI_VKREFLEX="${DXVK_NVAPI_VKREFLEX:-1}"
fi

if [[ "$USE_SDL" -eq 1 ]]; then
    export PROTON_PREFER_SDL=1
    export PROTON_USE_SDL=1
    export PROTON_NO_STEAMINPUT=1
    export PROTON_EMULATE_STEAMINPUT="${PROTON_EMULATE_STEAMINPUT:-1}"
fi

if [[ "${NO_WM_DECORATION:-0}" -eq 1 ]]; then
    export PROTON_NO_WM_DECORATION="${PROTON_NO_WM_DECORATION:-1}"
    export WINE_NO_WM_DECORATION="${WINE_NO_WM_DECORATION:-1}"
fi
if [[ "$USE_NO_DECORATION" -eq 1 || "${NO_DECORATION:-0}" -eq 1 ]]; then
    export PROTON_NO_WM_DECORATION="${PROTON_NO_WM_DECORATION:-1}"
    export WINE_NO_WM_DECORATION="${WINE_NO_WM_DECORATION:-1}"
fi
if [[ "$USE_NO_NTSYNC" -eq 1 ]]; then
    export PROTON_NO_NTSYNC=1
fi
if [[ -n "${WINE_WMCLASS:-}" ]]; then
    export WINE_WMCLASS="$WINE_WMCLASS"
fi
if [[ -n "${WAYLANDDRV_SSD:-}" ]]; then
    export WAYLANDDRV_SSD="$WAYLANDDRV_SSD"
fi

if [[ "${USE_FSR_HUD:-0}" -eq 1 || "${FSR_HUD:-0}" -eq 1 ]]; then
    export PROTON_FSR4_INDICATOR=1
fi
if [[ "$GPU_VENDOR" == "nvidia" && ( "${USE_FSR_HUD:-0}" -eq 1 || "${FSR_HUD:-0}" -eq 1 ) ]]; then
    export PROTON_DLSS_INDICATOR=1
fi

if [[ "$USE_MLFG" -eq 1 ]]; then
    export PROTON_MLFG_UPGRADE=1
    export MLFG_UPGRADE=1
    export PROTON_VKD3D_LOWLATENCY=0
    export PROTON_DXVK_LOWLATENCY=0
    if [[ "$GPU_VENDOR" == "amd" && "$AUTO_RDNA3" -eq 1 ]]; then
        export DXIL_SPIRV_CONFIG="${DXIL_SPIRV_CONFIG:-wmma_rdna3_workaround}"
    fi
else
    export PROTON_MLFG_UPGRADE=0
    export MLFG_UPGRADE=0
    export ENABLE_LAYER_MESA_ANTI_LAG="${ENABLE_LAYER_MESA_ANTI_LAG:-1}"
    export PROTON_DXVK_LOWLATENCY="${PROTON_DXVK_LOWLATENCY:-1}"
    export PROTON_VKD3D_LOWLATENCY="${PROTON_VKD3D_LOWLATENCY:-1}"
    export DXVK_FRAME_PACE="${DXVK_FRAME_PACE:-low-latency-vrr}"
    if (( AUTO_VRR_CAP > 0 )); then
        export DXVK_FRAME_RATE="${DXVK_FRAME_RATE:-$AUTO_VRR_CAP}"
        export VKD3D_FRAME_RATE="${VKD3D_FRAME_RATE:-$AUTO_VRR_CAP}"
    fi
fi

if [[ "${FSR4:-1}" -eq 1 ]]; then
    export PROTON_FSR4_UPGRADE=1
else
    export PROTON_FSR4_UPGRADE=0
fi

if [[ "$AUTO_CLASS" == "legacy-upscaler" && "$USE_OPTISCALER" -eq 0 ]]; then
    [[ "${AUTO_HAS_DLSS:-0}" -eq 1 ]] && export PROTON_DLSS_UPGRADE="${PROTON_DLSS_UPGRADE:-1}"
    [[ "${AUTO_HAS_XESS:-0}" -eq 1 ]] && export PROTON_XESS_UPGRADE="${PROTON_XESS_UPGRADE:-1}"
    [[ "${AUTO_HAS_FSR:-0}" -eq 1 ]] && export PROTON_FFX3_UPGRADE="${PROTON_FFX3_UPGRADE:-1}"
    export PROTON_FFX4_UPGRADE="${PROTON_FFX4_UPGRADE:-1}"
fi

if [[ "$USE_OPTISCALER" -eq 1 ]]; then
    export PROTON_USE_OPTISCALER=1
    export PROTON_OPTISCALER_STREAMLINE="${PROTON_OPTISCALER_STREAMLINE:-1}"
    [[ -n "${PROTON_OPTISCALER_NAME:-}" ]] && export PROTON_OPTISCALER_NAME
    [[ -n "${PROTON_OPTISCALER_CONFIG:-}" ]] && export PROTON_OPTISCALER_CONFIG
else
    export PROTON_USE_OPTISCALER=0
fi

if [[ "$USE_SHARPEN" -eq 1 && "$USE_OPTISCALER" -ne 1 ]]; then
    export ENABLE_VKBASALT=1
    VKBASALT_PRESET_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vkBasalt/presets"
    if [[ "$AUTO_PRESET" == "competitive" && -f "$VKBASALT_PRESET_DIR/competitive.conf" ]]; then
        export VKBASALT_CONFIG_FILE="$VKBASALT_PRESET_DIR/competitive.conf"
    elif [[ "$AUTO_PRESET" == "vivid" && -f "$VKBASALT_PRESET_DIR/vivid.conf" ]]; then
        export VKBASALT_CONFIG_FILE="$VKBASALT_PRESET_DIR/vivid.conf"
    elif [[ -f "$VKBASALT_PRESET_DIR/standard.conf" ]]; then
        export VKBASALT_CONFIG_FILE="$VKBASALT_PRESET_DIR/standard.conf"
    fi
else
    export ENABLE_VKBASALT=0
fi

COMPAT_TOKENS=()
if [[ "$USE_XWAYLAND" -ne 1 ]]; then COMPAT_TOKENS+=("wayland"); fi
if [[ "$GPU_VENDOR" == "amd" ]]; then COMPAT_TOKENS+=("nativeags"); fi
if [[ "$USE_SDL" -eq 1 ]]; then COMPAT_TOKENS+=("sdlinput"); fi
if [[ "${WINE_DISABLE_VULKAN_OPWR:-0}" -eq 1 ]]; then COMPAT_TOKENS+=("noopwr"); fi
if [[ "$USE_SAFEDX12" -eq 0 ]]; then COMPAT_TOKENS+=("vkd3dbindlesstb"); fi
if [[ "${PROTON_LOCAL_SHADER_CACHE:-0}" -eq 1 ]]; then COMPAT_TOKENS+=("localshadercache"); fi
if [[ "${PROTON_USE_PIPEWIRE:-0}" -eq 1 ]]; then COMPAT_TOKENS+=("pipewire"); fi
if [[ "${PROTON_DXVK_LOWLATENCY:-0}" -eq 1 ]]; then COMPAT_TOKENS+=("dxvklowlatency"); fi
if [[ "${PROTON_VKD3D_LOWLATENCY:-0}" -eq 1 ]]; then COMPAT_TOKENS+=("vkd3dlowlatency"); fi
if [[ "${PROTON_FSR4_UPGRADE:-0}" -eq 1 ]]; then COMPAT_TOKENS+=("fsr4"); fi
if [[ "$USE_MLFG" -eq 1 ]]; then COMPAT_TOKENS+=("mlfg"); fi
if [[ "$USE_MLFG" -eq 0 && "$GPU_VENDOR" == "nvidia" && "${DXVK_NVAPI_VKREFLEX:-0}" -eq 1 ]]; then COMPAT_TOKENS+=("vkreflex"); fi
if [[ "$USE_NO_NTSYNC" -eq 1 ]]; then COMPAT_TOKENS+=("nontsync"); fi
if [[ "$USE_NO_DECORATION" -eq 1 ]]; then COMPAT_TOKENS+=("nowmdecoration"); fi

# Preserve explicit user compat configuration and append profiler-managed tokens.
if [[ -n "${PROTON_ADD_CONFIG:-}" || ${#COMPAT_TOKENS[@]} -gt 0 ]]; then
    export PROTON_ADD_CONFIG="${PROTON_ADD_CONFIG:-}"
    export STEAM_COMPAT_CONFIG="${STEAM_COMPAT_CONFIG:-}"
    for compat_token in "${COMPAT_TOKENS[@]}"; do
        if [[ ",${PROTON_ADD_CONFIG}," != *",${compat_token},"* ]]; then
            PROTON_ADD_CONFIG="${PROTON_ADD_CONFIG:+$PROTON_ADD_CONFIG,}${compat_token}"
        fi
        if [[ ",${STEAM_COMPAT_CONFIG}," != *",${compat_token},"* ]]; then
            STEAM_COMPAT_CONFIG="${STEAM_COMPAT_CONFIG:+$STEAM_COMPAT_CONFIG,}${compat_token}"
        fi
    done
    export PROTON_ADD_CONFIG STEAM_COMPAT_CONFIG
fi

EXTRA_ARGS=()
[[ "$USE_CEF_FIX" -eq 1 ]] && EXTRA_ARGS+=("--in-process-gpu")
[[ "$USE_VULKAN" -eq 1 ]] && EXTRA_ARGS+=("-vulkan")

run_with_scheduler() {
    if command -v game-performance >/dev/null 2>&1; then
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run game-performance "$@"
        else
            game-performance "$@"
        fi
    elif command -v powerprofilesctl >/dev/null 2>&1; then
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run powerprofilesctl launch -p performance -- "$@"
        else
            powerprofilesctl launch -p performance -- "$@"
        fi
    elif command -v systemctl >/dev/null 2>&1 &&
         systemctl is-active --quiet ananicy-cpp.service; then
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run "$@"
        else
            "$@"
        fi
    elif command -v gamemoderun >/dev/null 2>&1; then
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run gamemoderun "$@"
        else
            gamemoderun "$@"
        fi
    else
        if [[ "${PRIME:-0}" -eq 1 ]] && command -v prime-run >/dev/null 2>&1; then
            prime-run "$@"
        else
            "$@"
        fi
    fi
}

NET_BOOST_BIN=""
for net_candidate in "$SCRIPT_DIR/steam-net-boost" "$HOME/.local/bin/steam-net-boost" "/usr/local/bin/steam-net-boost"; do
    if [[ -x "$net_candidate" ]]; then
        NET_BOOST_BIN="$net_candidate"
        break
    fi
done

if [[ "$USE_NET_OPT" -eq 1 && -n "$NET_BOOST_BIN" ]]; then
    cleanup_net() { sudo -n "$NET_BOOST_BIN" off >/dev/null 2>&1 || true; }
    trap cleanup_net EXIT INT TERM
    sudo -n "$NET_BOOST_BIN" on >/dev/null 2>&1 || true
fi

if [[ "$USE_KEEP_OVERLAY" -eq 1 ]]; then
    if [[ -n "$ORIG_LD_PRELOAD" ]]; then
        export LD_PRELOAD="$ORIG_LD_PRELOAD"
    else
        unset LD_PRELOAD
    fi
else
    export LD_PRELOAD=""
fi

run_with_scheduler "$@" "${EXTRA_ARGS[@]}"
