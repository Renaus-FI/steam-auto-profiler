if [[ "$GPU_VENDOR" == "amd" ]]; then
    export PROTON_NATIVE_AGS="${PROTON_NATIVE_AGS:-1}"
    # Migrate any legacy RADV_PERFTEST=video_decode token to Mesa 27.0 RADV_EXPERIMENTAL=video_decode.
    if [[ ",${RADV_PERFTEST:-}," == *",video_decode,"* ]]; then
        USE_VK_VIDEO_DECODE=1
        _radv_clean=""
        IFS=',' read -r -a _radv_parts <<<"${RADV_PERFTEST}"
        for _radv_tok in "${_radv_parts[@]}"; do
            [[ -n "$_radv_tok" && "$_radv_tok" != "video_decode" ]] || continue
            _radv_clean="${_radv_clean:+${_radv_clean},}${_radv_tok}"
        done
        export RADV_PERFTEST="${_radv_clean:-sam}"
    fi
    if [[ "$USE_TRANSFER_QUEUE" -eq 1 && ( "$AUTO_RDNA3" -eq 1 || "$AUTO_RDNA4" -eq 1 ) ]]; then
        if [[ ",${RADV_PERFTEST:-}," != *",transfer_queue,"* ]]; then
            export RADV_PERFTEST="${RADV_PERFTEST:+${RADV_PERFTEST},}transfer_queue"
        fi
    fi
    if [[ "$USE_VK_VIDEO_DECODE" -eq 1 ]]; then
        if [[ ",${RADV_EXPERIMENTAL:-}," != *",video_decode,"* ]]; then
            export RADV_EXPERIMENTAL="${RADV_EXPERIMENTAL:+${RADV_EXPERIMENTAL},}video_decode"
        fi
    fi
fi
