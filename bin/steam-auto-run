#!/usr/bin/env bash

# Context-aware pre-launch orchestrator for Steam on Linux.

set -euo pipefail

for _sap_dir in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
    case ":${PATH:-}:" in
        *:"$_sap_dir":*) ;;
        *) PATH="${PATH:+${PATH}:}$_sap_dir" ;;
    esac
done
export PATH
ORIG_LD_PRELOAD="${LD_PRELOAD:-}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DETECT_BIN=""
for candidate in "$SCRIPT_DIR/steam-auto-detect" "$HOME/.local/bin/steam-auto-detect" "/usr/local/bin/steam-auto-detect"; do
    if [[ -x "$candidate" ]]; then
        DETECT_BIN="$candidate"
        break
    fi
done


# Bypass profiler orchestration for SteamVR (250820) and VR launch flags
if [[ $# -gt 0 ]]; then
    if [[ "${SteamAppId:-}" == "250820" || "${STEAM_COMPAT_APP_ID:-}" == "250820" ]]; then
        case "${1:-}" in
            -h|--help|--inspect|-i|--doctor|--check-system|--reset|--list-profiles|--last-log|--configure|--dry-run|--ui)
                ;;
            *)
                exec "$@"
                ;;
        esac
    fi
    for _arg in "$@"; do
        if [[ "$_arg" == "-vr" || "$_arg" == "--vr" ]]; then
            exec "$@"
        fi
    done
fi

PROFILE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/steam-auto-profiler/profiles"

load_profile_safe() {
    local file="$1" line key value
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        line="${line#"${line%%[![:space:]]*}"}"
        [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
        key="${line%%=*}"; value="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        case "$key" in
            USE_*|PROTON_OPTISCALER_*|NO_NTSYNC|NO_DECORATION|VRR_CAP|VRR_MINUS_MARGIN|KEEP_OVERLAY|AUTO_PRESET|PARTIAL_PROFILE|PROTON_NO_NTSYNC|WAYLANDDRV_SHORTCUT_INHIBIT|AUTO_HDR_SWITCH)
                ;;
            *) continue ;;
        esac
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        if [[ "$value" == \"*\" && "$value" == *\" ]]; then
            value="${value:1:${#value}-2}"
        elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
            value="${value:1:${#value}-2}"
        fi
        # shellcheck disable=SC2016
        [[ "$value" != *'$('* && "$value" != *'`'* && "$value" != *';'* ]] || continue
        printf -v "$key" '%s' "$value"
    done < "$file"
}

usage() {
    cat <<'EOF'
Usage:
  steam-auto-run %command%
  steam-auto-run [OPTIONS] [APPID]

Options:
  --help, -h        Show this help message
  --inspect         Run the heuristic scanner
  --configure APPID Force-open the optional configuration GUI
  --dry-run [APPID] Resolve and print the launch environment without launching
  --reset APPID     Remove a saved profile
  --list-profiles   List saved profiles
  --last-log [APPID] Show the bounded last-launch log
  --doctor, --check-system
                    Run a read-only CachyOS system readiness audit
  --ui              Launch the unified Qt6 GUI / curses TUI control center

Environment overrides:
  FORCE_GUI=1       Re-open the GUI for a saved profile
  NO_GUI=1          Run silently
  VRR_CAP=<fps>     Override the calculated VRR frame cap (0 disables capping)
  VRR_MINUS_MARGIN=1 Enable optional 6% VRR safety margin (e.g. 225 FPS on 240 Hz)
  XWAYLAND=1        Force XWayland instead of native Wayland
  WAYLANDDRV_SHORTCUT_INHIBIT=1 Allow shortcut inhibition under Wine Wayland
  MLFG=1            Enable frame generation (disables Anti-Lag and VRR caps)
  OPTISCALER=1      Enable optional OptiScaler bridge (guarded off for anti-cheat)
  SHARPEN=1         Enable vkBasalt sharpening (disabled when FSR4/OptiScaler active)
  SAFEDX12=1        Omit experimental VKD3D_CONFIG flags and vkd3dbindlesstb token
  NETOPT=1          Enable the optional session network QoS profile
  SDL=1             Prefer native SDL/Steam Input emulation
  CEF=1             Add --in-process-gpu for CEF launchers
  VULKAN=1          Append -vulkan to the launch command
  KEEP_OVERLAY=1    Preserve LD_PRELOAD for Steam Overlay
  NO_NTSYNC=1       Disable NTSync for legacy titles
  NO_DECORATION=1   Disable WM decorations
  PRIME=1           Use prime-run for hybrid GPU launch
  FSR4=0            Disable the native FSR4 upgrade
  FSR_HUD=1         Enable the FSR/DLSS HUD indicator
  AUTO_HDR_SWITCH=1 Toggle KDE Plasma 6 HDR on launch and restore SDR on exit
  BENCH=1           Enable silent MangoHud CSV benchmark logging on exit
  BENCH_DURATION=60 Benchmark logging duration in seconds (default: 60)
  TRANSFER_QUEUE=1  Enable RDNA 3/4 SDMA transfer queue (RADV_PERFTEST=...,transfer_queue)
  NATIVE_ANTILAG=1  Use Mesa 26.3+/27.0 native RADV VK_AMD_anti_lag (no legacy layer)
  REFLEX_LAYER=1    Enable Reflex -> Anti-Lag 2 translation layer (off in anti-cheat/MLFG)
  VK_VIDEO_DECODE=1 Enable Mesa 27.0 Vulkan video decode (RADV_EXPERIMENTAL=video_decode)
  BLEEDING_EDGE=1   Enable Ultra Bleeding-Edge experimental Mesa 27 / VKD3D / Proton 11 stack (non-anticheat)
  USE_STEAM_CONTROLLER=auto|1|0
                    Auto-route Steam Controller 2026 / Puck (28de:{1302,1304,1005,1007}) via XWayland + PROTON_USE_SDL=1
EOF
}

USB_SYSFS_DIR="${SAP_USB_DIR:-/sys/bus/usb/devices}"
UDEV_RULES_DIR="${SAP_UDEV_RULES_DIR:-/etc/udev/rules.d}"

detect_steam_controller_2026_path() {
    local dev_dir vid pid
    [[ -d "$USB_SYSFS_DIR" ]] || return 0
    for dev_dir in "$USB_SYSFS_DIR"/*; do
        [[ -r "$dev_dir/idVendor" && -r "$dev_dir/idProduct" ]] || continue
        vid="$(tr '[:upper:]' '[:lower:]' < "$dev_dir/idVendor" 2>/dev/null | tr -d '[:space:]')"
        pid="$(tr '[:upper:]' '[:lower:]' < "$dev_dir/idProduct" 2>/dev/null | tr -d '[:space:]')"
        if [[ "$vid" == "28de" ]]; then
            case "$pid" in
                1304|1302|1005|1007)
                    printf '%s\n' "$dev_dir"
                    return 0
                    ;;
            esac
        fi
    done
    return 0
}

detect_steam_controller_2026() {
    local dev_dir vid pid
    dev_dir="$(detect_steam_controller_2026_path)"
    [[ -n "$dev_dir" ]] || return 0
    vid="$(tr '[:upper:]' '[:lower:]' < "$dev_dir/idVendor" 2>/dev/null | tr -d '[:space:]')"
    pid="$(tr '[:upper:]' '[:lower:]' < "$dev_dir/idProduct" 2>/dev/null | tr -d '[:space:]')"
    printf '%s:%s\n' "$vid" "$pid"
}

run_doctor() {
    echo "=== Steam Auto-Profiler: CachyOS System Doctor ==="

    local kernel
    kernel="$(uname -r)"
    echo "[INFO] Kernel: $kernel"
    if [[ -c /dev/ntsync ]]; then
        echo "[OK] /dev/ntsync is character-device accessible"
    else
        echo "[WARN] /dev/ntsync is unavailable; Proton may fall back to fsync/esync (override: PROTON_NO_NTSYNC=1)"
    fi

    local pstate=""
    if [[ -r /sys/devices/system/cpu/amd_pstate/status ]]; then
        pstate="$(cat /sys/devices/system/cpu/amd_pstate/status)"
    elif [[ -r /sys/devices/system/cpu/intel_pstate/status ]]; then
        pstate="$(cat /sys/devices/system/cpu/intel_pstate/status)"
    fi
    [[ -n "$pstate" ]] && echo "[INFO] CPU P-State: $pstate" || echo "[INFO] CPU P-State: managed outside amd_pstate/intel_pstate"

    if [[ -r /sys/kernel/sched_ext/state ]]; then
        local sched_ext
        sched_ext="$(cat /sys/kernel/sched_ext/state)"
        echo "[INFO] sched-ext state: $sched_ext"
    else
        echo "[INFO] sched-ext state: unavailable"
    fi
    if command -v scxctl >/dev/null 2>&1; then
        echo "[INFO] scxctl get: $(scxctl get 2>/dev/null | tr '\n' ' ')"
    elif command -v scx_loader >/dev/null 2>&1; then
        echo "[INFO] scx_loader: installed"
    else
        echo "[INFO] sched-ext loader: not detected"
    fi

    if (pgrep -x gamemoded >/dev/null 2>&1) &&
       systemctl is-active --quiet ananicy-cpp.service 2>/dev/null; then
        echo "[WARN] gamemode and ananicy-cpp are both active; this may cause process-niceness conflicts"
    elif systemctl is-active --quiet ananicy-cpp.service 2>/dev/null; then
        echo "[INFO] ananicy-cpp is active"
    else
        echo "[OK] No gamemode/ananicy-cpp conflict detected"
    fi

    if command -v eac-status >/dev/null 2>&1; then
        if [[ "$(id -u)" -eq 0 ]]; then
            echo "[INFO] Easy Anti-Cheat readiness:"
            eac-status 2>&1 | sed 's/^/  /' || true
        elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
            echo "[INFO] Easy Anti-Cheat readiness:"
            sudo -n eac-status 2>&1 | sed 's/^/  /' || true
        else
            local lockdown_state
            lockdown_state="$(head -n1 /sys/kernel/security/lockdown 2>/dev/null || echo "unknown")"
            echo "[OK] Easy Anti-Cheat (Linux v2): eac-status is installed"
            echo "[INFO] Kernel: $kernel; lockdown: $lockdown_state"
            echo "[INFO] Run 'sudo eac-status' for full hardware-attestation details"
        fi
    elif [[ "$kernel" == *-cachyos-eac* ]]; then
        echo "[INFO] CachyOS EAC kernel detected: $kernel"
        echo "[INFO] Verify Secure Boot, TPM 2.0, lockdown=integrity and IOMMU for Linux EAC v2"
    else
        echo "[INFO] eac-status is not installed and no -cachyos-eac kernel is active"
    fi

    local max_map
    max_map="$(sysctl -n vm.max_map_count 2>/dev/null || true)"
    if [[ -n "$max_map" ]] && (( max_map >= 2147483642 )); then
        echo "[OK] vm.max_map_count=$max_map"
    elif [[ -n "$max_map" ]]; then
        echo "[WARN] vm.max_map_count=$max_map; CachyOS recommends >= 2147483642"
    else
        echo "[WARN] vm.max_map_count could not be read"
    fi

    local nvme_schedulers=0
    local nvme_dev=""
    for scheduler_file in /sys/block/nvme*/queue/scheduler; do
        [[ -r "$scheduler_file" ]] || continue
        nvme_schedulers=1
        nvme_dev="${scheduler_file#/sys/block/}"
        nvme_dev="${nvme_dev%%/*}"
        echo "[INFO] NVMe scheduler ${nvme_dev}: $(cat "$scheduler_file")"
    done
    (( nvme_schedulers == 1 )) || echo "[INFO] No NVMe block devices detected"

    local env_conf="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
    if [[ -d "$env_conf" ]]; then
        local cache_lines=""
        cache_lines="$(grep -hE 'MESA_SHADER_CACHE_MAX_SIZE|__GL_SHADER_DISK_CACHE_(SIZE|SKIP_CLEANUP)' "$env_conf"/*.conf 2>/dev/null || true)"
        if [[ -n "$cache_lines" ]]; then
            echo "[OK] Shader cache environment settings:"
            printf '%s\n' "$cache_lines" | sed 's/^/  /'
        else
            echo "[INFO] No MESA/NVIDIA shader cache override found in $env_conf"
        fi
        declare -A env_keys=()
        local env_base=""
        for env_file in "$env_conf"/*.conf; do
            [[ -f "$env_file" ]] || continue
            env_base="$(basename "$env_file")"
            # shellcheck disable=SC2094
            while IFS='=' read -r key _; do
                key="${key#"${key%%[![:space:]]*}"}"
                key="${key%"${key##*[![:space:]]}"}"
                [[ -n "$key" && "$key" != \#* ]] || continue
                if [[ -n "${env_keys[$key]:-}" && "${env_keys[$key]}" != "$env_base" ]]; then
                    echo "[WARN] Duplicate environment variable $key in ${env_keys[$key]} and $env_base"
                else
                    env_keys[$key]="$env_base"
                fi
            done < "$env_file"
        done
    else
        echo "[INFO] $env_conf does not exist"
    fi

    if [[ -d /etc/sysctl.d && -r /etc/sysctl.d ]]; then
        declare -A sysctl_keys=()
        for sysctl_file in /etc/sysctl.d/*.conf; do
            [[ -f "$sysctl_file" && -r "$sysctl_file" ]] || continue
            # shellcheck disable=SC2094
            while IFS='=' read -r key _; do
                key="${key#"${key%%[![:space:]]*}"}"
                key="${key%"${key##*[![:space:]]}"}"
                [[ -n "$key" && "$key" != \#* ]] || continue
                if [[ -n "${sysctl_keys[$key]:-}" && "${sysctl_keys[$key]}" != "$(basename "$sysctl_file")" ]]; then
                    echo "[WARN] Conflicting sysctl override $key in $(basename "${sysctl_keys[$key]}") and $(basename "$sysctl_file")"
                else
                    sysctl_keys[$key]="$(basename "$sysctl_file")"
                fi
            done < "$sysctl_file"
        done
    fi

    local default_iface=""
    default_iface="$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')"
    [[ -n "$default_iface" ]] || default_iface="$(ip -o -6 route show to default 2>/dev/null | awk '{print $5; exit}')"
    if [[ -n "$default_iface" && -n "$(command -v ethtool 2>/dev/null)" ]]; then
        local eee_output
        eee_output="$(ethtool --show-eee "$default_iface" 2>/dev/null || true)"
        if [[ -n "$eee_output" ]]; then
            if grep -qiE 'EEE status:.*disabled|EEE.*disabled|enabled:[[:space:]]*N' <<<"$eee_output"; then
                echo "[OK] EEE disabled on $default_iface"
            elif grep -qiE 'EEE status:.*enabled|enabled:[[:space:]]*Y' <<<"$eee_output"; then
                echo "[WARN] EEE active on $default_iface; consider disabling it"
            else
                echo "[INFO] EEE status for $default_iface: $(tr '\n' ' ' <<<"$eee_output")"
            fi
        fi
    fi
    if [[ -n "$default_iface" && -n "$(command -v tc 2>/dev/null)" ]]; then
        local qdisc_output
        qdisc_output="$(tc -s qdisc show dev "$default_iface" 2>/dev/null || true)"
        if grep -qiE '(^|[[:space:]])qdisc[[:space:]]+htb([[:space:]]|$)' <<<"$qdisc_output" &&
           grep -qiE '(^|[[:space:]])qdisc[[:space:]]+cake([[:space:]]|$).*parent[[:space:]]+[0-9a-fA-F]+:' <<<"$qdisc_output"; then
            echo "[OK] sch_cake active on $default_iface (HTB hierarchy)"
        elif grep -qiE '(^|[[:space:]])qdisc[[:space:]]+cake([[:space:]]|$)|cake[[:space:]].*(diffserv4|bandwidth)' <<<"$qdisc_output"; then
            echo "[OK] sch_cake active on $default_iface"
        else
            echo "[INFO] No active sch_cake qdisc detected on $default_iface"
        fi
    fi

    local nft_file=""
    [[ -r /etc/nftables.d/game-qos.nft ]] && nft_file="/etc/nftables.d/game-qos.nft"
    if [[ -n "$nft_file" ]] && grep -qi 'diffserv4' "$nft_file"; then
        if grep -qiE 'cs4|DSCP[[:space:]]+4|classify.*4' "$nft_file"; then
            echo "[WARN] nftables game traffic uses cs4 with diffserv4 CAKE; use cs3 for the Video tin"
        fi
    fi

    local compat_dir="${HOME}/.steam/steam/compatibilitytools.d"
    local flatpak_compat="${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"
    local local_compat="${HOME}/.local/share/Steam/compatibilitytools.d"
    local found_proton=0
    local found_slr=0
    local found_native=0
    local native_name=""
    local slr_name=""
    for proton_dir in "$compat_dir" "$local_compat" "$flatpak_compat" \
        "/usr/share/steam/compatibilitytools.d" "/usr/local/share/steam/compatibilitytools.d"; do
        [[ -d "$proton_dir" ]] || continue
        for tool in "$proton_dir"/*; do
            [[ -d "$tool" ]] || continue
            local tool_name
            tool_name="$(basename "$tool")"
            case "$tool_name" in
                *proton-cachyos-slr*)
                    found_slr=1
                    slr_name="$tool_name"
                    found_proton=1
                    ;;
                *proton-cachyos-native*|proton-cachyos)
                    found_native=1
                    native_name="$tool_name"
                    found_proton=1
                    ;;
                *Proton-EM*|*Proton-GE*|*Experimental*)
                    echo "[INFO] Proton compatibility tool: $tool_name"
                    found_proton=1
                    ;;
            esac
        done
    done
    if (( found_slr == 1 )) && [[ -n "$slr_name" ]]; then
        echo "[OK] Proton-CachyOS SLR is installed (recommended over native build for EAC/BattlEye): $slr_name"
    elif (( found_native == 1 )) && [[ -n "$native_name" ]]; then
        echo "[WARN] Native Proton-CachyOS detected without proton-cachyos-slr: $native_name"
    fi
    (( found_proton == 1 )) || echo "[INFO] No community Proton compatibility tool directory was detected"

    local steam_cfg_vdf=""
    if [[ -n "${SAP_STEAM_CONFIG_VDF:-}" && -r "$SAP_STEAM_CONFIG_VDF" ]]; then
        steam_cfg_vdf="$SAP_STEAM_CONFIG_VDF"
    else
        for cfg_candidate in \
            "${HOME}/.local/share/Steam/config/config.vdf" \
            "${HOME}/.steam/steam/config/config.vdf" \
            "${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam/config/config.vdf"; do
            if [[ -r "$cfg_candidate" ]]; then
                steam_cfg_vdf="$cfg_candidate"
                break
            fi
        done
    fi
    if [[ -n "$steam_cfg_vdf" ]] && command -v python3 >/dev/null 2>&1; then
        local hunt_tool=""
        hunt_tool="$(python3 - "$steam_cfg_vdf" <<'PY' 2>/dev/null || true
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8", errors="ignore")
tokens = []
i = 0
n = len(text)
while i < n:
    c = text[i]
    if c.isspace():
        i += 1
    elif c == "/" and i + 1 < n and text[i + 1] == "/":
        nl = text.find("\n", i)
        i = n if nl == -1 else nl + 1
    elif c in "{}":
        tokens.append(("B", c))
        i += 1
    elif c == '"':
        j = i + 1
        parts = []
        while j < n:
            if text[j] == "\\" and j + 1 < n:
                parts.append(text[j + 1])
                j += 2
            elif text[j] == '"':
                break
            else:
                parts.append(text[j])
                j += 1
        tokens.append(("S", "".join(parts)))
        i = j + 1
    else:
        j = i
        while j < n and not text[j].isspace() and text[j] not in '{}"':
            j += 1
        tokens.append(("S", text[i:j]))
        i = j

stack = []
pending = None
tool = ""
for kind, val in tokens:
    if kind == "S":
        if pending is None:
            pending = val
        else:
            if len(stack) >= 2 and stack[-2] == "compattoolmapping" and stack[-1] == "594650":
                if pending.lower() == "name":
                    tool = val.strip()
                    break
            pending = None
    elif kind == "B" and val == "{":
        stack.append((pending or "").lower())
        pending = None
    elif kind == "B" and val == "}":
        if stack:
            stack.pop()
        pending = None
print(tool)
PY
        )"
        local hunt_tool_lower="${hunt_tool,,}"
        if [[ -z "$hunt_tool" ]]; then
            echo "[WARN] Hunt: Showdown 1896 (AppID 594650) CompatToolMapping is unset in config.vdf (proton-cachyos triggers late-2026 EAC launch/kick bug); set Hunt: Showdown 1896 -> Properties -> Compatibility to Valve's 'Proton 11.0-2' or 'Proton Hotfix'"
        elif [[ "$hunt_tool_lower" == proton-cachyos* || "$hunt_tool_lower" == proton_cachyos* ]]; then
            echo "[WARN] Hunt: Showdown 1896 (AppID 594650) is mapped to '$hunt_tool' in config.vdf (triggers late-2026 EAC launch/kick bug); set Hunt: Showdown 1896 -> Properties -> Compatibility to Valve's 'Proton 11.0-2' or 'Proton Hotfix'"
        else
            echo "[OK] Hunt: Showdown 1896 (AppID 594650) CompatToolMapping: $hunt_tool"
        fi
    fi

    local sc_dev_path=""
    sc_dev_path="$(detect_steam_controller_2026_path)"
    local sc_rule="$UDEV_RULES_DIR/61-steam-controller-2026.rules"
    if [[ -n "$sc_dev_path" ]]; then
        local sc_vid sc_pid sc_pwr=""
        sc_vid="$(tr '[:upper:]' '[:lower:]' < "$sc_dev_path/idVendor" 2>/dev/null | tr -d '[:space:]')"
        sc_pid="$(tr '[:upper:]' '[:lower:]' < "$sc_dev_path/idProduct" 2>/dev/null | tr -d '[:space:]')"
        echo "[INFO] Steam Controller 2026 / Puck detected: ${sc_vid}:${sc_pid} (auto Steam Input routing active)"
        if [[ -r "$sc_dev_path/power/control" ]]; then
            sc_pwr="$(tr -d '[:space:]' < "$sc_dev_path/power/control" 2>/dev/null || true)"
            if [[ "$sc_pwr" == "on" ]]; then
                echo "[OK] Steam Controller 2026 USB selective suspend disabled (power/control=on)"
            elif [[ -n "$sc_pwr" ]]; then
                echo "[WARN] Steam Controller 2026 USB power/control=$sc_pwr (may add wireless wake-up latency); run './install.sh --with-steam-controller'"
            fi
        fi
    fi
    if [[ -r "$sc_rule" ]]; then
        if grep -q 'ID_MM_DEVICE_IGNORE' "$sc_rule" &&
           grep -q 'SUBSYSTEM=="tty"' "$sc_rule" &&
           grep -q 'power/control' "$sc_rule"; then
            echo "[OK] Steam Controller 2026 udev rules installed: $sc_rule"
        else
            echo "[WARN] Steam Controller 2026 udev rules at $sc_rule are incomplete; re-run './install.sh --with-steam-controller'"
        fi
    elif [[ -n "$sc_dev_path" ]]; then
        echo "[WARN] Steam Controller 2026 udev rules ($sc_rule) not installed; run './install.sh --with-steam-controller' for zero-latency and firmware-ready permissions"
    else
        echo "[INFO] Steam Controller 2026 udev rules ($sc_rule) not installed (optional: './install.sh --with-steam-controller')"
    fi
}

CONFIGURE_ONLY=0
DRY_RUN=0
CONFIGURE_FALLBACK=0
case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    --inspect|-i)
        if [[ -n "$DETECT_BIN" ]]; then
            exec "$DETECT_BIN" --inspect "${2:-}"
        fi
        echo "Error: steam-auto-detect not found." >&2
        exit 1
        ;;
    --doctor|--check-system)
        run_doctor
        exit 0
        ;;
    --ui)
        shift
        UI_BIN=""
        for ui_candidate in "$SCRIPT_DIR/steam-auto-ui" "$HOME/.local/bin/steam-auto-ui" "/usr/local/bin/steam-auto-ui"; do
            if [[ -x "$ui_candidate" ]]; then
                UI_BIN="$ui_candidate"
                break
            fi
        done
        if [[ -n "$UI_BIN" ]]; then
            exec "$UI_BIN" "$@"
        fi
        echo "Error: steam-auto-ui not found." >&2
        exit 1
        ;;
    --reset)
        if [[ -z "${2:-}" || ! "${2:-}" =~ ^[A-Za-z0-9_-]+$ ]]; then
            echo "Usage: steam-auto-run --reset APPID" >&2
            exit 2
        fi
        rm -f "$PROFILE_DIR/$2.env"
        echo "Profile reset for AppID $2."
        exit 0
        ;;
    --list-profiles)
        declare -a list_steam_libs=()
        declare -A list_seen_libs=()
        for steam_root in \
            "$HOME/.local/share/Steam" "$HOME/.steam/steam" \
            "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"; do
            [[ -d "$steam_root/steamapps" && -z "${list_seen_libs[$steam_root]:-}" ]] || continue
            list_seen_libs["$steam_root"]=1
            list_steam_libs+=("$steam_root")
            if [[ -f "$steam_root/steamapps/libraryfolders.vdf" ]]; then
                while IFS= read -r extra_lib; do
                    [[ -d "$extra_lib/steamapps" && -z "${list_seen_libs[$extra_lib]:-}" ]] || continue
                    list_seen_libs["$extra_lib"]=1
                    list_steam_libs+=("$extra_lib")
                done < <(
                    grep -oE '"path"[[:space:]]+"[^"]+"' "$steam_root/steamapps/libraryfolders.vdf" 2>/dev/null \
                        | sed -E 's/"path"[[:space:]]+"([^"]+)"/\1/' || true
                )
            fi
        done
        for profile in "$PROFILE_DIR"/*.env; do
            [[ -f "$profile" ]] || continue
            appid="${profile##*/}"; appid="${appid%.env}"
            game_name=""
            for steam_root in "${list_steam_libs[@]}"; do
                [[ -f "$steam_root/steamapps/appmanifest_${appid}.acf" ]] || continue
                game_name="$(sed -n '0,/^[[:space:]]*"name"/s/^[[:space:]]*"name"[[:space:]]*"\([^"]*\)".*/\1/p' \
                    "$steam_root/steamapps/appmanifest_${appid}.acf")"
                [[ -n "$game_name" ]] && break
            done
            [[ -n "$game_name" ]] || game_name="(uninstalled)"
            overrides=()
            while IFS='=' read -r key value; do
                [[ -n "$key" ]] && overrides+=("$key=$value")
            done < <(grep -vE '^[[:space:]]*(#|$)' "$profile" 2>/dev/null || true)
            printf '%s  %s' "$appid" "$game_name"
            ((${#overrides[@]} > 0)) && printf '  overrides: %s' "$(IFS=', '; echo "${overrides[*]}")"
            printf '\n'
        done
        exit 0
        ;;
    --last-log)
        LAST_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/steam-auto-profiler"
        if [[ -n "${2:-}" && "${2:-}" != -* ]]; then
            if [[ ! "${2:-}" =~ ^[A-Za-z0-9_-]+$ ]]; then
                echo "Invalid AppID: $2" >&2
                exit 2
            fi
            if [[ -f "$LAST_LOG_DIR/last-${2}.log" ]]; then
                cat "$LAST_LOG_DIR/last-${2}.log"
            else
                echo "No last-launch log found for AppID $2."
            fi
        else
            if [[ -f "$LAST_LOG_DIR/last-launch.log" ]]; then
                cat "$LAST_LOG_DIR/last-launch.log"
            else
                echo "No last-launch log found."
            fi
        fi
        exit 0
        ;;
    --configure)
        if [[ -z "${2:-}" ]]; then
            echo "Usage: steam-auto-run --configure APPID" >&2
            exit 2
        fi
        export SteamAppId="$2"
        export FORCE_GUI=1
        CONFIGURE_ONLY=1
        shift 2
        ;;
    --dry-run)
        DRY_RUN=1
        shift
        if [[ -n "${1:-}" && "${1:-}" != "--" && "${1:-}" != -* ]]; then
            export SteamAppId="$1"
            shift
        fi
        [[ "${1:-}" == "--" ]] && shift
        ;;
esac

COMMAND_TOKEN_COUNT=0
for launch_arg in "$@"; do
    if [[ "$launch_arg" == *"%command%"* ]]; then
        COMMAND_TOKEN_COUNT=$((COMMAND_TOKEN_COUNT + 1))
    fi
done
if [[ "$COMMAND_TOKEN_COUNT" -gt 1 ]]; then
    echo "Error: refusing to wrap multiple %command% tokens." >&2
    exit 2
fi
if [[ "$CONFIGURE_ONLY" -eq 0 && "$DRY_RUN" -eq 0 && "$#" -eq 0 ]]; then
    echo "Error: empty launch command. Set Steam launch options to: steam-auto-run %command%" >&2
    exit 2
fi

DRM_SYSFS_DIR="${SAP_DRM_DIR:-/sys/class/drm}"

detect_gpu_vendor() {
    local vendor_file found_intel=0
    for vendor_file in "$DRM_SYSFS_DIR"/card*/device/vendor; do
        [[ -r "$vendor_file" ]] || continue
        case "$(cat "$vendor_file" 2>/dev/null)" in
            0x1002) echo amd; return ;;
            0x10de) echo nvidia; return ;;
            0x8086) found_intel=1 ;;
        esac
    done
    if [[ "$found_intel" -eq 1 ]]; then
        echo intel
        return
    fi
    echo unknown
}

detect_vrr_cap() {
    if [[ -n "${VRR_CAP:-}" ]]; then
        echo "$VRR_CAP"
        return
    fi

    local hz=""
    if command -v kscreen-doctor >/dev/null 2>&1; then
        hz=$(
            kscreen-doctor -o 2>/dev/null | awk '
                {
                    gsub(/\033\[[0-9;]*[A-Za-z]/, "")
                    for (i = 1; i <= NF; i++) {
                        if ($i ~ /@[0-9]+(\.[0-9]+)?(\*!?|!\*)/) {
                            v = $i
                            sub(/^.*@/, "", v)
                            sub(/[^0-9.].*$/, "", v)
                            if (v + 0 > max_star) max_star = v + 0
                        } else if (match($i, /[0-9]+(\.[0-9]+)?Hz/)) {
                            v = substr($i, RSTART, RLENGTH - 2)
                            if (v + 0 > max_hz) max_hz = v + 0
                        }
                    }
                }
                END {
                    res = (max_star > 0 ? max_star : max_hz)
                    if (res > 0) printf "%.0f\n", res
                }
            '
        )
    elif command -v wlr-randr >/dev/null 2>&1; then
        hz=$(
            wlr-randr 2>/dev/null \
                | awk '/current/ {
                    for (i = 1; i <= NF; i++) {
                        if ($i ~ /Hz/) {
                            v = $(i-1)
                            gsub(/[^0-9.]/, "", v)
                            if (v + 0 > best) best = v + 0
                        }
                    }
                    } END {if (best > 0) printf "%.0f\n", best}'
        )
    elif command -v xrandr >/dev/null 2>&1; then
        hz=$(
            xrandr --current 2>/dev/null \
                | grep -oE '[0-9]+(\.[0-9]+)?\*' \
                | tr -d '*' \
                | sort -nr \
                | head -n1 \
                | awk '{printf "%.0f\n", $1}'
        )
    fi

    if [[ -n "$hz" ]] && [[ "${VRR_MINUS_MARGIN:-0}" -eq 1 ]]; then
        echo $((hz * 94 / 100))
    elif [[ -n "$hz" ]]; then
        echo "$hz"
    else
        echo 0
    fi
}

detect_primary_hdr_output() {
    command -v kscreen-doctor >/dev/null 2>&1 || return 0
    kscreen-doctor -o 2>/dev/null | awk '
        function commit() {
            if (cur_name == "") return
            if (cur_enabled == 1 && (best_name == "" || cur_prio < best_prio)) {
                best_name = cur_name
                best_prio = cur_prio
                best_hdr = cur_hdr
            } else if (fallback_name == "") {
                fallback_name = cur_name
                fallback_hdr = cur_hdr
            }
        }
        {
            gsub(/\033\[[0-9;]*[A-Za-z]/, "")
            if ($1 == "Output:") {
                commit()
                cur_name = $3
                cur_enabled = 1
                cur_prio = 999
                cur_hdr = "unknown"
            } else if ($1 == "disabled") {
                cur_enabled = 0
            } else if ($1 == "enabled") {
                cur_enabled = 1
            } else if ($1 == "priority" && $2 ~ /^[0-9]+$/) {
                cur_prio = $2 + 0
            } else if ($1 == "HDR:") {
                cur_hdr = tolower($2)
            }
        }
        END {
            commit()
            if (best_name != "") {
                print best_name, best_hdr
            } else if (fallback_name != "") {
                print fallback_name, fallback_hdr
            }
        }
    '
}

detect_rdna3() {
    local modalias
    for modalias in "$DRM_SYSFS_DIR"/card*/device/uevent; do
        [[ -r "$modalias" ]] || continue
        if grep -qiE 'PCI_ID=1002:(744C|745E|747E|7480|740F)' "$modalias"; then
            echo 1
            return
        fi
    done
    if [[ -z "${SAP_DRM_DIR:-}" ]] && command -v lspci >/dev/null 2>&1 &&
        lspci -nn 2>/dev/null | grep -qiE '1002:(744c|745e|747e|7480|740f)'; then
        echo 1
        return
    fi
    echo 0
}

detect_rdna4() {
    local uevent
    for uevent in "$DRM_SYSFS_DIR"/card*/device/uevent; do
        [[ -r "$uevent" ]] || continue
        if grep -qiE 'PCI_ID=1002:(7550|7590)' "$uevent"; then
            echo 1
            return
        fi
    done
    if [[ -z "${SAP_DRM_DIR:-}" ]] && command -v lspci >/dev/null 2>&1 &&
        lspci -nn 2>/dev/null | grep -qiE '1002:(7550|7590)'; then
        echo 1
        return
    fi
    echo 0
}

detect_discrete_gpu() {
    local card_dir vendor device vram boot_vga best_card=""
    local best_vram=0
    for card_dir in "$DRM_SYSFS_DIR"/card*/device; do
        [[ -d "$card_dir" ]] || continue
        [[ -r "$card_dir/vendor" && -r "$card_dir/device" ]] || continue
        vendor="$(cat "$card_dir/vendor" 2>/dev/null)"
        device="$(cat "$card_dir/device" 2>/dev/null)"
        [[ "$vendor" == "0x1002" || "$vendor" == "0x10de" ]] || continue
        vram=0
        if [[ -r "$card_dir/mem_info_vram_total" ]]; then
            vram="$(cat "$card_dir/mem_info_vram_total" 2>/dev/null || echo 0)"
        fi
        boot_vga=0
        [[ -r "$card_dir/boot_vga" ]] && boot_vga="$(cat "$card_dir/boot_vga" 2>/dev/null || echo 0)"
        if (( vram > 2147483648 && vram >= best_vram )) || { [[ "$boot_vga" == "0" ]] && (( vram >= best_vram )); }; then
            best_vram="$vram"
            best_card="${vendor#0x}:${device#0x}!"
        fi
    done
    if [[ -n "$best_card" ]]; then
        echo "$best_card"
    fi
    return 0
}

