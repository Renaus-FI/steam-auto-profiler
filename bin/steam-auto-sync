#!/usr/bin/env python3
"""Batch-inject or remove steam-auto-run in Steam localconfig.vdf."""

import argparse
import concurrent.futures
import fcntl
import json
import os
import re
import shlex
import shutil
import struct
import subprocess
import sys
import time
import zlib
from pathlib import Path


def parse_vdf(text):
    tokens = []
    i = 0
    while i < len(text):
        char = text[i]
        if char.isspace():
            i += 1
        elif char == "/" and i + 1 < len(text) and text[i + 1] == "/":
            newline = text.find("\n", i)
            i = len(text) if newline == -1 else newline + 1
        elif char in "{}":
            tokens.append(("BRACE", char, i, i + 1))
            i += 1
        elif char == '"':
            j = i + 1
            parts = []
            while j < len(text):
                if text[j] == "\\" and j + 1 < len(text):
                    parts.append(text[j + 1])
                    j += 2
                elif text[j] == '"':
                    break
                else:
                    parts.append(text[j])
                    j += 1
            tokens.append(("STR", "".join(parts), i, j + 1))
            i = j + 1
        else:
            j = i
            while j < len(text) and not text[j].isspace() and text[j] not in '{}"':
                j += 1
            tokens.append(("STR", text[i:j], i, j))
            i = j
    return tokens


def find_launch_options(text):
    tokens = parse_vdf(text)
    stack = []
    pending_key = None
    app_launch = {}
    app_close = {}
    apps_close = None

    for kind, value, start, end in tokens:
        if kind == "STR":
            if pending_key is None:
                pending_key = value
            else:
                if len(stack) == 6 and stack[:5] == [
                    "userlocalconfigstore", "software", "valve", "steam", "apps"
                ]:
                    if pending_key.lower() == "launchoptions":
                        app_launch[stack[5]] = (value, start, end)
                pending_key = None
        elif kind == "BRACE" and value == "{":
            stack.append((pending_key or "").lower())
            pending_key = None
        elif kind == "BRACE" and value == "}":
            if len(stack) == 6 and stack[:5] == [
                "userlocalconfigstore", "software", "valve", "steam", "apps"
            ]:
                app_close[stack[5]] = start
            elif len(stack) == 5 and stack == [
                "userlocalconfigstore", "software", "valve", "steam", "apps"
            ]:
                apps_close = start
            if stack:
                stack.pop()
            pending_key = None

    return app_launch, app_close, apps_close


WRAPPERS = {"cachy-run", "game-performance", "gamemoderun", "steam-auto-run"}
VR_WRAPPERS = {"vr-run"}
MANAGED_ENV_PREFIXES = (
    "PROTON_", "DXVK_", "VKD3D_", "WINE", "WAYLANDDRV_",
    "ENABLE_LAYER_MESA_ANTI_LAG=", "ENABLE_VKBASALT=",
    "RADV_PERFTEST=", "RADV_EXPERIMENTAL=",
    "LOW_LATENCY_LAYER=", "LOW_LATENCY_LAYER_REFLEX=",
    "TRANSFER_QUEUE=", "USE_TRANSFER_QUEUE=",
    "NATIVE_ANTILAG=", "USE_NATIVE_ANTILAG=",
    "REFLEX_LAYER=", "USE_REFLEX_LAYER=",
    "VK_VIDEO_DECODE=", "USE_VK_VIDEO_DECODE=",
    "BLEEDING_EDGE=", "USE_BLEEDING_EDGE=",
    "CONSERVATIVE=", "USE_CONSERVATIVE=",
    "STEAM_CONTROLLER=", "USE_STEAM_CONTROLLER=",
    "AFMF=", "USE_AFMF=", "AFMF_ENABLE=", "DISABLE_AFMF=",
    "AFMF_GAMESCOPE=", "AFMF_PACING=", "AFMF_PRESENT_MODE=",
)
RETIRED_PROTON_VARS = {
    "PROTON_ENABLE_HDR",
    "PROTON_VKREFLEX",
    "PROTON_MEDIA_USE_GST",
    "PROTON_FSR3_UPGRADE",
    "PROTON_VKD3D_HEAP",
    "WINEPULSE_FAST_POLLING",
}


def config_home(home):
    xdg = os.environ.get("XDG_CONFIG_HOME")
    return Path(xdg) if xdg else home / ".config"


def uses_vr_wrapper(launch_options):
    """Return True if launch_options intentionally delegates to vr-run."""
    if not launch_options or not launch_options.strip():
        return False
    try:
        tokens = shlex.split(launch_options)
    except ValueError:
        tokens = launch_options.split()
    command_at = tokens.index("%command%") if "%command%" in tokens else len(tokens)
    for token in tokens[:command_at]:
        if "=" in token:
            continue
        if Path(token).name in VR_WRAPPERS:
            return True
    return False


def parse_shortcuts_vdf(path):
    """Safely read Steam binary userdata/*/config/shortcuts.vdf (read-only)."""
    try:
        data = Path(path).read_bytes()
    except OSError:
        return []
    pos = 0
    n = len(data)

    def read_cstr():
        nonlocal pos
        end = data.find(b"\x00", pos)
        if end == -1:
            pos = n
            return ""
        val = data[pos:end].decode("utf-8", errors="replace")
        pos = end + 1
        return val

    def read_map():
        nonlocal pos
        out = {}
        while pos < n:
            t = data[pos]
            pos += 1
            if t == 0x08:
                break
            key = read_cstr()
            if t == 0x00:
                out[key] = read_map()
            elif t == 0x01:
                out[key] = read_cstr()
            elif t == 0x02:
                if pos + 4 > n:
                    break
                out[key] = struct.unpack_from("<I", data, pos)[0]
                pos += 4
            elif t == 0x03:
                pos += 4
            elif t == 0x07:
                pos += 8
            else:
                break
        return out

    root = read_map()
    shortcuts = root.get("shortcuts") or root.get("Shortcuts") or {}
    if not isinstance(shortcuts, dict):
        return []
    entries = []
    for entry in shortcuts.values():
        if not isinstance(entry, dict):
            continue
        lower_map = {k.lower(): v for k, v in entry.items()}
        name = str(lower_map.get("appname") or "").strip()
        exe = str(lower_map.get("exe") or "").strip().strip('"')
        start_dir = str(lower_map.get("startdir") or "").strip().strip('"')
        launch_opts = str(lower_map.get("launchoptions") or "").strip()
        raw_id = lower_map.get("appid")
        if isinstance(raw_id, int):
            appid = str(raw_id & 0xFFFFFFFF)
        else:
            appid = str((zlib.crc32((exe + name).encode("utf-8")) | 0x80000000) & 0xFFFFFFFF)
        if not name:
            name = Path(exe).stem if exe else appid
        entries.append({
            "appid": appid,
            "name": name,
            "exe": exe,
            "start_dir": start_dir,
            "launch_options": launch_opts,
            "source": "shortcut",
        })
    return entries


def discover_shortcuts(steam_root):
    shortcuts = {}
    userdata = steam_root / "userdata"
    if not userdata.is_dir():
        return shortcuts
    for vdf in userdata.glob("*/config/shortcuts.vdf"):
        for item in parse_shortcuts_vdf(vdf):
            shortcuts[item["appid"]] = item
    return shortcuts


def find_detector(home):
    candidates = [
        Path(__file__).resolve().with_name("steam-auto-detect"),
        home / ".local/bin/steam-auto-detect",
        Path("/usr/local/bin/steam-auto-detect"),
    ]
    return next((path for path in candidates if path.is_file()), None)


DEFAULT_DETECT_TIMEOUT = 15


def is_vr_appid(detector, appid, cache, timeout=DEFAULT_DETECT_TIMEOUT):
    if appid in cache:
        return cache[appid]
    if detector is None:
        cache[appid] = False
        return False
    try:
        result = subprocess.run(
            [str(detector), "--json", appid],
            stdin=subprocess.DEVNULL,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        cache[appid] = False
        return False
    if result.returncode != 0:
        cache[appid] = False
        return False
    try:
        report = json.loads(result.stdout)
    except json.JSONDecodeError:
        cache[appid] = False
        return False
    is_vr = bool(report.get("is_vr"))
    cache[appid] = is_vr
    return is_vr


def detect_report_entry(
    detector,
    cfg_home,
    wrapper,
    vr_appids,
    synced_appids,
    entry,
    timeout=DEFAULT_DETECT_TIMEOUT,
):
    appid, name, source, sc_opts = entry
    profile_file = cfg_home / "steam-auto-profiler/profiles" / f"{appid}.env"
    if source == "shortcut":
        if uses_vr_wrapper(sc_opts):
            synced_label = "VR"
        elif wrapper in sc_opts:
            synced_label = "Yes"
        else:
            synced_label = "Custom" if sc_opts else "No"
    elif appid in vr_appids:
        synced_label = "VR"
    elif appid in synced_appids:
        synced_label = "Yes"
    else:
        synced_label = "No"

    timed_out = False
    report = {}
    try:
        result = subprocess.run(
            [str(detector), "--json", appid],
            stdin=subprocess.DEVNULL,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        timed_out = True
        print(
            f"Warning: steam-auto-detect timed out after {timeout}s for {name} (AppID {appid})",
            file=sys.stderr,
        )
    except OSError as exc:
        print(
            f"Warning: steam-auto-detect failed for {name} (AppID {appid}): {exc}",
            file=sys.stderr,
        )
        if source != "shortcut":
            return None
    else:
        if result.returncode == 0:
            try:
                report = json.loads(result.stdout)
            except json.JSONDecodeError:
                report = {}
        elif source != "shortcut":
            return None

    if timed_out:
        return {
            "appid": appid,
            "name": name,
            "source": source,
            "class": "timeout",
            "afmf": "Off",
            "compat": "-",
            "profile": "Saved" if profile_file.is_file() else "Auto",
            "synced": synced_label,
        }

    game_cls = report.get("class", "standard")
    if game_cls in ("competitive-anticheat", "vr") or appid == "594650":
        afmf_label = "Locked"
    elif report.get("afmf"):
        afmf_label = "On" if profile_file.is_file() else "Auto"
    elif report.get("has_native_fg"):
        afmf_label = "Native FG"
    elif report.get("is_tool_or_2d"):
        afmf_label = "2D/Tool"
    else:
        afmf_label = "Off"

    return {
        "appid": appid,
        "name": name,
        "source": source,
        "class": game_cls,
        "afmf": afmf_label,
        "compat": report.get("proton_add_config", "-") or "-",
        "profile": "Saved" if profile_file.is_file() else "Auto",
        "synced": synced_label,
    }


def build_report_rows(
    detector,
    cfg_home,
    wrapper,
    vr_appids,
    synced_appids,
    entries,
    timeout=DEFAULT_DETECT_TIMEOUT,
    max_workers=None,
):
    sorted_entries = sorted(entries, key=lambda item: (item[1].lower(), item[0]))
    if not sorted_entries:
        return []
    workers = max_workers if max_workers is not None else min(8, max(2, os.cpu_count() or 4))
    workers = max(1, min(workers, len(sorted_entries)))

    def _run(entry):
        return detect_report_entry(
            detector,
            cfg_home,
            wrapper,
            vr_appids,
            synced_appids,
            entry,
            timeout=timeout,
        )

    if workers == 1:
        raw_rows = [_run(entry) for entry in sorted_entries]
    else:
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
            raw_rows = list(executor.map(_run, sorted_entries))
    return [row for row in raw_rows if row is not None]


def install_systemd_units(home, library_paths=None):
    """Install and enable the user watcher when a user systemd session exists."""
    unit_dir = config_home(home) / "systemd/user"
    unit_dir.mkdir(parents=True, exist_ok=True)
    service = unit_dir / "steam-auto-profiler-sync.service"
    path = unit_dir / "steam-auto-profiler-sync.path"
    service.write_text(
        "[Unit]\n"
        "Description=Synchronize Steam launch options with Steam Auto-Profiler\n\n"
        "[Service]\n"
        "Type=oneshot\n"
        f"ExecStart={Path(__file__).resolve()} --sanitize --wait-for-steam-exit "
        "--steam-exit-timeout 300\n",
        encoding="utf-8",
    )
    if library_paths is None:
        library_paths = discover_libraries(home)
    path_entries = "".join(f"PathChanged={Path(p) / 'steamapps'}\n" for p in library_paths)
    path.write_text(
        "[Unit]\n"
        "Description=Watch Steam app manifests for new games\n\n"
        "[Path]\n"
        + path_entries +
        "Unit=steam-auto-profiler-sync.service\n\n"
        "[Install]\n"
        "WantedBy=default.target\n",
        encoding="utf-8",
    )
    try:
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(
            ["systemctl", "--user", "enable", "--now", path.name],
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        print(
            "Installed systemd user auto-sync units; "
            "user systemd session is unavailable, so enable them manually."
        )
    else:
        print("Enabled systemd user auto-sync watcher.")


def sanitize_launch_option(appid, launch_options, profile_dir, dry_run=False, write_profile=True):
    """Convert a noisy Steam launch string into a managed wrapper and profile."""
    if uses_vr_wrapper(launch_options):
        return launch_options, {}
    try:
        tokens = shlex.split(launch_options)
    except ValueError:
        tokens = launch_options.split()

    command_at = tokens.index("%command%") if "%command%" in tokens else len(tokens)
    before = tokens[:command_at]
    after = tokens[command_at + 1:] if command_at < len(tokens) else []

    profile = {}
    wayland_enabled = False
    wayland_disabled = False
    xwayland_explicit = False
    for token in before:
        if token.lower() in ("-vulkan", "--vulkan"):
            profile["USE_VULKAN"] = "1"
        if "=" not in token:
            continue
        key, value = token.split("=", 1)
        key = key.upper()
        if key == "XWAYLAND":
            if value in ("1", "true", "TRUE"):
                xwayland_explicit = True
            else:
                profile["USE_XWAYLAND"] = "0"
        elif key in ("PROTON_PREFER_SDL", "PROTON_USE_SDL"):
            profile["USE_SDL"] = "1" if value in ("1", "true", "TRUE") else "0"
        elif key == "PROTON_NO_STEAMINPUT":
            profile["USE_SDL"] = "1" if value in ("1", "true", "TRUE") else "0"
        elif key == "PROTON_MLFG_UPGRADE":
            profile["USE_MLFG"] = "1" if value in ("1", "true", "TRUE") else "0"
        elif key in ("PROTON_ENABLE_WAYLAND", "PROTON_USE_WAYLAND"):
            if value in ("1", "true", "TRUE"):
                wayland_enabled = True
            elif value in ("0", "false", "FALSE"):
                wayland_disabled = True
        elif key == "PROTON_NO_NTSYNC":
            profile["PROTON_NO_NTSYNC"] = "1" if value in ("1", "true", "TRUE") else "0"
        elif key == "PROTON_ENABLE_MEDIACONV":
            if value in ("1", "true", "TRUE"):
                profile["USE_VIDEO_FIX"] = "1"
        elif key in RETIRED_PROTON_VARS:
            continue
        elif key == "RADV_PERFTEST":
            parts = {p.strip().lower() for p in value.split(",") if p.strip()}
            if "transfer_queue" in parts:
                profile["USE_TRANSFER_QUEUE"] = "1"
            if "video_decode" in parts:
                profile["USE_VK_VIDEO_DECODE"] = "1"
        elif key == "RADV_EXPERIMENTAL":
            parts = {p.strip().lower() for p in value.split(",") if p.strip()}
            if "video_decode" in parts:
                profile["USE_VK_VIDEO_DECODE"] = "1"
        elif key in ("TRANSFER_QUEUE", "USE_TRANSFER_QUEUE"):
            if value in ("1", "true", "TRUE"):
                profile["USE_TRANSFER_QUEUE"] = "1"
            elif value in ("0", "false", "FALSE"):
                profile["USE_TRANSFER_QUEUE"] = "0"
        elif key in ("NATIVE_ANTILAG", "USE_NATIVE_ANTILAG"):
            if value in ("1", "true", "TRUE"):
                profile["USE_NATIVE_ANTILAG"] = "1"
            elif value in ("0", "false", "FALSE"):
                profile["USE_NATIVE_ANTILAG"] = "0"
        elif key in ("LOW_LATENCY_LAYER_REFLEX", "REFLEX_LAYER", "USE_REFLEX_LAYER"):
            if value in ("1", "true", "TRUE"):
                profile["USE_REFLEX_LAYER"] = "1"
            elif value in ("0", "false", "FALSE"):
                profile["USE_REFLEX_LAYER"] = "0"
        elif key in ("VK_VIDEO_DECODE", "USE_VK_VIDEO_DECODE"):
            if value in ("1", "true", "TRUE"):
                profile["USE_VK_VIDEO_DECODE"] = "1"
            elif value in ("0", "false", "FALSE"):
                profile["USE_VK_VIDEO_DECODE"] = "0"
        elif key in ("BLEEDING_EDGE", "USE_BLEEDING_EDGE"):
            if value in ("1", "true", "TRUE"):
                profile["USE_BLEEDING_EDGE"] = "1"
            elif value in ("0", "false", "FALSE"):
                profile["USE_BLEEDING_EDGE"] = "0"
        elif key in ("CONSERVATIVE", "USE_CONSERVATIVE"):
            if value in ("1", "true", "TRUE"):
                profile["USE_CONSERVATIVE"] = "1"
            elif value in ("0", "false", "FALSE"):
                profile["USE_CONSERVATIVE"] = "0"
        elif key in ("AFMF", "USE_AFMF", "AFMF_ENABLE"):
            if value in ("1", "true", "TRUE"):
                profile["USE_AFMF"] = "1"
            elif value in ("0", "false", "FALSE"):
                profile["USE_AFMF"] = "0"
        elif key == "DISABLE_AFMF":
            if value in ("1", "true", "TRUE"):
                profile["USE_AFMF"] = "0"
        elif key in ("STEAM_CONTROLLER", "USE_STEAM_CONTROLLER"):
            low_val = value.strip().lower()
            if low_val in ("auto", ""):
                profile["USE_STEAM_CONTROLLER"] = "auto"
            elif low_val in ("wayland-hdr", "wayland_hdr", "waylandhdr", "1", "true", "on", "yes"):
                profile["USE_STEAM_CONTROLLER"] = "wayland-hdr"
            elif low_val in ("xwayland", "x11"):
                profile["USE_STEAM_CONTROLLER"] = "xwayland"
            elif low_val in ("0", "false", "off", "no"):
                profile["USE_STEAM_CONTROLLER"] = "off"

    if wayland_enabled:
        profile.pop("USE_XWAYLAND", None)
    elif xwayland_explicit or wayland_disabled:
        profile["USE_XWAYLAND"] = "1"

    preserved_after = []
    for token in after:
        if token in WRAPPERS or token.startswith("%"):
            continue
        if "=" in token:
            key = token.split("=", 1)[0].upper()
            if any(key.startswith(prefix.rstrip("=")) for prefix in MANAGED_ENV_PREFIXES):
                continue
        preserved_after.append(token)

    replacement = "steam-auto-run %command%"
    if preserved_after:
        replacement += " " + " ".join(preserved_after)

    has_command = "%command%" in tokens
    env_only = bool(before) and all(
        "=" in token or token in WRAPPERS
        for token in before
    )
    if not has_command and env_only:
        replacement = ""

    should_clean_existing = False
    if write_profile and not dry_run and not profile:
        profile_file = profile_dir / f"{appid}.env"
        if profile_file.exists():
            for raw in profile_file.read_text(encoding="utf-8", errors="ignore").splitlines():
                line = raw.strip()
                if "=" in line and not line.startswith("#"):
                    if line.split("=", 1)[0].strip().upper() in RETIRED_PROTON_VARS:
                        should_clean_existing = True
                        break

    if (profile or should_clean_existing) and write_profile and not dry_run:
        profile_dir.mkdir(parents=True, exist_ok=True)
        profile_file = profile_dir / f"{appid}.env"
        existing = {}
        existing_lines = []
        if profile_file.exists():
            existing_lines = profile_file.read_text(encoding="utf-8", errors="ignore").splitlines()
            for raw in existing_lines:
                line = raw.strip()
                if "=" in line and not line.startswith("#"):
                    key, value = line.split("=", 1)
                    key = key.strip()
                    if key.upper() in RETIRED_PROTON_VARS:
                        continue
                    existing[key] = value.strip()
        for key, value in profile.items():
            existing.setdefault(key, value)
        if existing_lines:
            full_profile_keys = {
                "USE_XWAYLAND", "USE_MLFG", "USE_OPTISCALER", "USE_SHARPEN",
                "USE_NET_OPT", "USE_CEF_FIX",
            }
            if not full_profile_keys.issubset(existing):
                existing.setdefault("PARTIAL_PROFILE", "1")
        else:
            existing["PARTIAL_PROFILE"] = "1"
        locked_write(
            profile_file,
            "".join(f"{key}={value}\n" for key, value in sorted(existing.items())),
        )
    return replacement, profile


def migrate_cachy_profiles(home, dry_run=False):
    cfg = config_home(home)
    source = cfg / "cachy-run/profiles"
    target = cfg / "steam-auto-profiler/profiles"
    migrated = []
    if not source.is_dir():
        return migrated
    target.mkdir(parents=True, exist_ok=True)
    for source_file in sorted(source.glob("*.env")):
        destination = target / source_file.name
        merged = {}
        order = []
        if destination.exists():
            for raw in destination.read_text(encoding="utf-8", errors="ignore").splitlines():
                line = raw.strip()
                if "=" in line and not line.startswith("#"):
                    key, value = line.split("=", 1)
                    key = key.strip()
                    if key not in merged:
                        order.append(key)
                    merged[key] = value.strip()
        preset = None
        for raw in source_file.read_text(encoding="utf-8", errors="ignore").splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip()
            if key.upper() in RETIRED_PROTON_VARS:
                continue
            if key == "USE_RCAS":
                key = "USE_SHARPEN"
            elif key == "AUTO_PRESET":
                preset = value.strip("'\"")
                if preset == "shooter":
                    value = "'competitive'"
                    preset = "competitive"
                elif preset == "oled-clean":
                    value = "'oled-clean'"
            if key not in merged:
                order.append(key)
            merged[key] = value
        if preset in ("shooter", "competitive"):
            if "USE_NET_OPT" not in merged:
                order.append("USE_NET_OPT")
            merged["USE_NET_OPT"] = "1"
        if not dry_run:
            locked_write(destination, "".join(f"{key}={merged[key]}\n" for key in order))
        migrated.append(source_file.name)
    return migrated


def discover_libraries(home):
    candidates = [
        home / ".local/share/Steam",
        home / ".steam/steam",
        home / ".var/app/com.valvesoftware.Steam/.local/share/Steam",
    ]
    roots, seen = [], set()
    for candidate in candidates:
        if not (candidate / "steamapps").is_dir():
            continue
        root = candidate.resolve()
        if root in seen:
            continue
        seen.add(root)
        roots.append(candidate)
        vdf = candidate / "steamapps/libraryfolders.vdf"
        if vdf.exists():
            for match in re.finditer(r'"path"\s+"([^"]+)"', vdf.read_text(encoding="utf-8", errors="ignore")):
                library = Path(match.group(1))
                resolved = library.resolve()
                if (library / "steamapps").is_dir() and resolved not in seen:
                    seen.add(resolved)
                    roots.append(library)
    return roots


def locked_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        handle.seek(0)
        handle.truncate()
        handle.write(text)
        handle.flush()
        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def acquire_sync_lock():
    runtime_dir = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    runtime_dir.mkdir(parents=True, exist_ok=True)
    handle = (runtime_dir / "steam-auto-sync.lock").open("a+", encoding="utf-8")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def prune_backups(config, keep):
    if keep == 0:
        return
    backups = sorted(config.parent.glob("localconfig.vdf.bak.*"),
                     key=lambda p: p.stat().st_mtime, reverse=True)
    for old in backups[keep:]:
        old.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(
        description="Batch-inject or remove steam-auto-run in Steam localconfig.vdf."
    )
    parser.add_argument("-n", "--dry-run", action="store_true")
    parser.add_argument("--remove", action="store_true")
    parser.add_argument("--report", "--status", dest="report", action="store_true")
    parser.add_argument("--wrapper", default="steam-auto-run")
    parser.add_argument("--sanitize", "--clean", action="store_true")
    parser.add_argument("--migrate-cachy-run", action="store_true")
    parser.add_argument("--install-systemd", action="store_true")
    parser.add_argument("--keep-backups", type=int, default=10, metavar="N",
                        help="keep N localconfig backups (0 keeps all; default: 10)")
    parser.add_argument("--print-library-paths", action="store_true",
                        help="print discovered Steam library paths and exit")
    parser.add_argument(
        "--wait-for-steam-exit",
        action="store_true",
        help="wait for Steam to exit before modifying localconfig.vdf",
    )
    parser.add_argument(
        "--steam-exit-timeout",
        type=int,
        default=300,
        metavar="SECONDS",
        help="maximum wait for Steam to exit (default: 300)",
    )
    args = parser.parse_args()
    if args.keep_backups < 0:
        parser.error("--keep-backups must be zero or greater")

    home = Path.home()
    if args.print_library_paths:
        for library in discover_libraries(home):
            print(library)
        return 0
    if args.install_systemd:
        install_systemd_units(home, discover_libraries(home))
        return 0
    if args.migrate_cachy_run:
        profile_dir = home / ".config/steam-auto-profiler/profiles"
        migrated = migrate_cachy_profiles(home, dry_run=args.dry_run)
        prefix = "[DRY-RUN] " if args.dry_run else ""
        print(f"{prefix}Migrated {len(migrated)} cachy-run profile(s):")
        for name in migrated:
            print(f"  + {name}")
        if not args.sanitize:
            return 0

    if not args.dry_run and not args.report:
        steam_running = subprocess.run(
            ["pgrep", "-x", "steam"],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=5,
        ).returncode == 0
        if steam_running and args.wait_for_steam_exit:
            deadline = time.monotonic() + max(0, args.steam_exit_timeout)
            print("Steam is running; waiting for it to exit before syncing.")
            while steam_running and time.monotonic() < deadline:
                time.sleep(2)
                steam_running = subprocess.run(
                    ["pgrep", "-x", "steam"],
                    stdin=subprocess.DEVNULL,
                    capture_output=True,
                    timeout=5,
                ).returncode == 0
            if steam_running:
                print(
                    f"Error: Steam did not exit within {args.steam_exit_timeout} seconds.",
                    file=sys.stderr,
                )
                return 1
        elif steam_running:
            print("Error: Close Steam completely before syncing.", file=sys.stderr)
            return 1

    roots = discover_libraries(home)

    if not roots:
        print("No Steam installation directory found.", file=sys.stderr)
        return 1

    skip_re = re.compile(
        r"^(Proton\b|Steam Linux Runtime|Steamworks Common Redistributables|"
        r"Wallpaper Engine|Lossless Scaling|SteamVR\b|\bVR\b)",
        re.I,
    )
    ignored_ids = {"228980", "250820"}
    cfg_home = config_home(home)
    ignore_file = cfg_home / "steam-auto-profiler/ignore_appids.txt"
    if ignore_file.exists():
        for line in ignore_file.read_text(encoding="utf-8", errors="ignore").splitlines():
            token = line.split("#", 1)[0].strip()
            if token.isdigit():
                ignored_ids.add(token)

    write_lock = None
    if not args.dry_run and not args.report:
        write_lock = acquire_sync_lock()

    try:
        for steam_root in roots:
            libraries = [steam_root]
            library_vdf = steam_root / "steamapps/libraryfolders.vdf"
            if library_vdf.exists():
                for match in re.finditer(
                    r'"path"\s+"([^"]+)"',
                    library_vdf.read_text(encoding="utf-8", errors="ignore"),
                ):
                    path = Path(match.group(1))
                    if path not in libraries and (path / "steamapps").is_dir():
                        libraries.append(path)

            games = {}
            for library in libraries:
                for acf in (library / "steamapps").glob("appmanifest_*.acf"):
                    text = acf.read_text(encoding="utf-8", errors="ignore")
                    appid_match = re.search(r'"appid"\s+"(\d+)"', text)
                    name_match = re.search(r'"name"\s+"([^"]+)"', text)
                    if not appid_match:
                        continue
                    appid = appid_match.group(1)
                    name = name_match.group(1) if name_match else appid
                    if appid in ignored_ids or skip_re.search(name):
                        continue
                    games[appid] = name

            if args.report:
                detector = find_detector(home)
                if detector is None:
                    print("Error: steam-auto-detect not found.", file=sys.stderr)
                    return 1

                synced_appids = set()
                vr_appids = set()
                for config in (steam_root / "userdata").glob("*/config/localconfig.vdf"):
                    raw = config.read_text(encoding="utf-8", errors="ignore")
                    app_launch, _, _ = find_launch_options(raw)
                    for appid, (launch_options, _, _) in app_launch.items():
                        if uses_vr_wrapper(launch_options):
                            vr_appids.add(appid)
                        elif args.wrapper in launch_options:
                            synced_appids.add(appid)

                shortcuts = discover_shortcuts(steam_root)
                all_entries = [(appid, name, "steam", "") for appid, name in games.items()]
                for sc_id, sc in shortcuts.items():
                    if sc_id not in games:
                        all_entries.append((sc_id, sc["name"], "shortcut", sc["launch_options"]))

                rows = build_report_rows(
                    detector,
                    cfg_home,
                    args.wrapper,
                    vr_appids,
                    synced_appids,
                    all_entries,
                    timeout=DEFAULT_DETECT_TIMEOUT,
                )

                headers = ("AppID", "Game Name", "Source", "Class", "AFMF", "Compat Tokens", "Profile", "Synced")
                if rows:
                    widths = [
                        max(len(headers[0]), *(len(row["appid"]) for row in rows)),
                        max(len(headers[1]), *(len(row["name"]) for row in rows)),
                        max(len(headers[2]), *(len(row["source"]) for row in rows)),
                        max(len(headers[3]), *(len(row["class"]) for row in rows)),
                        max(len(headers[4]), *(len(row["afmf"]) for row in rows)),
                        max(len(headers[5]), *(len(row["compat"]) for row in rows)),
                        max(len(headers[6]), *(len(row["profile"]) for row in rows)),
                        max(len(headers[7]), *(len(row["synced"]) for row in rows)),
                    ]
                    print(" | ".join(value.ljust(width) for value, width in zip(headers, widths)))
                    print("-+-".join("-" * width for width in widths))
                    for row in rows:
                        values = (
                            row["appid"], row["name"], row["source"], row["class"],
                            row["afmf"], row["compat"], row["profile"], row["synced"],
                        )
                        print(" | ".join(value.ljust(width) for value, width in zip(values, widths)))
                else:
                    widths = tuple(max(len(header), 1) for header in headers)
                    print(" | ".join(value.ljust(width) for value, width in zip(headers, widths)))
                    print("-+-".join("-" * width for width in widths))
                    print("No installed Steam games found.")
                return 0

            detector = find_detector(home)
            vr_cache = {}
            for config in (steam_root / "userdata").glob("*/config/localconfig.vdf"):
                raw = config.read_text(encoding="utf-8", errors="ignore")
                app_launch, app_close, apps_close = find_launch_options(raw)
                if apps_close is None:
                    continue

                edits = []
                changed = []
                for appid, name in sorted(games.items(), key=lambda item: item[1].lower()):
                    effective_wrapper = args.wrapper
                    if not args.remove and args.wrapper == "steam-auto-run" and is_vr_appid(detector, appid, vr_cache):
                        effective_wrapper = "vr-run"

                    if appid not in app_launch:
                        if args.remove:
                            continue
                        pos = app_close.get(appid, apps_close)
                        if appid in app_close:
                            rep = (
                                f'\t\t\t\t"LaunchOptions"\t\t"{effective_wrapper} %command%"\n'
                                "\t\t\t"
                            )
                        else:
                            rep = (
                                f'\t"{appid}"\n'
                                "\t\t{\n"
                                f'\t\t\t"LaunchOptions"\t\t"{effective_wrapper} %command%"\n'
                                "\t\t}\n"
                            )
                        edits.append((pos, pos, rep))
                        changed.append((appid, name))
                        continue

                    current, start, end = app_launch[appid]
                    if args.remove:
                        if args.wrapper not in current:
                            continue
                        replacement = re.sub(
                            rf"\b{re.escape(args.wrapper)}\s+%command%", "%command%", current
                        ).strip()
                        if replacement == "%command%":
                            replacement = ""
                    elif args.sanitize:
                        if uses_vr_wrapper(current):
                            continue
                        if effective_wrapper == "vr-run" and current.strip() in ("", "%command%"):
                            replacement = "vr-run %command%"
                        else:
                            profile_dir = cfg_home / "steam-auto-profiler/profiles"
                            replacement, extracted_profile = sanitize_launch_option(
                                appid, current, profile_dir, dry_run=args.dry_run
                            )
                        if replacement == current:
                            continue
                    else:
                        if uses_vr_wrapper(current) and args.wrapper not in VR_WRAPPERS:
                            continue
                        if args.wrapper in current:
                            continue
                        if "%command%" in current:
                            replacement = current.replace(
                                "%command%", f"{effective_wrapper} %command%", 1
                            )
                        elif current.strip():
                            replacement = f"{effective_wrapper} %command% {current.strip()}"
                        else:
                            replacement = f"{effective_wrapper} %command%"

                    escaped = replacement.replace("\\", "\\\\").replace('"', '\\"')
                    edits.append((start, end, f'"{escaped}"'))
                    changed.append((appid, name))

                if args.sanitize:
                    for appid, (current, start, end) in app_launch.items():
                        if appid in games:
                            continue
                        if uses_vr_wrapper(current):
                            continue
                        lowered = current.lower()
                        looks_managed = any(wrapper in lowered.split() for wrapper in WRAPPERS)
                        looks_managed = looks_managed or any(
                            re.search(pattern, current, re.I)
                            for pattern in (
                                r"(?:^|\s)PROTON_[A-Z0-9_]*=",
                                r"(?:^|\s)DXVK_[A-Z0-9_]*=",
                                r"(?:^|\s)VKD3D_[A-Z0-9_]*=",
                                r"(?:^|\s)WINE[A-Z0-9_]*=",
                                r"(?:^|\s)ENABLE_LAYER_MESA_ANTI_LAG=",
                                r"(?:^|\s)ENABLE_VKBASALT=",
                                r"(?:^|\s)RADV_(?:PERFTEST|EXPERIMENTAL)=",
                                r"(?:^|\s)LOW_LATENCY_LAYER(?:_REFLEX)?=",
                                r"(?:^|\s)(?:USE_)?BLEEDING_EDGE=",
                                r"(?:^|\s)(?:USE_)?STEAM_CONTROLLER=",
                            )
                        )
                        if not looks_managed:
                            continue
                        profile_dir = cfg_home / "steam-auto-profiler/profiles"
                        replacement, _ = sanitize_launch_option(
                            appid, current, profile_dir,
                            dry_run=args.dry_run,
                            write_profile=False,
                        )
                        if replacement == current:
                            continue
                        escaped = replacement.replace("\\", "\\\\").replace('"', '\\"')
                        edits.append((start, end, f'"{escaped}"'))
                        changed.append((appid, f"Orphan AppID {appid}"))

                if edits and not args.dry_run:
                    backup = config.with_name(f"localconfig.vdf.bak.{time.time_ns()}")
                    shutil.copy2(config, backup)
                    prune_backups(config, args.keep_backups)
                    output = raw
                    for start, end, replacement in sorted(edits, key=lambda edit: edit[0], reverse=True):
                        output = output[:start] + replacement + output[end:]
                    locked_write(config, output)

                prefix = "[DRY-RUN] " if args.dry_run else ""
                action = "Removed from" if args.remove else "Updated"
                print(f"{prefix}{action} {len(changed)} game(s) in profile {config.parent.parent.name}:")
                for appid, name in changed:
                    print(f"  {'-' if args.remove else '+'} [{appid}] {name}")
    finally:
        if write_lock is not None:
            fcntl.flock(write_lock.fileno(), fcntl.LOCK_UN)
            write_lock.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
