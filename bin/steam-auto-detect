#!/usr/bin/env bash

# Context-aware heuristic game classifier for Steam on Linux.

set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

load_profile_safe() {
    local file="$1" line key value
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"; line="${line#"${line%%[![:space:]]*}"}"
        [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
        key="${line%%=*}"; value="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        case "$key" in
            USE_*|PROTON_OPTISCALER_*|NO_NTSYNC|NO_DECORATION|VRR_CAP|VRR_MINUS_MARGIN|KEEP_OVERLAY|AUTO_PRESET|PARTIAL_PROFILE|PROTON_NO_NTSYNC|WAYLANDDRV_SHORTCUT_INHIBIT|AUTO_HDR_SWITCH)
                ;;
            *) continue ;;
        esac
        value="${value#"${value%%[![:space:]]*}"}"; value="${value%"${value##*[![:space:]]}"}"
        if [[ "$value" == \"*\" && "$value" == *\" ]]; then value="${value:1:${#value}-2}"
        elif [[ "$value" == \'*\' && "$value" == *\' ]]; then value="${value:1:${#value}-2}"; fi
        # shellcheck disable=SC2016
        [[ "$value" != *'$('* && "$value" != *'`'* && "$value" != *';'* ]] || continue
        printf -v "$key" '%s' "$value"
    done < "$file"
}

INSPECT_MODE=0
JSON_MODE=0
APPID=""

usage() {
    cat <<'EOF'
Usage: steam-auto-detect [--inspect] [APPID]

Options:
  --inspect, -i  Print a human-readable diagnostic report
  --json         Print the classification report as JSON (with --inspect)
  --help, -h     Show this help message
EOF
}

while (($#)); do
    case "$1" in
        --inspect|-i)
            INSPECT_MODE=1
            shift
            ;;
        --json)
            JSON_MODE=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            APPID="$1"
            shift
            ;;
    esac
done

APPID="${APPID:-${SteamAppId:-${STEAM_COMPAT_APP_ID:-${GAMEID:-}}}}"
APPID="${APPID#umu-}"

AUTO_CLASS="standard"
AUTO_PRESET="standard"
AUTO_OPTISCALER=0
AUTO_SHARPEN=1
AUTO_NET_OPT=0
AUTO_CEF_FIX=0
AUTO_NATIVE_LINUX=0
AUTO_IS_VR=0
AUTO_HAS_DLSS=0
AUTO_HAS_XESS=0
AUTO_HAS_FSR=0
AUTO_SOURCE="steam"
AUTO_UPSCALER_INFO="None detected"
NTFS_MOUNT=0
AUTO_REASON="No anti-cheat or modern upscaler DLLs detected; using standard low-latency profile"
GAME_NAME="Unknown / Non-Steam"
GAME_DIR=""
SHORTCUT_LAUNCH_OPTS=""
AUTO_PROTON_ADD_CONFIG=""

detect_gpu_vendor() {
    local vendor_file found_intel=0
    for vendor_file in /sys/class/drm/card*/device/vendor; do
        [[ -r "$vendor_file" ]] || continue
        case "$(cat "$vendor_file" 2>/dev/null)" in
            0x1002) echo amd; return ;;
            0x10de) echo nvidia; return ;;
            0x8086) found_intel=1 ;;
        esac
    done
    if [[ "$found_intel" -eq 1 ]]; then
        echo intel
        return
    fi
    echo unknown
}

find_steam_roots() {
    local candidates=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
    )
    local root
    for root in "${candidates[@]}"; do
        if [[ -d "$root/steamapps" ]]; then
            printf '%s\n' "$root"
        fi
    done
}

if [[ -n "$APPID" ]]; then
    declare -a libs=()
    declare -A seen_roots=()

    while IFS= read -r root; do
        [[ -n "$root" && -z "${seen_roots[$root]:-}" ]] || continue
        seen_roots["$root"]=1
        libs+=("$root")

        local_vdf="$root/steamapps/libraryfolders.vdf"
        if [[ -f "$local_vdf" ]]; then
            while IFS= read -r library_path; do
                [[ -d "$library_path/steamapps" ]] || continue
                [[ -z "${seen_roots[$library_path]:-}" ]] || continue
                seen_roots["$library_path"]=1
                libs+=("$library_path")
            done < <(
                grep -oE '"path"[[:space:]]+"[^"]+"' "$local_vdf" \
                    | sed -E 's/"path"[[:space:]]+"([^"]+)"/\1/'
            )
        fi
    done < <(find_steam_roots)

    for lib in "${libs[@]}"; do
        acf="$lib/steamapps/appmanifest_${APPID}.acf"
        [[ -f "$acf" ]] || continue

        GAME_NAME=$(
            grep -m1 '"name"' "$acf" \
                | sed -E 's/.*"name"[[:space:]]+"([^"]+)".*/\1/' \
                || printf '%s' "$APPID"
        )
        install_dir=$(
            grep -m1 '"installdir"' "$acf" \
                | sed -E 's/.*"installdir"[[:space:]]+"([^"]+)".*/\1/' \
                || true
        )
        if [[ -n "$install_dir" && -d "$lib/steamapps/common/$install_dir" ]]; then
            GAME_DIR="$lib/steamapps/common/$install_dir"
        fi
        break
    done

    if [[ -z "$GAME_DIR" && "$GAME_NAME" == "Unknown / Non-Steam" ]]; then
        shortcut_info="$(
            python3 - "$APPID" "${libs[@]}" <<'PY' 2>/dev/null || true
import os
import struct
import sys
import zlib
from pathlib import Path

target_appid = sys.argv[1]
roots = [Path(p) for p in sys.argv[2:]]


def parse_shortcuts_vdf(data: bytes):
    pos = 0
    n = len(data)

    def read_cstr():
        nonlocal pos
        end = data.find(b"\x00", pos)
        if end == -1:
            pos = n
            return ""
        val = data[pos:end].decode("utf-8", errors="replace")
        pos = end + 1
        return val

    def read_map():
        nonlocal pos
        out = {}
        while pos < n:
            t = data[pos]
            pos += 1
            if t == 0x08:
                break
            key = read_cstr()
            if t == 0x00:
                out[key] = read_map()
            elif t == 0x01:
                out[key] = read_cstr()
            elif t == 0x02:
                if pos + 4 > n:
                    break
                out[key] = struct.unpack_from("<I", data, pos)[0]
                pos += 4
            elif t == 0x03:
                pos += 4
            elif t == 0x07:
                pos += 8
            else:
                break
        return out

    root = read_map()
    shortcuts = root.get("shortcuts") or root.get("Shortcuts") or {}
    if not isinstance(shortcuts, dict):
        return []
    entries = []
    for entry in shortcuts.values():
        if not isinstance(entry, dict):
            continue
        lower_map = {k.lower(): v for k, v in entry.items()}
        name = str(lower_map.get("appname") or "").strip()
        exe = str(lower_map.get("exe") or "").strip().strip('"')
        start_dir = str(lower_map.get("startdir") or "").strip().strip('"')
        launch_opts = str(lower_map.get("launchoptions") or "").strip()
        raw_id = lower_map.get("appid")
        if isinstance(raw_id, int):
            aid = str(raw_id & 0xFFFFFFFF)
        else:
            aid = str((zlib.crc32((exe + name).encode("utf-8")) | 0x80000000) & 0xFFFFFFFF)
        if not start_dir and exe:
            parent = str(Path(exe).parent)
            if os.path.isdir(parent):
                start_dir = parent
        entries.append((aid, name or aid, start_dir, launch_opts))
    return entries


for root in roots:
    userdata = root / "userdata"
    if not userdata.is_dir():
        continue
    for vdf in userdata.glob("*/config/shortcuts.vdf"):
        try:
            raw = vdf.read_bytes()
        except OSError:
            continue
        for aid, name, start_dir, launch_opts in parse_shortcuts_vdf(raw):
            if aid == target_appid:
                print(f"{name}\t{start_dir}\t{launch_opts}")
                sys.exit(0)
PY
        )"
        if [[ -n "$shortcut_info" ]]; then
            IFS=$'\t' read -r sc_name sc_dir sc_opts <<<"$shortcut_info"
            AUTO_SOURCE="shortcut"
            [[ -n "$sc_name" ]] && GAME_NAME="$sc_name"
            [[ -n "$sc_dir" && -d "$sc_dir" ]] && GAME_DIR="$sc_dir"
            SHORTCUT_LAUNCH_OPTS="${sc_opts:-}"
            if [[ "$SHORTCUT_LAUNCH_OPTS" =~ (^|[[:space:]])([^[:space:]]*/)?vr-run([[:space:]]|$) ||
                  "$SHORTCUT_LAUNCH_OPTS" =~ (^|[[:space:]])--?vr([[:space:]]|$) ]]; then
                AUTO_IS_VR=1
            fi
        fi
    fi

    declare -a DETECTED_FSR31_DLLS=()
    declare -a DETECTED_LEGACY_DLLS=()
    declare -A SEEN_UPSCALER_DLLS=()

    if [[ -n "$GAME_DIR" ]]; then
        if command -v df >/dev/null 2>&1; then
            MOUNT_FSTYPE=$(
                df -T -- "$GAME_DIR" 2>/dev/null \
                    | awk 'NR == 2 {print tolower($2)}'
            )
            case "${MOUNT_FSTYPE:-}" in
                ntfs|ntfs3|fuseblk) NTFS_MOUNT=1 ;;
            esac
        fi

        AC_MATCH=""
        VR_MATCH=""
        FSR4_MATCH=""
        FSR_MATCH=""
        UPSCALE_MATCH=""
        CEF_MATCH=""
        EXE_MATCH=""
        while IFS= read -r asset; do
            base="${asset##*/}"; lower="${base,,}"
            case "$lower" in
                openvr_api.dll|openvr_api.so|openxr_loader.dll|libopenxr_loader.so*|*.vrmanifest|*steamvr*manifest*)
                    AUTO_IS_VR=1
                    [[ -n "$VR_MATCH" ]] || VR_MATCH="$asset"
                    ;;
            esac
            case "$lower" in
                nvngx_dlss*.dll)
                    AUTO_HAS_DLSS=1
                    [[ -n "$UPSCALE_MATCH" ]] || UPSCALE_MATCH="$asset"
                    if [[ -z "${SEEN_UPSCALER_DLLS[$lower]:-}" ]]; then
                        SEEN_UPSCALER_DLLS["$lower"]=1
                        DETECTED_LEGACY_DLLS+=("$base")
                    fi
                    ;;
                libxess*.dll)
                    AUTO_HAS_XESS=1
                    [[ -n "$UPSCALE_MATCH" ]] || UPSCALE_MATCH="$asset"
                    if [[ -z "${SEEN_UPSCALER_DLLS[$lower]:-}" ]]; then
                        SEEN_UPSCALER_DLLS["$lower"]=1
                        DETECTED_LEGACY_DLLS+=("$base")
                    fi
                    ;;
                amdxcffx64.dll|ffx_fsr2*.dll|ffx_fsr3*.dll|amd_fidelityfx*.dll) AUTO_HAS_FSR=1 ;;
            esac
            if [[ "$lower" == amd_fidelityfx_upscaler_dx12.dll ||
                  "$lower" == amd_fidelityfx_upscaler_vk.dll ||
                  "$lower" == amd_fidelityfx_framegeneration_dx12.dll ||
                  "$lower" == amd_fidelityfx_loader_dx12.dll ]] &&
               [[ -z "$FSR4_MATCH" ]]; then
                FSR4_MATCH="$asset"
            fi
            case "$lower" in
                amd_fidelityfx_dx12.dll|amd_fidelityfx_vk.dll|amd_fidelityfx_loader_dx12.dll|amd_fidelityfx_loader_vk.dll|amd_fidelityfx_upscaler_dx12.dll|amd_fidelityfx_upscaler_vk.dll|amdxcffx64.dll)
                    [[ -n "$FSR_MATCH" ]] || FSR_MATCH="$asset"
                    if [[ -z "${SEEN_UPSCALER_DLLS[$lower]:-}" ]]; then
                        SEEN_UPSCALER_DLLS["$lower"]=1
                        DETECTED_FSR31_DLLS+=("$base")
                    fi
                    ;;
                sl.interposer.dll|ffx_fsr2*.dll|ffx_fsr3*.dll)
                    [[ -n "$UPSCALE_MATCH" ]] || UPSCALE_MATCH="$asset"
                    if [[ -z "${SEEN_UPSCALER_DLLS[$lower]:-}" ]]; then
                        SEEN_UPSCALER_DLLS["$lower"]=1
                        DETECTED_LEGACY_DLLS+=("$base")
                    fi
                    ;;
            esac
            case "$lower" in
                *easyanticheat*|*battleye*|*beservice*|*randgrid*|*ricochet*.sys|*ace-base*|*anticheatexpert*|*nprotect*|*gameguard*|*xigncode*|*wellbia*|*mhyprot*|*hoyokprotect*|*equ8*|*fairfight*|*punkbuster*|*anticheat*.exe|*anticheat*.dll|*anticheat*.sys|*anticheat*.so)
                    [[ -n "$AC_MATCH" ]] || AC_MATCH="$asset" ;;
                *eadesktop*|*originthinsetup*|*ubisoftconnect*|*uplay*|*battle.net*|*rockstar-games-launcher*)
                    [[ -n "$CEF_MATCH" ]] || CEF_MATCH="$asset" ;;
            esac
            if [[ "$lower" == *.exe && -z "$EXE_MATCH" ]]; then
                EXE_MATCH="$asset"
            fi
        done < <(
            find "$GAME_DIR" -maxdepth 10 \
                -type d \( -iname screenshots -o -iname saves -o -iname savegames \
                    -o -iname logs -o -iname shadercache -o -iname workshop \
                    -o -iname movies -o -iname videos -o -iname localization \) -prune \
                -o -type f -print 2>/dev/null
        )
    fi

    if [[ -n "$GAME_DIR" && -z "${EXE_MATCH:-}" ]]; then
        AUTO_NATIVE_LINUX=1
    fi

    IS_ANTICHEAT=0
    case "$APPID" in
        730|570|252490|304390|393380|553850|581320|594650|1085660|1172470|1172620|1874880|1938090|2051620|2073850|2100280|2357570|2479810|2767030|2887580)
            IS_ANTICHEAT=1
            AUTO_REASON="Known competitive multiplayer / anti-cheat AppID ($APPID)"
            ;;
    esac

    if [[ "$IS_ANTICHEAT" -eq 0 && -n "$GAME_DIR" ]]; then
        if [[ -n "$AC_MATCH" ]]; then
            IS_ANTICHEAT=1
            AUTO_REASON="Anti-cheat runtime detected: $(basename "$AC_MATCH")"
        fi
    fi

    if [[ "$IS_ANTICHEAT" -eq 1 ]]; then
        AUTO_CLASS="competitive-anticheat"
        AUTO_PRESET="competitive"
        AUTO_OPTISCALER=0
        AUTO_SHARPEN=0
        AUTO_NET_OPT=1
    elif [[ "$AUTO_IS_VR" -eq 1 ]]; then
        AUTO_CLASS="vr"
        AUTO_PRESET="standard"
        AUTO_OPTISCALER=0
        AUTO_SHARPEN=0
        AUTO_REASON="VR runtime library/manifest detected ($(basename "${VR_MATCH:-vr}")); recommend vr-run %command%"
    elif [[ -n "$GAME_DIR" && -n "${FSR4_MATCH:-}" ]]; then
        AUTO_CLASS="native-fsr4"
        AUTO_PRESET="standard"
        AUTO_OPTISCALER=0
        AUTO_SHARPEN=0
        AUTO_REASON="Native FidelityFX SDK 3.1+ library detected ($(basename "$FSR4_MATCH")); using driver-level FSR upgrade"
    elif [[ -n "$GAME_DIR" && -n "${FSR_MATCH:-}" ]]; then
        AUTO_CLASS="native-fsr"
        AUTO_PRESET="standard"
        AUTO_OPTISCALER=0
        AUTO_SHARPEN=0
        AUTO_REASON="Native FSR 3.1+ library detected ($(basename "$FSR_MATCH")); using driver-level FSR upgrade"
    elif [[ -n "$GAME_DIR" && -n "${UPSCALE_MATCH:-}" ]]; then
        AUTO_CLASS="legacy-upscaler"
        AUTO_PRESET="standard"
        AUTO_OPTISCALER=1
        AUTO_SHARPEN=0
        AUTO_REASON="Legacy upscaler detected ($(basename "$UPSCALE_MATCH")); optional bridge may be used"
    fi

    if [[ -n "$GAME_DIR" && -n "${CEF_MATCH:-}" ]]; then
        AUTO_CEF_FIX=1
    fi

    if (( ${#DETECTED_FSR31_DLLS[@]} > 0 )); then
        fsr31_list="$(IFS=', '; echo "${DETECTED_FSR31_DLLS[*]}")"
        AUTO_UPSCALER_INFO="FidelityFX 3.1+ (${fsr31_list}) -> eligible for native PROTON_FSR4_UPGRADE=1"
    elif (( ${#DETECTED_LEGACY_DLLS[@]} > 0 )); then
        legacy_list="$(IFS=', '; echo "${DETECTED_LEGACY_DLLS[*]}")"
        AUTO_UPSCALER_INFO="Legacy upscaler (${legacy_list}) -> PROTON_FSR4_UPGRADE=1 alone will not hook; recommend USE_OPTISCALER=1"
    fi
fi

GPU_VENDOR="$(detect_gpu_vendor)"
PROFILE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/steam-auto-profiler/profiles/$APPID.env"
if [[ -n "$APPID" && -f "$PROFILE_FILE" ]]; then
    load_profile_safe "$PROFILE_FILE"
fi
COMPAT_TOKENS=()
if [[ -n "${WAYLAND_DISPLAY:-}" && "${XWAYLAND:-0}" -ne 1 && "${USE_XWAYLAND:-0}" -ne 1 ]]; then
    COMPAT_TOKENS+=("wayland")
fi
if [[ -n "${WINE_DISABLE_VULKAN_OPWR:-}" && "${WINE_DISABLE_VULKAN_OPWR:-0}" -eq 1 ]]; then
    COMPAT_TOKENS+=("noopwr")
elif [[ -n "${WAYLAND_DISPLAY:-}" && "${XWAYLAND:-0}" -ne 1 && "${USE_XWAYLAND:-0}" -ne 1 ]]; then
    COMPAT_TOKENS+=("noopwr")
fi
if [[ "$GPU_VENDOR" == "amd" ]]; then
    COMPAT_TOKENS+=("nativeags")
fi
if [[ "${SAFEDX12:-0}" -ne 1 && "${USE_SAFEDX12:-0}" -eq 0 ]]; then
    COMPAT_TOKENS+=("vkd3dbindlesstb")
fi
if [[ "${MLFG:-0}" -eq 0 && "${USE_MLFG:-0}" -eq 0 ]]; then
    COMPAT_TOKENS+=("dxvklowlatency" "vkd3dlowlatency")
    if [[ "$GPU_VENDOR" == "nvidia" ]]; then
        COMPAT_TOKENS+=("vkreflex")
    fi
fi
if [[ "${FSR4:-${USE_FSR4:-1}}" -ne 0 ]] &&
   [[ "$AUTO_CLASS" == "native-fsr4" || "$AUTO_CLASS" == "native-fsr" || "$AUTO_CLASS" == "legacy-upscaler" ||
      "${FSR4:-0}" -eq 1 || "${PROTON_FSR4_UPGRADE:-0}" -eq 1 ]]; then
    COMPAT_TOKENS+=("fsr4")
fi
if [[ "${MLFG:-0}" -eq 1 || "${USE_MLFG:-0}" -eq 1 ]]; then
    COMPAT_TOKENS+=("mlfg")
fi
if [[ "${SDL:-0}" -eq 1 || "${USE_SDL:-0}" -eq 1 ]]; then
    COMPAT_TOKENS+=("sdlinput")
fi
if [[ "${NO_NTSYNC:-0}" -eq 1 || "${USE_NO_NTSYNC:-0}" -eq 1 ||
      "${PROTON_NO_NTSYNC:-0}" -eq 1 ]]; then
    COMPAT_TOKENS+=("nontsync")
fi
if [[ "${NO_DECORATION:-0}" -eq 1 || "${USE_NO_DECORATION:-0}" -eq 1 ]]; then
    COMPAT_TOKENS+=("nowmdecoration")
fi
COMPAT_TOKENS+=("localshadercache" "pipewire")
AUTO_PROTON_ADD_CONFIG=$(IFS=','; echo "${COMPAT_TOKENS[*]}")

if [[ "$JSON_MODE" -eq 1 ]]; then
    python3 - "$APPID" "$GAME_NAME" "$GAME_DIR" "$AUTO_NATIVE_LINUX" \
        "$AUTO_CLASS" "$AUTO_PRESET" "$AUTO_NET_OPT" "$AUTO_CEF_FIX" \
        "$AUTO_SHARPEN" "$AUTO_OPTISCALER" "$AUTO_REASON" \
        "$AUTO_HAS_DLSS" "$AUTO_HAS_XESS" "$AUTO_HAS_FSR" "$NTFS_MOUNT" \
        "$AUTO_PROTON_ADD_CONFIG" "$AUTO_IS_VR" "$AUTO_SOURCE" "$AUTO_UPSCALER_INFO" <<'PY'
import json
import sys

(
    appid, game_name, game_dir, native, game_class, preset,
    net_opt, cef_fix, sharpen, optiscaler, reason,
    has_dlss, has_xess, has_fsr, ntfs_mount, proton_add_config, is_vr,
    source, upscaler_info,
) = sys.argv[1:20]

print(json.dumps({
    "app_id": appid or None,
    "game": game_name,
    "source": source,
    "install_dir": game_dir or None,
    "runtime": "native_linux" if native == "1" else "proton",
    "class": game_class,
    "preset": preset,
    "net_qos_hook": net_opt == "1",
    "cef_fix": cef_fix == "1",
    "sharpen_layer": sharpen == "1",
    "optiscaler": optiscaler == "1",
    "rationale": reason,
    "upscaler_info": upscaler_info,
    "has_dlss": has_dlss == "1",
    "has_xess": has_xess == "1",
    "has_fsr": has_fsr == "1",
    "is_vr": is_vr == "1",
    "ntfs_mount": ntfs_mount == "1",
    "proton_add_config": proton_add_config,
}, indent=2))
PY
elif [[ "$INSPECT_MODE" -eq 1 ]]; then
    cat <<EOF
=== Steam Auto-Profiler Inspection ===
AppID        : ${APPID:-N/A}
Game         : $GAME_NAME
Source       : $AUTO_SOURCE
Install Dir  : ${GAME_DIR:-Not found locally}
NTFS Mount   : $([[ "$NTFS_MOUNT" -eq 1 ]] && echo "WARNING: Proton prefix/games on NTFS are unsupported or unsafe" || echo "No")
Runtime      : $([[ "$AUTO_NATIVE_LINUX" -eq 1 ]] && echo "Native Linux" || echo "Proton / Windows")
VR Title     : $AUTO_IS_VR
Class        : $AUTO_CLASS
Preset       : $AUTO_PRESET
Net QoS Hook : $AUTO_NET_OPT
CEF Fix      : $AUTO_CEF_FIX
Sharpen Layer: $AUTO_SHARPEN
OptiScaler   : $AUTO_OPTISCALER (optional plugin)
Upscaler SDK : $AUTO_UPSCALER_INFO
DLSS DLL     : $AUTO_HAS_DLSS
XeSS DLL     : $AUTO_HAS_XESS
FSR DLL      : $AUTO_HAS_FSR
Compat Config: $AUTO_PROTON_ADD_CONFIG
EAC Runtime   : $([[ "$AUTO_CLASS" == "competitive-anticheat" ]] && echo "proton-cachyos-slr / CachyOS EAC v2 recommended; $(command -v eac-status >/dev/null 2>&1 && echo 'eac-status available' || echo 'eac-status unavailable')" || echo "Not detected")
Rationale    : $AUTO_REASON
EOF
else
    printf 'AUTO_CLASS=%q\n' "$AUTO_CLASS"
    printf 'AUTO_PRESET=%q\n' "$AUTO_PRESET"
    printf 'AUTO_OPTISCALER=%q\n' "$AUTO_OPTISCALER"
    printf 'AUTO_SHARPEN=%q\n' "$AUTO_SHARPEN"
    printf 'AUTO_NET_OPT=%q\n' "$AUTO_NET_OPT"
    printf 'AUTO_CEF_FIX=%q\n' "$AUTO_CEF_FIX"
    printf 'AUTO_NATIVE_LINUX=%q\n' "$AUTO_NATIVE_LINUX"
    printf 'AUTO_IS_VR=%q\n' "$AUTO_IS_VR"
    printf 'AUTO_SOURCE=%q\n' "$AUTO_SOURCE"
    printf 'AUTO_UPSCALER_INFO=%q\n' "$AUTO_UPSCALER_INFO"
    printf 'AUTO_HAS_DLSS=%q\n' "$AUTO_HAS_DLSS"
    printf 'AUTO_HAS_XESS=%q\n' "$AUTO_HAS_XESS"
    printf 'AUTO_HAS_FSR=%q\n' "$AUTO_HAS_FSR"
    printf 'NTFS_MOUNT=%q\n' "$NTFS_MOUNT"
    printf 'AUTO_PROTON_ADD_CONFIG=%q\n' "$AUTO_PROTON_ADD_CONFIG"
    printf 'AUTO_REASON=%q\n' "$AUTO_REASON"
fi
