#!/usr/bin/env python3
"""Unified lightweight Qt6 GUI + stdlib curses TUI control center for Steam Auto-Profiler."""

from __future__ import annotations

import argparse
import curses
import json
import os
from pathlib import Path
import queue
import re
import shutil
import signal
import struct
import subprocess
import sys
import threading
import time
from typing import Any
import zlib


SKIP_TITLE_RE = re.compile(
    r"^(Proton\b|Steam Linux Runtime|Steamworks Common Redistributables|"
    r"Wallpaper Engine|Lossless Scaling|SteamVR\b)",
    re.I,
)
IGNORED_APPIDS = {"228980", "250820"}

VENDOR_NAMES = {
    "0x1002": "AMD",
    "0x10de": "NVIDIA",
    "0x8086": "Intel",
}

STACK_PACKAGES = (
    "mesa-git",
    "mesa",
    "proton-cachyos-slr",
    "wivrn-server",
    "xrizer-git",
    "xrizer",
    "mangohud",
)

PROFILE_TOGGLES = (
    ("USE_XWAYLAND", "Use XWayland (disable Wayland)"),
    ("USE_FSR4", "FSR 4 Driver Upgrade"),
    ("USE_MLFG", "Frame Generation (MLFG)"),
    ("USE_SHARPEN", "vkBasalt Sharpening"),
    ("USE_SAFEDX12", "Safe DX12 (disable experimental VKD3D)"),
    ("USE_NET_OPT", "Session Network QoS"),
    ("USE_SDL", "Prefer SDL / Steam Input"),
    ("USE_KEEP_OVERLAY", "Keep Steam Overlay (LD_PRELOAD)"),
    ("USE_OPTISCALER", "OptiScaler Bridge"),
    ("AUTO_HDR_SWITCH", "Auto KDE Plasma 6 HDR Toggle"),
)


def parse_shortcuts_vdf(path: Path | str) -> list[dict[str, str]]:
    """Safely parse Steam binary userdata/*/config/shortcuts.vdf (read-only)."""
    try:
        data = Path(path).read_bytes()
    except OSError:
        return []
    pos = 0
    n = len(data)

    def read_cstr() -> str:
        nonlocal pos
        end = data.find(b"\x00", pos)
        if end == -1:
            pos = n
            return ""
        val = data[pos:end].decode("utf-8", errors="replace")
        pos = end + 1
        return val

    def read_map() -> dict[str, Any]:
        nonlocal pos
        out: dict[str, Any] = {}
        while pos < n:
            t = data[pos]
            pos += 1
            if t == 0x08:
                break
            key = read_cstr()
            if t == 0x00:
                out[key] = read_map()
            elif t == 0x01:
                out[key] = read_cstr()
            elif t == 0x02:
                if pos + 4 > n:
                    break
                out[key] = struct.unpack_from("<I", data, pos)[0]
                pos += 4
            elif t == 0x03:
                pos += 4
            elif t == 0x07:
                pos += 8
            else:
                break
        return out

    root = read_map()
    shortcuts = root.get("shortcuts") or root.get("Shortcuts") or {}
    if not isinstance(shortcuts, dict):
        return []
    entries: list[dict[str, str]] = []
    for entry in shortcuts.values():
        if not isinstance(entry, dict):
            continue
        lower_map = {k.lower(): v for k, v in entry.items()}
        name = str(lower_map.get("appname") or "").strip()
        exe = str(lower_map.get("exe") or "").strip().strip('"')
        start_dir = str(lower_map.get("startdir") or "").strip().strip('"')
        launch_opts = str(lower_map.get("launchoptions") or "").strip()
        raw_id = lower_map.get("appid")
        if isinstance(raw_id, int):
            appid = str(raw_id & 0xFFFFFFFF)
        else:
            appid = str((zlib.crc32((exe + name).encode("utf-8")) | 0x80000000) & 0xFFFFFFFF)
        if not name:
            name = Path(exe).stem if exe else appid
        entries.append({
            "appid": appid,
            "name": name,
            "exe": exe,
            "start_dir": start_dir,
            "launch_options": launch_opts,
            "source": "shortcut",
        })
    return entries


def parse_tc_qdisc_stats(raw_tc: str) -> dict[str, Any]:
    """Parse `tc -s qdisc show` output for LAN (10:) vs WAN (20:/root) CAKE stats."""
    blocks: list[dict[str, Any]] = []
    current: dict[str, Any] | None = None

    for line in raw_tc.splitlines():
        qmatch = re.match(
            r"^\s*qdisc\s+(\S+)\s+(\S+)\s+(?:dev\s+\S+\s+)?(root|parent\s+\S+)(.*)$",
            line,
        )
        if qmatch:
            if current is not None:
                blocks.append(current)
            qdisc_type, handle, attach, rest = qmatch.groups()
            role = "other"
            if handle == "10:" or "parent 1:10" in attach:
                role = "lan"
            elif handle == "20:" or "parent 1:20" in attach:
                role = "wan"
            elif qdisc_type == "cake" and attach == "root":
                role = "wan"
            current = {
                "type": qdisc_type,
                "handle": handle,
                "attach": attach,
                "role": role,
                "params": rest.strip(),
                "sent_bytes": None,
                "sent_pkts": None,
                "dropped": None,
                "av_delay": [],
                "pk_delay": [],
                "sp_delay": [],
            }
            continue

        if current is None:
            continue

        sent_match = re.search(
            r"Sent\s+(\d+)\s+bytes\s+(\d+)\s+pkt\s*\(dropped\s+(\d+)",
            line,
        )
        if sent_match:
            current["sent_bytes"] = int(sent_match.group(1))
            current["sent_pkts"] = int(sent_match.group(2))
            current["dropped"] = int(sent_match.group(3))
            continue

        for key in ("pk_delay", "av_delay", "sp_delay"):
            m = re.match(rf"^\s*{key}\s+(.+)$", line)
            if m:
                current[key] = m.group(1).split()

    if current is not None:
        blocks.append(current)

    lan = next((b for b in blocks if b["role"] == "lan"), None)
    wan = next((b for b in blocks if b["role"] == "wan"), None)
    return {
        "lan": lan,
        "wan": wan,
        "blocks": blocks,
    }


_PACMAN_LOG_CACHE: dict[str, tuple[float, int, list[str]]] = {}
_PACMAN_LOG_CACHE_TTL_SEC = 30.0


def detect_pacman_downgrades(
    log_path: Path | str = "/var/log/pacman.log",
    max_lines: int = 400,
    cache_ttl: float = _PACMAN_LOG_CACHE_TTL_SEC,
) -> list[str]:
    """Scan recent /var/log/pacman.log lines for package or git/AUR revision downgrades (cached 30s)."""
    p = Path(log_path)
    if not p.is_file():
        return []
    try:
        mtime_ns = p.stat().st_mtime_ns
    except OSError:
        return []

    cache_key = f"{p}:{max_lines}"
    now = time.monotonic()
    cached = _PACMAN_LOG_CACHE.get(cache_key)
    if cached is not None and cache_ttl > 0:
        cached_at, cached_mtime, cached_warnings = cached
        if cached_mtime == mtime_ns and (now - cached_at) < cache_ttl:
            return list(cached_warnings)

    try:
        lines = p.read_text(encoding="utf-8", errors="ignore").splitlines()[-max_lines:]
    except OSError:
        return []

    warnings: list[str] = []
    downgrade_re = re.compile(r"^\[([^\]]+)\]\s+\[ALPM\]\s+downgraded\s+(\S+)\s+\(([^)]+)\)")
    upgrade_re = re.compile(r"^\[([^\]]+)\]\s+\[ALPM\]\s+upgraded\s+(\S+)\s+\((\S+)\s+->\s+(\S+)\)")
    rev_re = re.compile(r"(?:_devel\.|\.r)(\d+)\.")

    for line in lines:
        dm = downgrade_re.match(line)
        if dm:
            ts, pkg, transition = dm.groups()
            warnings.append(f"[WARN] Pacman downgraded {pkg} ({transition}) on {ts}")
            continue
        um = upgrade_re.match(line)
        if um:
            ts, pkg, old_ver, new_ver = um.groups()
            if pkg.endswith("-git") or pkg in STACK_PACKAGES:
                old_rev = rev_re.search(old_ver)
                new_rev = rev_re.search(new_ver)
                if old_rev and new_rev and int(new_rev.group(1)) < int(old_rev.group(1)):
                    warnings.append(
                        f"[WARN] Git/AUR revision regression for {pkg}: {old_ver} -> {new_ver} on {ts}"
                    )
    result = warnings[-10:]
    _PACMAN_LOG_CACHE[cache_key] = (now, mtime_ns, result)
    return list(result)


def format_bytes(num: int | None) -> str:
    if num is None:
        return "n/a"
    value = float(num)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024.0 or unit == "TiB":
            return f"{value:.1f} {unit}"
        value /= 1024.0
    return f"{num} B"


def validate_profile(profile: dict[str, str], game_class: str = "standard") -> tuple[dict[str, str], list[str]]:
    """Apply Steam Auto-Profiler mutual-exclusion guards and return (normalized, warnings)."""
    norm = dict(profile)
    warnings: list[str] = []

    for key, _ in PROFILE_TOGGLES:
        default = "1" if key == "USE_FSR4" else "0"
        val = str(norm.get(key, default)).strip()
        norm[key] = "1" if val in ("1", "true", "TRUE", "yes") else "0"

    vrr_raw = str(norm.get("VRR_CAP", "")).strip()
    if vrr_raw and not vrr_raw.isdigit():
        warnings.append(f"Invalid VRR_CAP '{vrr_raw}'; cleared to Auto.")
        vrr_raw = ""
    norm["VRR_CAP"] = vrr_raw

    if game_class == "competitive-anticheat":
        if norm["USE_MLFG"] == "1":
            norm["USE_MLFG"] = "0"
            warnings.append("MLFG disabled automatically for competitive-anticheat titles.")
        if norm["USE_OPTISCALER"] == "1":
            norm["USE_OPTISCALER"] = "0"
            warnings.append("OptiScaler disabled automatically for competitive-anticheat titles.")
        if norm["USE_SHARPEN"] == "1":
            norm["USE_SHARPEN"] = "0"
            warnings.append("vkBasalt sharpening disabled automatically for competitive-anticheat titles.")

    if norm["USE_SHARPEN"] == "1" and (norm["USE_FSR4"] == "1" or norm["USE_OPTISCALER"] == "1"):
        norm["USE_SHARPEN"] = "0"
        warnings.append("vkBasalt disabled: mutually exclusive with FSR 4 / OptiScaler (prevents HDR10 clipping).")

    if norm["USE_MLFG"] == "1" and norm["VRR_CAP"] and int(norm["VRR_CAP"]) > 0:
        norm["VRR_CAP"] = ""
        warnings.append("VRR_CAP cleared: MLFG disables frame caps and Anti-Lag to avoid frame-pacing stutter.")

    return norm, warnings


class ProfilerBackend:
    """Shared backend used by both the Qt6 GUI and curses TUI."""

    def __init__(self, home: Path | None = None, cancel_event: threading.Event | None = None):
        self.home = home or Path.home()
        self.script_dir = Path(__file__).resolve().parent
        xdg_cfg = os.environ.get("XDG_CONFIG_HOME")
        xdg_state = os.environ.get("XDG_STATE_HOME")
        xdg_cache = os.environ.get("XDG_CACHE_HOME")
        self.config_dir = (Path(xdg_cfg) if xdg_cfg else self.home / ".config") / "steam-auto-profiler"
        self.profile_dir = self.config_dir / "profiles"
        self.benchmark_dir = self.config_dir / "benchmarks"
        self.state_dir = (Path(xdg_state) if xdg_state else self.home / ".local/state") / "steam-auto-profiler"
        self.cache_dir = Path(xdg_cache) if xdg_cache else self.home / ".cache"
        self.cancel_event = cancel_event or threading.Event()
        self._proc_lock = threading.Lock()
        self._active_procs: set[subprocess.Popen[str]] = set()

    def is_cancelled(self) -> bool:
        return self.cancel_event.is_set()

    def reset_cancel(self) -> None:
        self.cancel_event.clear()

    @staticmethod
    def _terminate_proc(proc: subprocess.Popen[str], force: bool = False) -> None:
        if proc.poll() is not None:
            return
        sig = signal.SIGKILL if force else signal.SIGTERM
        try:
            os.killpg(proc.pid, sig)
        except (ProcessLookupError, PermissionError, OSError):
            try:
                if force:
                    proc.kill()
                else:
                    proc.terminate()
            except OSError:
                pass

    def terminate_active_subprocesses(self, grace_sec: float = 0.05) -> None:
        with self._proc_lock:
            procs = list(self._active_procs)
        if not procs:
            return
        for proc in procs:
            self._terminate_proc(proc, force=False)
        deadline = time.monotonic() + max(0.0, grace_sec)
        for proc in procs:
            remaining = deadline - time.monotonic()
            if proc.poll() is None and remaining > 0:
                try:
                    proc.wait(timeout=remaining)
                except subprocess.TimeoutExpired:
                    pass
        for proc in procs:
            if proc.poll() is None:
                self._terminate_proc(proc, force=True)

    def cancel(self, grace_sec: float = 0.05) -> None:
        self.cancel_event.set()
        self.terminate_active_subprocesses(grace_sec=grace_sec)

    def find_tool(self, name: str) -> str | None:
        for candidate in (
            self.script_dir / name,
            self.home / ".local/bin" / name,
            Path("/usr/local/bin") / name,
        ):
            if candidate.is_file() and os.access(candidate, os.X_OK):
                return str(candidate)
        return shutil.which(name)

    def _run_proc(
        self,
        cmd: list[str],
        env: dict[str, str] | None = None,
        timeout: int = 15,
    ) -> tuple[int, str, str, str | None]:
        if self.is_cancelled():
            return 1, "", "", "Cancelled."
        proc: subprocess.Popen[str] | None = None
        try:
            proc = subprocess.Popen(
                cmd,
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                start_new_session=True,
            )
            cancelled_before_track = False
            with self._proc_lock:
                if self.is_cancelled():
                    cancelled_before_track = True
                else:
                    self._active_procs.add(proc)
            if cancelled_before_track:
                self._terminate_proc(proc, force=True)
                try:
                    proc.communicate(timeout=0.1)
                except Exception:
                    pass
                return 1, "", "", "Cancelled."
            stdout, stderr = proc.communicate(timeout=timeout)
            if self.is_cancelled():
                return 1, "", "", "Cancelled."
            return proc.returncode, stdout or "", stderr or "", None
        except subprocess.TimeoutExpired as exc:
            if proc is not None:
                self._terminate_proc(proc, force=True)
                try:
                    proc.communicate(timeout=0.2)
                except Exception:
                    pass
            return 1, "", "", f"Error running {' '.join(cmd)}: {exc}"
        except OSError as exc:
            return 1, "", "", f"Error running {' '.join(cmd)}: {exc}"
        finally:
            if proc is not None:
                with self._proc_lock:
                    self._active_procs.discard(proc)
                for pipe in (proc.stdout, proc.stderr):
                    if pipe is not None:
                        try:
                            pipe.close()
                        except OSError:
                            pass

    def _run_cmd(self, cmd: list[str], env: dict[str, str] | None = None, timeout: int = 15) -> tuple[int, str]:
        rc, stdout, stderr, err = self._run_proc(cmd, env=env, timeout=timeout)
        if err is not None:
            return rc, err
        out = stdout
        if stderr:
            out = f"{out}\n{stderr}" if out else stderr
        return rc, out.strip()

    def discover_steam_libraries(self) -> list[Path]:
        candidates = [
            self.home / ".local/share/Steam",
            self.home / ".steam/steam",
            self.home / ".var/app/com.valvesoftware.Steam/.local/share/Steam",
        ]
        roots: list[Path] = []
        seen: set[Path] = set()
        for candidate in candidates:
            if not (candidate / "steamapps").is_dir():
                continue
            resolved = candidate.resolve()
            if resolved in seen:
                continue
            seen.add(resolved)
            roots.append(candidate)
            vdf = candidate / "steamapps/libraryfolders.vdf"
            if vdf.exists():
                text = vdf.read_text(encoding="utf-8", errors="ignore")
                for match in re.finditer(r'"path"\s+"([^"]+)"', text):
                    lib = Path(match.group(1))
                    if (lib / "steamapps").is_dir():
                        lib_res = lib.resolve()
                        if lib_res not in seen:
                            seen.add(lib_res)
                            roots.append(lib)
        return roots

    def _read_synced_map(self, roots: list[Path]) -> dict[str, str]:
        synced: dict[str, str] = {}
        app_block_re = re.compile(r'"(\d+)"\s*\{[^{}]*?"LaunchOptions"\s+"([^"]*)"', re.S | re.I)
        for root in roots:
            userdata = root / "userdata"
            if not userdata.is_dir():
                continue
            for cfg in userdata.glob("*/config/localconfig.vdf"):
                raw = cfg.read_text(encoding="utf-8", errors="ignore")
                for match in app_block_re.finditer(raw):
                    appid, opts = match.group(1), match.group(2)
                    if re.search(r"(?:^|\s)(?:\S*/)?vr-run(?:\s|$)", opts):
                        synced[appid] = "VR"
                    elif "steam-auto-run" in opts:
                        synced[appid] = "Yes"
        return synced

    def discover_shortcuts(self, roots: list[Path] | None = None) -> dict[str, dict[str, str]]:
        libs = roots if roots is not None else self.discover_steam_libraries()
        found: dict[str, dict[str, str]] = {}
        for root in libs:
            userdata = root / "userdata"
            if not userdata.is_dir():
                continue
            for vdf in userdata.glob("*/config/shortcuts.vdf"):
                for item in parse_shortcuts_vdf(vdf):
                    found[item["appid"]] = item
        return found

    def discover_games(self) -> list[dict[str, Any]]:
        if self.is_cancelled():
            return []
        roots = self.discover_steam_libraries()
        if self.is_cancelled():
            return []
        games_map: dict[str, tuple[str, str, str]] = {}
        for lib in roots:
            if self.is_cancelled():
                return []
            steamapps = lib / "steamapps"
            if not steamapps.is_dir():
                continue
            for acf in steamapps.glob("appmanifest_*.acf"):
                if self.is_cancelled():
                    return []
                text = acf.read_text(encoding="utf-8", errors="ignore")
                appid_m = re.search(r'"appid"\s+"(\d+)"', text)
                name_m = re.search(r'"name"\s+"([^"]+)"', text)
                if not appid_m:
                    continue
                appid = appid_m.group(1)
                name = name_m.group(1) if name_m else appid
                if appid in IGNORED_APPIDS or SKIP_TITLE_RE.search(name):
                    continue
                games_map[appid] = (name, "steam", "")

        if self.is_cancelled():
            return []
        for sc_id, sc in self.discover_shortcuts(roots).items():
            if self.is_cancelled():
                return []
            if sc_id not in games_map:
                games_map[sc_id] = (sc["name"], "shortcut", sc["launch_options"])

        if self.is_cancelled():
            return []
        synced_map = self._read_synced_map(roots)
        detect_bin = self.find_tool("steam-auto-detect")

        def classify(item: tuple[str, tuple[str, str, str]]) -> dict[str, Any] | None:
            if self.is_cancelled():
                return None
            appid, (name, source, sc_opts) = item
            if source == "shortcut":
                if re.search(r"(?:^|\s)(?:\S*/)?vr-run(?:\s|$)", sc_opts):
                    synced_val = "VR"
                elif "steam-auto-run" in sc_opts:
                    synced_val = "Yes"
                else:
                    synced_val = "Custom" if sc_opts else "No"
            else:
                synced_val = synced_map.get(appid, "No")

            info: dict[str, Any] = {
                "appid": appid,
                "name": name,
                "source": source,
                "launch_options": sc_opts,
                "class": "vr" if synced_val == "VR" else "standard",
                "is_vr": synced_val == "VR",
                "synced": synced_val,
                "has_profile": (self.profile_dir / f"{appid}.env").is_file(),
                "rationale": "",
                "upscaler_info": "None detected",
                "compat_tokens": "",
            }
            if detect_bin and not self.is_cancelled():
                env = os.environ.copy()
                env["HOME"] = str(self.home)
                rc, out = self._run_cmd([detect_bin, "--json", appid], env=env, timeout=10)
                if self.is_cancelled():
                    return None
                if rc == 0 and out:
                    try:
                        data = json.loads(out)
                        info["class"] = data.get("class", info["class"])
                        info["is_vr"] = bool(data.get("is_vr", info["is_vr"]))
                        info["rationale"] = data.get("rationale", "")
                        info["upscaler_info"] = data.get("upscaler_info", "None detected")
                        info["compat_tokens"] = data.get("proton_add_config", "")
                    except json.JSONDecodeError:
                        pass
            return info

        items = sorted(games_map.items(), key=lambda kv: kv[1][0].lower())
        if not items or self.is_cancelled():
            return []

        worker_count = min(4, len(items))
        work_queue: queue.Queue[tuple[int, tuple[str, tuple[str, str, str]]]] = queue.Queue()
        for idx, item in enumerate(items):
            work_queue.put((idx, item))

        results: list[dict[str, Any] | None] = [None] * len(items)

        def worker_loop() -> None:
            while not self.is_cancelled():
                try:
                    idx, item = work_queue.get_nowait()
                except queue.Empty:
                    break
                if self.is_cancelled():
                    break
                results[idx] = classify(item)

        threads: list[threading.Thread] = []
        for i in range(worker_count):
            t = threading.Thread(
                target=worker_loop,
                name=f"steam-auto-ui-scan-{i}",
                daemon=True,
            )
            t.start()
            threads.append(t)

        for t in threads:
            while t.is_alive():
                if self.is_cancelled():
                    break
                t.join(timeout=0.05)
            if self.is_cancelled():
                break

        if self.is_cancelled():
            deadline = time.monotonic() + 0.15
            for t in threads:
                remaining = deadline - time.monotonic()
                if t.is_alive() and remaining > 0:
                    t.join(timeout=remaining)
            return []

        return [r for r in results if r is not None]

    def load_profile(self, appid: str) -> dict[str, str]:
        profile: dict[str, str] = {key: ("1" if key == "USE_FSR4" else "0") for key, _ in PROFILE_TOGGLES}
        profile["VRR_CAP"] = ""
        path = self.profile_dir / f"{appid}.env"
        if not path.is_file():
            return profile
        for raw in path.read_text(encoding="utf-8", errors="ignore").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip().strip("'\"")
            if key == "USE_RCAS":
                key = "USE_SHARPEN"
            profile[key] = value
        return profile

    def save_profile(self, appid: str, profile: dict[str, str], game_class: str = "standard") -> tuple[Path, list[str]]:
        norm, warnings = validate_profile(profile, game_class)
        self.profile_dir.mkdir(parents=True, exist_ok=True)
        path = self.profile_dir / f"{appid}.env"
        lines = [f"{key}={norm[key]}" for key, _ in PROFILE_TOGGLES]
        lines.append(f"VRR_CAP={norm.get('VRR_CAP', '')}")
        managed = {key for key, _ in PROFILE_TOGGLES} | {"VRR_CAP", "PARTIAL_PROFILE"}
        for key, value in sorted(norm.items()):
            if key not in managed and re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", key):
                lines.append(f"{key}={value}")
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")
        return path, warnings

    def reset_profile(self, appid: str) -> str:
        path = self.profile_dir / f"{appid}.env"
        if path.exists():
            path.unlink()
            return f"Removed profile {path}"
        return f"No saved profile for AppID {appid}"

    def apply_safe_mode(self, appid: str) -> tuple[Path, list[str]]:
        profile = self.load_profile(appid)
        profile["USE_XWAYLAND"] = "1"
        profile["USE_SAFEDX12"] = "1"
        return self.save_profile(appid, profile)

    def dry_run(self, appid: str, is_vr: bool = False) -> str:
        env = os.environ.copy()
        env["NO_GUI"] = "1"
        if is_vr:
            vr_bin = self.find_tool("vr-run")
            if not vr_bin:
                return "vr-run not found."
            _, out = self._run_cmd([vr_bin, "--dry-run"], env=env)
            return out
        run_bin = self.find_tool("steam-auto-run")
        if not run_bin:
            return "steam-auto-run not found."
        _, out = self._run_cmd([run_bin, "--dry-run", appid], env=env)
        return out

    def list_benchmarks(self, appid: str | None = None) -> list[dict[str, Any]]:
        if not self.benchmark_dir.is_dir():
            return []
        files = [self.benchmark_dir / f"{appid}.json"] if appid else sorted(self.benchmark_dir.glob("*.json"))
        runs: list[dict[str, Any]] = []
        for fpath in files:
            if not fpath.is_file():
                continue
            try:
                data = json.loads(fpath.read_text(encoding="utf-8"))
                if isinstance(data, list):
                    for rec in data:
                        if isinstance(rec, dict):
                            runs.append(rec)
            except (OSError, json.JSONDecodeError):
                continue
        runs.sort(key=lambda r: str(r.get("timestamp", "")), reverse=True)
        return runs

    def format_benchmarks_text(self, runs: list[dict[str, Any]]) -> str:
        if not runs:
            return "No benchmark runs recorded yet. Launch a game with: BENCH=1 steam-auto-run %command%"
        header = (
            f"{'Timestamp':<20} {'AppID':<10} {'Avg FPS':>8} {'1% Low':>8} {'P99(ms)':>8} "
            f"{'FSR4':>5} {'MLFG':>5} {'XWay':>5} {'Safe12':>6} {'VRR':>5}"
        )
        lines = [header, "-" * len(header)]
        for r in runs:
            ts = str(r.get("timestamp", ""))[:19].replace("T", " ")
            lines.append(
                f"{ts:<20} {str(r.get('appid', '')):<10} "
                f"{float(r.get('avg_fps', 0)):>8.1f} {float(r.get('low_1pct_fps', 0)):>8.1f} "
                f"{float(r.get('p99_frametime_ms', 0)):>8.2f} "
                f"{'on' if r.get('fsr4') else 'off':>5} "
                f"{'on' if r.get('mlfg') else 'off':>5} "
                f"{'on' if r.get('xwayland') else 'off':>5} "
                f"{'on' if r.get('safedx12') else 'off':>6} "
                f"{str(r.get('vrr_cap', 0)):>5}"
            )
        return "\n".join(lines)

    def collect_stack_versions(self) -> list[tuple[str, str]]:
        if self.is_cancelled():
            return []
        pacman = shutil.which("pacman")
        if not pacman:
            return []
        _, stdout, _, err = self._run_proc([pacman, "-Q", *STACK_PACKAGES], timeout=5)
        if err is not None or self.is_cancelled():
            return []
        found: list[tuple[str, str]] = []
        seen: set[str] = set()
        for line in stdout.splitlines():
            parts = line.strip().split(None, 1)
            if len(parts) == 2 and parts[0] not in seen:
                seen.add(parts[0])
                found.append((parts[0], parts[1]))
        return found

    def measure_shader_cache(self, cache_root: Path | None = None) -> dict[str, Any]:
        root = cache_root or self.cache_dir
        total_bytes = 0
        file_count = 0
        dirs: list[str] = []
        if root.is_dir() and not self.is_cancelled():
            for pattern in ("mesa_shader_cache*", "radv_builtin_shaders*"):
                if self.is_cancelled():
                    break
                for entry in sorted(root.glob(pattern)):
                    if self.is_cancelled():
                        break
                    if entry.is_dir():
                        dirs.append(entry.name)
                        for dirpath, _, filenames in os.walk(entry):
                            if self.is_cancelled():
                                break
                            for fn in filenames:
                                try:
                                    total_bytes += os.path.getsize(os.path.join(dirpath, fn))
                                    file_count += 1
                                except OSError:
                                    pass
                    elif entry.is_file():
                        dirs.append(entry.name)
                        try:
                            total_bytes += entry.stat().st_size
                            file_count += 1
                        except OSError:
                            pass
        return {
            "total_bytes": total_bytes,
            "file_count": file_count,
            "dirs": dirs,
        }

    def read_gpu_telemetry(self, drm_dir: Path | None = None) -> list[dict[str, Any]]:
        drm = drm_dir or Path("/sys/class/drm")
        gpus: list[dict[str, Any]] = []
        if not drm.is_dir():
            return gpus
        for card in sorted(drm.glob("card[0-9]*")):
            dev = card / "device"
            if not (dev / "vendor").is_file():
                continue
            vendor_id = (dev / "vendor").read_text(encoding="utf-8", errors="ignore").strip().lower()
            device_id = (dev / "device").read_text(encoding="utf-8", errors="ignore").strip().lower() if (dev / "device").is_file() else ""
            vram_used = None
            vram_total = None
            busy = None
            temp_c = None
            if (dev / "mem_info_vram_used").is_file():
                try:
                    vram_used = int((dev / "mem_info_vram_used").read_text().strip())
                except ValueError:
                    pass
            if (dev / "mem_info_vram_total").is_file():
                try:
                    vram_total = int((dev / "mem_info_vram_total").read_text().strip())
                except ValueError:
                    pass
            if (dev / "gpu_busy_percent").is_file():
                try:
                    busy = int((dev / "gpu_busy_percent").read_text().strip())
                except ValueError:
                    pass
            for hw in sorted((dev / "hwmon").glob("hwmon*/temp1_input")) if (dev / "hwmon").is_dir() else []:
                try:
                    temp_c = round(int(hw.read_text().strip()) / 1000.0, 1)
                    break
                except ValueError:
                    pass
            gpus.append({
                "card": card.name,
                "vendor": VENDOR_NAMES.get(vendor_id, vendor_id),
                "pci_id": f"{vendor_id.removeprefix('0x')}:{device_id.removeprefix('0x')}",
                "vram_used": vram_used,
                "vram_total": vram_total,
                "busy_percent": busy,
                "temp_c": temp_c,
            })
        return gpus

    def collect_telemetry(self) -> dict[str, Any]:
        empty = {
            "doctor": "",
            "scheduler": "unavailable",
            "gpus": [],
            "stack_versions": [],
            "shader_cache": {"total_bytes": 0, "file_count": 0, "dirs": []},
            "pacman_downgrades": [],
            "iface": "unknown",
            "tc_raw": "No qdisc telemetry available.",
            "tc_parsed": {"lan": None, "wan": None, "blocks": []},
            "vr_mode": "",
        }
        if self.is_cancelled():
            return empty

        run_bin = self.find_tool("steam-auto-run")
        doctor_out = self._run_cmd([run_bin, "--doctor"])[1] if run_bin else "steam-auto-run not found."
        if self.is_cancelled():
            return empty

        scx_out = "unavailable"
        scxctl = self.find_tool("scxctl")
        if scxctl:
            rc, out = self._run_cmd([scxctl, "get"])
            if rc == 0 and out:
                scx_out = out
        if self.is_cancelled():
            return empty
        if scx_out == "unavailable":
            state_p = Path("/sys/kernel/sched_ext/state")
            ops_p = Path("/sys/kernel/sched_ext/root/ops")
            if state_p.is_file():
                st = state_p.read_text(encoding="utf-8", errors="ignore").strip()
                ops = ops_p.read_text(encoding="utf-8", errors="ignore").strip() if ops_p.is_file() else "none"
                scx_out = f"{st} ({ops})"

        iface = ""
        ip_bin = self.find_tool("ip")
        if ip_bin:
            rc, out = self._run_cmd([ip_bin, "-o", "-4", "route", "show", "to", "default"])
            if rc == 0 and out:
                parts = out.splitlines()[0].split()
                if len(parts) >= 5:
                    iface = parts[4]
        if self.is_cancelled():
            return empty

        raw_tc = ""
        tc_bin = self.find_tool("tc")
        if iface and tc_bin:
            _, raw_tc = self._run_cmd([tc_bin, "-s", "qdisc", "show", "dev", iface])
        if self.is_cancelled():
            return empty
        tc_parsed = parse_tc_qdisc_stats(raw_tc)

        vr_mode_bin = self.find_tool("vr-mode")
        vr_mode_out = self._run_cmd([vr_mode_bin, "status"])[1] if vr_mode_bin else "vr-mode not installed"
        if self.is_cancelled():
            return empty

        return {
            "doctor": doctor_out,
            "scheduler": scx_out,
            "gpus": self.read_gpu_telemetry(),
            "stack_versions": self.collect_stack_versions(),
            "shader_cache": self.measure_shader_cache(),
            "pacman_downgrades": detect_pacman_downgrades() if not self.is_cancelled() else [],
            "iface": iface or "unknown",
            "tc_raw": raw_tc or "No qdisc telemetry available.",
            "tc_parsed": tc_parsed,
            "vr_mode": vr_mode_out,
        }

    def format_telemetry_text(self, telemetry: dict[str, Any]) -> str:
        lines = ["=== System & Network Live Telemetry ==="]
        lines.append(f"Scheduler (sched-ext): {telemetry['scheduler']}")

        lines.append("")
        lines.append("--- Graphics / VR Stack & Shader Cache Watchdog ---")
        stack = telemetry.get("stack_versions", [])
        if stack:
            for pkg, ver in stack:
                lines.append(f"  {pkg:<22} {ver}")
        else:
            lines.append("  Package version probe unavailable (non-pacman system or packages not installed).")
        sc = telemetry.get("shader_cache", {})
        dirs_label = ", ".join(sc.get("dirs", [])) or "none"
        lines.append(
            f"  Shader cache usage     {format_bytes(sc.get('total_bytes', 0))} "
            f"({sc.get('file_count', 0)} files in {dirs_label})"
        )
        downgrades = telemetry.get("pacman_downgrades", [])
        if downgrades:
            for w in downgrades:
                lines.append(f"  {w}")
        else:
            lines.append("  [OK] No recent git/AUR package downgrades detected in /var/log/pacman.log")

        lines.append("")
        lines.append("--- GPU Telemetry ---")
        if telemetry["gpus"]:
            for gpu in telemetry["gpus"]:
                vram = (
                    f"{format_bytes(gpu['vram_used'])} / {format_bytes(gpu['vram_total'])}"
                    if gpu["vram_total"] is not None
                    else "shared/unknown"
                )
                busy = f"{gpu['busy_percent']}%" if gpu["busy_percent"] is not None else "n/a"
                temp = f"{gpu['temp_c']} C" if gpu["temp_c"] is not None else "n/a"
                lines.append(
                    f"  {gpu['card']} ({gpu['vendor']} {gpu['pci_id']}): "
                    f"VRAM {vram} | Util {busy} | Temp {temp}"
                )
        else:
            lines.append("  No DRM GPU sysfs telemetry available.")

        lines.append("")
        lines.append(f"--- Network QoS ({telemetry['iface']}) ---")
        parsed = telemetry["tc_parsed"]
        for label, key in (("LAN (cake/qdisc 10:)", "lan"), ("WAN (cake 20:/root)", "wan")):
            blk = parsed.get(key)
            if blk:
                av = " ".join(blk["av_delay"]) if blk["av_delay"] else "n/a"
                lines.append(
                    f"  {label}: {blk['type']} {blk['handle']} | "
                    f"Sent {format_bytes(blk['sent_bytes'])} ({blk['sent_pkts']} pkt, drops {blk['dropped']}) | "
                    f"av_delay: {av}"
                )
            else:
                lines.append(f"  {label}: not detected")

        lines.append("")
        lines.append("--- VR Mode ---")
        lines.append(telemetry["vr_mode"])
        lines.append("")
        lines.append("--- System Doctor ---")
        lines.append(telemetry["doctor"])
        return "\n".join(lines)

    def is_steam_running(self) -> bool:
        pgrep = shutil.which("pgrep")
        if not pgrep:
            return False
        rc, _ = self._run_cmd([pgrep, "-x", "steam"], timeout=5)
        return rc == 0

    def run_sync(self, mode: str) -> tuple[int, str]:
        sync_bin = self.find_tool("steam-auto-sync")
        if not sync_bin:
            return 1, "steam-auto-sync not found."
        mapping = {
            "report": ["--report"],
            "sanitize_dry": ["--sanitize", "--dry-run"],
            "sanitize": ["--sanitize"],
            "migrate": ["--migrate-cachy-run"],
        }
        args = mapping.get(mode)
        if args is None:
            return 2, f"Unknown sync mode: {mode}"
        return self._run_cmd([sync_bin, *args], timeout=60)

    def list_logs(self) -> list[Path]:
        if not self.state_dir.is_dir():
            return []
        return sorted(self.state_dir.glob("last-*.log"), key=lambda p: p.stat().st_mtime, reverse=True)

    def read_log(self, path: Path) -> dict[str, Any]:
        text = path.read_text(encoding="utf-8", errors="ignore") if path.is_file() else ""
        meta: dict[str, str] = {}
        for line in text.splitlines():
            if "=" in line and not line.startswith(" "):
                k, v = line.split("=", 1)
                if k in ("appid", "class", "exit_code", "duration_sec", "crash_hint", "crash_recovery"):
                    meta[k] = v.strip()
        return {
            "path": str(path),
            "name": path.name,
            "text": text,
            "appid": meta.get("appid", ""),
            "exit_code": meta.get("exit_code", ""),
            "duration_sec": meta.get("duration_sec", ""),
            "crash_hint": meta.get("crash_hint", ""),
            "crash_recovery": meta.get("crash_recovery", ""),
        }


def detect_qt_binding() -> tuple[str | None, Any]:
    for name in ("PySide6", "PyQt6"):
        try:
            qtwidgets = __import__(f"{name}.QtWidgets", fromlist=["QtWidgets"])
            qtcore = __import__(f"{name}.QtCore", fromlist=["QtCore"])
            return name, (qtwidgets, qtcore)
        except Exception:
            continue
    return None, None


def run_self_check(backend: ProfilerBackend) -> int:
    """Headless CI self-test verifying backend, validators, parsers, and UI bindings."""
    sample_tc = (
        "qdisc htb 1: root refcnt 2 r2q 10 default 0x20\n"
        " Sent 1048576 bytes 800 pkt (dropped 0, overlimits 0 requeues 0)\n"
        "qdisc cake 10: parent 1:10 bandwidth unlimited diffserv4\n"
        " Sent 524288 bytes 400 pkt (dropped 0, overlimits 0 requeues 0)\n"
        "  av_delay        12us        8us        4us        2us\n"
        "qdisc cake 20: parent 1:20 bandwidth 450Mbit diffserv4\n"
        " Sent 524288 bytes 400 pkt (dropped 1, overlimits 0 requeues 0)\n"
        "  av_delay       850us      240us      110us       45us\n"
    )
    parsed_tc = parse_tc_qdisc_stats(sample_tc)
    assert parsed_tc["lan"] is not None and parsed_tc["lan"]["handle"] == "10:"
    assert parsed_tc["wan"] is not None and parsed_tc["wan"]["handle"] == "20:"
    assert parsed_tc["wan"]["av_delay"][0] == "850us"

    norm, warns = validate_profile(
        {"USE_FSR4": "1", "USE_SHARPEN": "1", "USE_MLFG": "1", "VRR_CAP": "144", "AUTO_HDR_SWITCH": "1"},
        "standard",
    )
    assert norm["USE_SHARPEN"] == "0"
    assert norm["VRR_CAP"] == ""
    assert norm["AUTO_HDR_SWITCH"] == "1"
    assert len(warns) >= 2

    qt_name, _ = detect_qt_binding()
    tools = {
        name: backend.find_tool(name)
        for name in ("steam-auto-detect", "steam-auto-run", "steam-auto-sync", "vr-run", "steam-net-boost", "vr-mode")
    }
    report = {
        "status": "ok",
        "qt_binding": qt_name or "unavailable",
        "curses_available": True,
        "tools": tools,
        "tc_parser_verified": True,
        "mutual_exclusion_verified": True,
        "shortcuts_parser_available": True,
        "stack_packages": dict(backend.collect_stack_versions()),
        "shader_cache_bytes": backend.measure_shader_cache()["total_bytes"],
        "gpus_detected": len(backend.read_gpu_telemetry()),
        "benchmarks_found": len(backend.list_benchmarks()),
        "logs_found": len(backend.list_logs()),
    }
    print(json.dumps(report, indent=2))
    return 0


def run_qt_gui(backend: ProfilerBackend) -> int:
    binding, mods = detect_qt_binding()
    if binding is None or mods is None:
        print("Error: Neither PySide6 nor PyQt6 is installed. Use --tui for terminal mode.", file=sys.stderr)
        return 1
    QtWidgets, QtCore = mods
    qt_signal = getattr(QtCore, "Signal", None) or getattr(QtCore, "pyqtSignal")

    class WorkerBridge(QtCore.QObject):
        games_ready = qt_signal(list)
        telemetry_ready = qt_signal(str)

    class MainWindow(QtWidgets.QMainWindow):
        def __init__(self, on_close_cb: Any):
            super().__init__()
            self._on_close_cb = on_close_cb

        def closeEvent(self, event: Any) -> None:
            self._on_close_cb()
            event.accept()
            super().closeEvent(event)

    app = QtWidgets.QApplication.instance()
    if app is None:
        app = QtWidgets.QApplication(sys.argv)
    app.setApplicationName("Steam Auto-Profiler")

    shutting_down = False
    sigint_received = False

    win = MainWindow(lambda: shutdown_ui())
    win.setWindowTitle(f"Steam Auto-Profiler Control Center ({binding})")
    win.resize(1180, 760)
    bridge = WorkerBridge(win)

    tabs = QtWidgets.QTabWidget()
    win.setCentralWidget(tabs)
    status_bar = win.statusBar()
    status_bar.showMessage("Ready")

    # --- Tab 1: Games & Profiles ---
    tab_games = QtWidgets.QWidget()
    games_layout = QtWidgets.QVBoxLayout(tab_games)

    top_bar = QtWidgets.QHBoxLayout()
    search_edit = QtWidgets.QLineEdit()
    search_edit.setPlaceholderText("Filter by AppID, game name, source (steam/shortcut), or class...")
    refresh_games_btn = QtWidgets.QPushButton("Refresh Library")
    top_bar.addWidget(search_edit)
    top_bar.addWidget(refresh_games_btn)
    games_layout.addLayout(top_bar)

    splitter = QtWidgets.QSplitter(QtCore.Qt.Orientation.Horizontal)
    games_layout.addWidget(splitter, 1)

    table = QtWidgets.QTableWidget(0, 6)
    table.setHorizontalHeaderLabels(["AppID", "Game Name", "Source", "Auto Class", "Synced", "Profile"])
    table.setSelectionBehavior(QtWidgets.QAbstractItemView.SelectionBehavior.SelectRows)
    table.setSelectionMode(QtWidgets.QAbstractItemView.SelectionMode.SingleSelection)
    table.setEditTriggers(QtWidgets.QAbstractItemView.EditTrigger.NoEditTriggers)
    table.horizontalHeader().setStretchLastSection(True)
    splitter.addWidget(table)

    editor_widget = QtWidgets.QWidget()
    editor_layout = QtWidgets.QVBoxLayout(editor_widget)
    selected_label = QtWidgets.QLabel("Select a game or Non-Steam shortcut to edit its profile")
    selected_label.setWordWrap(True)
    editor_layout.addWidget(selected_label)

    upscaler_badge = QtWidgets.QLabel("")
    upscaler_badge.setWordWrap(True)
    editor_layout.addWidget(upscaler_badge)

    warning_label = QtWidgets.QLabel("")
    warning_label.setWordWrap(True)
    warning_label.setStyleSheet("color: #d97706; font-weight: bold;")
    editor_layout.addWidget(warning_label)

    checkboxes: dict[str, Any] = {}
    for key, label in PROFILE_TOGGLES:
        cb = QtWidgets.QCheckBox(label)
        checkboxes[key] = cb
        editor_layout.addWidget(cb)

    vrr_row = QtWidgets.QHBoxLayout()
    vrr_row.addWidget(QtWidgets.QLabel("VRR_CAP (empty=Auto, 0=Off):"))
    vrr_edit = QtWidgets.QLineEdit()
    vrr_edit.setPlaceholderText("Auto")
    vrr_row.addWidget(vrr_edit)
    editor_layout.addLayout(vrr_row)

    btn_row = QtWidgets.QHBoxLayout()
    save_btn = QtWidgets.QPushButton("Save Profile")
    dry_run_btn = QtWidgets.QPushButton("Dry-Run Preview")
    bench_jump_btn = QtWidgets.QPushButton("Benchmarks")
    reset_btn = QtWidgets.QPushButton("Reset Profile")
    for b in (save_btn, dry_run_btn, bench_jump_btn, reset_btn):
        btn_row.addWidget(b)
    editor_layout.addLayout(btn_row)

    dry_run_box = QtWidgets.QPlainTextEdit()
    dry_run_box.setReadOnly(True)
    dry_run_box.setPlaceholderText("Dry-run environment output appears here...")
    editor_layout.addWidget(dry_run_box, 1)
    splitter.addWidget(editor_widget)
    splitter.setSizes([680, 480])

    games_cache: list[dict[str, Any]] = []
    filtered_games: list[dict[str, Any]] = []
    current_game: dict[str, Any] = {}
    updating_ui = False
    library_worker: Any = None
    library_in_flight = False

    def collect_editor_profile() -> dict[str, str]:
        prof = {key: ("1" if cb.isChecked() else "0") for key, cb in checkboxes.items()}
        prof["VRR_CAP"] = vrr_edit.text().strip()
        return prof

    def apply_editor_profile(prof: dict[str, str], warns: list[str]) -> None:
        nonlocal updating_ui
        updating_ui = True
        try:
            for key, cb in checkboxes.items():
                cb.setChecked(prof.get(key, "0") == "1")
            vrr_edit.setText(prof.get("VRR_CAP", ""))
            warning_label.setText("\n".join(warns))
        finally:
            updating_ui = False

    def on_toggle_changed() -> None:
        if updating_ui or not current_game:
            return
        norm, warns = validate_profile(collect_editor_profile(), current_game.get("class", "standard"))
        apply_editor_profile(norm, warns)

    for cb in checkboxes.values():
        cb.stateChanged.connect(lambda _state: on_toggle_changed())
    vrr_edit.editingFinished.connect(on_toggle_changed)

    def populate_table() -> None:
        nonlocal filtered_games
        query = search_edit.text().strip().lower()
        filtered_games = [
            g for g in games_cache
            if not query
            or query in g["appid"].lower()
            or query in g["name"].lower()
            or query in g["class"].lower()
            or query in g["source"].lower()
        ]
        table.setRowCount(len(filtered_games))
        for row, g in enumerate(filtered_games):
            values = (
                g["appid"],
                g["name"],
                g["source"],
                g["class"],
                g["synced"],
                "Saved" if g["has_profile"] else "Auto",
            )
            for col, val in enumerate(values):
                table.setItem(row, col, QtWidgets.QTableWidgetItem(val))
        table.resizeColumnsToContents()

    def on_games_loaded(loaded_games: list[dict[str, Any]]) -> None:
        nonlocal games_cache, library_in_flight, library_worker
        if shutting_down or backend.is_cancelled():
            library_in_flight = False
            library_worker = None
            return
        games_cache = loaded_games
        populate_table()
        library_in_flight = False
        library_worker = None
        refresh_games_btn.setEnabled(True)
        status_bar.showMessage(f"Loaded {len(games_cache)} title(s) (Steam + Non-Steam shortcuts).")

    bridge.games_ready.connect(on_games_loaded, QtCore.Qt.ConnectionType.QueuedConnection)

    def reload_games() -> None:
        nonlocal library_worker, library_in_flight
        if shutting_down or backend.is_cancelled() or library_in_flight:
            return
        library_in_flight = True
        refresh_games_btn.setEnabled(False)
        status_bar.showMessage("Scanning Steam libraries and shortcuts.vdf...")

        def _scan() -> None:
            if shutting_down or backend.is_cancelled():
                return
            try:
                games = backend.discover_games()
            except Exception:
                games = []
            if shutting_down or backend.is_cancelled():
                return
            try:
                bridge.games_ready.emit(games)
            except RuntimeError:
                pass

        worker = threading.Thread(target=_scan, name="steam-auto-ui-library", daemon=True)
        library_worker = worker
        worker.start()

    def on_row_selected() -> None:
        nonlocal current_game
        rows = table.selectionModel().selectedRows()
        if not rows:
            return
        idx = rows[0].row()
        if idx < 0 or idx >= len(filtered_games):
            return
        current_game = filtered_games[idx]
        selected_label.setText(
            f"{current_game['name']} (AppID {current_game['appid']} | source: {current_game['source']}) — "
            f"Class: {current_game['class']} | Synced: {current_game['synced']}"
        )
        uinfo = current_game.get("upscaler_info", "None detected")
        upscaler_badge.setText(f"Upscaler SDK: {uinfo}")
        if "PROTON_FSR4_UPGRADE=1" in uinfo and "will not hook" not in uinfo:
            upscaler_badge.setStyleSheet("color: #15803d; font-weight: bold;")
        elif "USE_OPTISCALER=1" in uinfo:
            upscaler_badge.setStyleSheet("color: #b45309; font-weight: bold;")
        else:
            upscaler_badge.setStyleSheet("color: #64748b;")
        prof = backend.load_profile(current_game["appid"])
        norm, warns = validate_profile(prof, current_game.get("class", "standard"))
        apply_editor_profile(norm, warns)
        details = current_game.get("rationale", "")
        if current_game.get("launch_options"):
            details = f"Shortcut LaunchOptions: {current_game['launch_options']}\n{details}".strip()
        dry_run_box.setPlainText(details)

    def on_save_profile() -> None:
        if not current_game:
            return
        path, warns = backend.save_profile(
            current_game["appid"],
            collect_editor_profile(),
            current_game.get("class", "standard"),
        )
        current_game["has_profile"] = True
        populate_table()
        warning_label.setText("\n".join(warns))
        status_bar.showMessage(f"Saved {path}")

    def on_dry_run() -> None:
        if not current_game:
            return
        status_bar.showMessage(f"Running dry-run for AppID {current_game['appid']}...")
        app.processEvents()
        out = backend.dry_run(current_game["appid"], is_vr=bool(current_game.get("is_vr")))
        dry_run_box.setPlainText(out)
        status_bar.showMessage("Dry-run complete.")

    def on_reset_profile() -> None:
        if not current_game:
            return
        msg = backend.reset_profile(current_game["appid"])
        current_game["has_profile"] = False
        populate_table()
        prof = backend.load_profile(current_game["appid"])
        apply_editor_profile(prof, [])
        status_bar.showMessage(msg)

    search_edit.textChanged.connect(lambda _txt: populate_table())
    refresh_games_btn.clicked.connect(reload_games)
    table.itemSelectionChanged.connect(on_row_selected)
    save_btn.clicked.connect(on_save_profile)
    dry_run_btn.clicked.connect(on_dry_run)
    reset_btn.clicked.connect(on_reset_profile)
    tabs.addTab(tab_games, "1. Games & Profiles")

    # --- Tab 2: System & Network Live Telemetry ---
    tab_tel = QtWidgets.QWidget()
    tel_layout = QtWidgets.QVBoxLayout(tab_tel)
    tel_bar = QtWidgets.QHBoxLayout()
    tel_refresh_btn = QtWidgets.QPushButton("Refresh Telemetry")
    tel_auto_cb = QtWidgets.QCheckBox("Auto-refresh (3s)")
    tel_bar.addWidget(tel_refresh_btn)
    tel_bar.addWidget(tel_auto_cb)
    tel_bar.addStretch(1)
    tel_layout.addLayout(tel_bar)

    tel_box = QtWidgets.QPlainTextEdit()
    tel_box.setReadOnly(True)
    tel_box.setPlainText("Loading telemetry...")
    tel_layout.addWidget(tel_box, 1)

    telemetry_worker: Any = None
    telemetry_in_flight = False

    def on_telemetry_ready(text: str) -> None:
        nonlocal telemetry_in_flight, telemetry_worker
        if shutting_down or backend.is_cancelled():
            telemetry_in_flight = False
            telemetry_worker = None
            return
        scrollbar = tel_box.verticalScrollBar()
        prev_scroll = scrollbar.value() if scrollbar is not None else 0
        tel_box.setPlainText(text)
        if scrollbar is not None:
            scrollbar.setValue(min(prev_scroll, scrollbar.maximum()))
        telemetry_in_flight = False
        telemetry_worker = None
        tel_refresh_btn.setEnabled(True)
        status_bar.showMessage("Telemetry updated.")

    bridge.telemetry_ready.connect(on_telemetry_ready, QtCore.Qt.ConnectionType.QueuedConnection)

    def refresh_telemetry() -> None:
        nonlocal telemetry_worker, telemetry_in_flight
        if shutting_down or backend.is_cancelled() or telemetry_in_flight:
            return
        telemetry_in_flight = True
        tel_refresh_btn.setEnabled(False)

        def _collect() -> None:
            if shutting_down or backend.is_cancelled():
                return
            try:
                telemetry = backend.collect_telemetry()
                if shutting_down or backend.is_cancelled():
                    return
                text = backend.format_telemetry_text(telemetry)
            except Exception as exc:
                if shutting_down or backend.is_cancelled():
                    return
                text = f"Error collecting telemetry: {exc}"
            if shutting_down or backend.is_cancelled():
                return
            try:
                bridge.telemetry_ready.emit(text)
            except RuntimeError:
                pass

        worker = threading.Thread(target=_collect, name="steam-auto-ui-telemetry", daemon=True)
        telemetry_worker = worker
        worker.start()

    tel_timer = QtCore.QTimer(win)
    tel_timer.setInterval(3000)
    tel_timer.timeout.connect(refresh_telemetry)
    tel_refresh_btn.clicked.connect(refresh_telemetry)
    tel_auto_cb.stateChanged.connect(lambda _s: tel_timer.start() if tel_auto_cb.isChecked() else tel_timer.stop())
    tabs.addTab(tab_tel, "2. System & Telemetry")

    # --- Tab 3: Library Sync & Maintenance ---
    tab_sync = QtWidgets.QWidget()
    sync_layout = QtWidgets.QVBoxLayout(tab_sync)
    steam_banner = QtWidgets.QLabel("")
    steam_banner.setWordWrap(True)
    sync_layout.addWidget(steam_banner)

    sync_btns = QtWidgets.QHBoxLayout()
    btn_report = QtWidgets.QPushButton("Sync Report (--report)")
    btn_san_dry = QtWidgets.QPushButton("Sanitize Preview (--sanitize --dry-run)")
    btn_san_apply = QtWidgets.QPushButton("Apply Sanitize (--sanitize)")
    btn_migrate = QtWidgets.QPushButton("Migrate cachy-run Profiles")
    for b in (btn_report, btn_san_dry, btn_san_apply, btn_migrate):
        sync_btns.addWidget(b)
    sync_layout.addLayout(sync_btns)

    sync_out = QtWidgets.QPlainTextEdit()
    sync_out.setReadOnly(True)
    sync_layout.addWidget(sync_out, 1)

    def update_steam_banner() -> bool:
        running = backend.is_steam_running()
        if running:
            steam_banner.setText("WARNING: Steam is currently running. Close Steam before running write operations (--sanitize).")
            steam_banner.setStyleSheet("color: #dc2626; font-weight: bold;")
        else:
            steam_banner.setText("Steam is closed. Safe to run library sync and sanitize operations.")
            steam_banner.setStyleSheet("color: #16a34a; font-weight: bold;")
        return running

    def trigger_sync(mode: str, needs_closed_steam: bool = False) -> None:
        running = update_steam_banner()
        if needs_closed_steam and running:
            QtWidgets.QMessageBox.warning(
                win,
                "Steam Is Running",
                "Close Steam completely before modifying localconfig.vdf.",
            )
            return
        status_bar.showMessage(f"Running steam-auto-sync ({mode})...")
        app.processEvents()
        rc, out = backend.run_sync(mode)
        sync_out.setPlainText(out or f"(completed with exit code {rc})")
        status_bar.showMessage(f"Sync ({mode}) finished with exit code {rc}.")

    btn_report.clicked.connect(lambda: trigger_sync("report", False))
    btn_san_dry.clicked.connect(lambda: trigger_sync("sanitize_dry", False))
    btn_san_apply.clicked.connect(lambda: trigger_sync("sanitize", True))
    btn_migrate.clicked.connect(lambda: trigger_sync("migrate", False))
    tabs.addTab(tab_sync, "3. Library Sync")

    # --- Tab 4: Last Launch Log & Crash Recovery ---
    tab_logs = QtWidgets.QWidget()
    logs_layout = QtWidgets.QVBoxLayout(tab_logs)
    logs_bar = QtWidgets.QHBoxLayout()
    log_combo = QtWidgets.QComboBox()
    logs_refresh_btn = QtWidgets.QPushButton("Refresh Logs")
    safe_appid_edit = QtWidgets.QLineEdit()
    safe_appid_edit.setPlaceholderText("AppID")
    safe_appid_edit.setMaximumWidth(120)
    safe_mode_btn = QtWidgets.QPushButton("Apply Safe Mode (USE_XWAYLAND=1, USE_SAFEDX12=1)")
    logs_bar.addWidget(log_combo, 1)
    logs_bar.addWidget(logs_refresh_btn)
    logs_bar.addWidget(QtWidgets.QLabel("Target AppID:"))
    logs_bar.addWidget(safe_appid_edit)
    logs_bar.addWidget(safe_mode_btn)
    logs_layout.addLayout(logs_bar)

    crash_banner = QtWidgets.QLabel("")
    crash_banner.setWordWrap(True)
    crash_banner.setStyleSheet("color: #dc2626; font-weight: bold;")
    logs_layout.addWidget(crash_banner)

    log_view = QtWidgets.QPlainTextEdit()
    log_view.setReadOnly(True)
    logs_layout.addWidget(log_view, 1)

    log_paths: list[Path] = []

    def display_selected_log() -> None:
        idx = log_combo.currentIndex()
        if idx < 0 or idx >= len(log_paths):
            log_view.setPlainText("No last-launch logs found.")
            crash_banner.setText("")
            return
        data = backend.read_log(log_paths[idx])
        log_view.setPlainText(data["text"])
        if data["appid"] and data["appid"].isdigit():
            safe_appid_edit.setText(data["appid"])
        if data["crash_hint"]:
            crash_banner.setText(f"Crash Hint: {data['crash_hint']}")
        else:
            crash_banner.setText("")

    def refresh_logs() -> None:
        nonlocal log_paths
        log_paths = backend.list_logs()
        log_combo.blockSignals(True)
        log_combo.clear()
        for p in log_paths:
            log_combo.addItem(p.name)
        log_combo.blockSignals(False)
        display_selected_log()

    def on_apply_safe_mode() -> None:
        appid = safe_appid_edit.text().strip()
        if not appid.isdigit():
            QtWidgets.QMessageBox.warning(win, "Invalid AppID", "Enter a numeric Steam AppID first.")
            return
        path, _ = backend.apply_safe_mode(appid)
        status_bar.showMessage(f"Applied Safe Mode (USE_XWAYLAND=1, USE_SAFEDX12=1) to {path}")
        QtWidgets.QMessageBox.information(
            win,
            "Safe Mode Saved",
            f"Saved USE_XWAYLAND=1 and USE_SAFEDX12=1 for AppID {appid} ({path}).",
        )
        reload_games()

    log_combo.currentIndexChanged.connect(lambda _i: display_selected_log())
    logs_refresh_btn.clicked.connect(refresh_logs)
    safe_mode_btn.clicked.connect(on_apply_safe_mode)
    tabs.addTab(tab_logs, "4. Logs & Recovery")

    # --- Tab 5: Benchmarks Comparison ---
    tab_bench = QtWidgets.QWidget()
    bench_layout = QtWidgets.QVBoxLayout(tab_bench)
    bench_bar = QtWidgets.QHBoxLayout()
    bench_filter_edit = QtWidgets.QLineEdit()
    bench_filter_edit.setPlaceholderText("Filter benchmarks by AppID (blank = all runs)")
    bench_refresh_btn = QtWidgets.QPushButton("Refresh Benchmarks")
    bench_bar.addWidget(bench_filter_edit)
    bench_bar.addWidget(bench_refresh_btn)
    bench_layout.addLayout(bench_bar)

    bench_table = QtWidgets.QTableWidget(0, 11)
    bench_table.setHorizontalHeaderLabels([
        "Timestamp", "AppID", "Avg FPS", "1% Low FPS", "P99 (ms)",
        "Samples", "FSR4", "MLFG", "XWayland", "SafeDX12", "VRR Cap",
    ])
    bench_table.setEditTriggers(QtWidgets.QAbstractItemView.EditTrigger.NoEditTriggers)
    bench_table.horizontalHeader().setStretchLastSection(True)
    bench_layout.addWidget(bench_table, 1)

    bench_hint = QtWidgets.QLabel("Record silent frametime benchmarks with: BENCH=1 steam-auto-run %command%")
    bench_layout.addWidget(bench_hint)

    def refresh_benchmarks() -> None:
        flt = bench_filter_edit.text().strip()
        runs = backend.list_benchmarks(flt if flt.isdigit() else None)
        bench_table.setRowCount(len(runs))
        for row, r in enumerate(runs):
            vals = (
                str(r.get("timestamp", ""))[:19].replace("T", " "),
                str(r.get("appid", "")),
                f"{float(r.get('avg_fps', 0)):.2f}",
                f"{float(r.get('low_1pct_fps', 0)):.2f}",
                f"{float(r.get('p99_frametime_ms', 0)):.2f}",
                str(r.get("samples", 0)),
                "On" if r.get("fsr4") else "Off",
                "On" if r.get("mlfg") else "Off",
                "On" if r.get("xwayland") else "Off",
                "On" if r.get("safedx12") else "Off",
                str(r.get("vrr_cap", 0)),
            )
            for col, val in enumerate(vals):
                bench_table.setItem(row, col, QtWidgets.QTableWidgetItem(val))
        bench_table.resizeColumnsToContents()

    def jump_to_game_benchmarks() -> None:
        if current_game:
            bench_filter_edit.setText(current_game["appid"])
        refresh_benchmarks()
        tabs.setCurrentWidget(tab_bench)

    bench_filter_edit.textChanged.connect(lambda _t: refresh_benchmarks())
    bench_refresh_btn.clicked.connect(refresh_benchmarks)
    bench_jump_btn.clicked.connect(jump_to_game_benchmarks)
    tabs.addTab(tab_bench, "5. Benchmarks")

    sigint_timer = QtCore.QTimer(win)
    sigint_timer.setInterval(100)

    def shutdown_ui() -> None:
        nonlocal shutting_down
        already_shutting_down = shutting_down
        shutting_down = True
        tel_timer.stop()
        sigint_timer.stop()
        backend.cancel(grace_sec=0.0 if already_shutting_down else 0.05)
        if already_shutting_down:
            return
        deadline = time.monotonic() + 0.15
        for worker in (telemetry_worker, library_worker):
            if worker is not None and worker.is_alive():
                remaining = deadline - time.monotonic()
                if remaining > 0:
                    worker.join(timeout=remaining)

    def _poll_sigint() -> None:
        if sigint_received:
            shutdown_ui()
            win.close()
            app.quit()

    sigint_timer.timeout.connect(_poll_sigint)
    app.aboutToQuit.connect(shutdown_ui)

    prev_sigint: Any = None
    installed_sigint = False
    if threading.current_thread() is threading.main_thread():
        def _handle_sigint(_signum: int, _frame: Any) -> None:
            nonlocal sigint_received
            sigint_received = True
            backend.cancel_event.set()

        prev_sigint = signal.getsignal(signal.SIGINT)
        signal.signal(signal.SIGINT, _handle_sigint)
        installed_sigint = True
        sigint_timer.start()

    # Lightweight reads first, show window immediately, then load heavy library/telemetry off-thread.
    update_steam_banner()
    refresh_logs()
    refresh_benchmarks()
    status_bar.showMessage("Loading library and telemetry...")

    win.show()
    QtCore.QTimer.singleShot(0, reload_games)
    QtCore.QTimer.singleShot(0, refresh_telemetry)
    try:
        rc = int(app.exec())
    except KeyboardInterrupt:
        sigint_received = True
        rc = 0
    finally:
        shutdown_ui()
        if installed_sigint:
            signal.signal(signal.SIGINT, prev_sigint)
    return 0 if sigint_received else rc


def run_curses_tui(backend: ProfilerBackend) -> int:
    """Zero-dependency stdlib curses 5-view TUI."""

    def _main(stdscr: Any) -> int:
        curses.curs_set(0)
        stdscr.nodelay(False)
        stdscr.keypad(True)

        active_tab = 0
        tab_names = ("1:Games", "2:Telemetry", "3:Sync", "4:Logs", "5:Bench")
        games = backend.discover_games()
        search_query = ""
        selected_idx = 0
        scroll = 0
        status_msg = "Tabs: 1-5/Tab | q:Quit"
        profile_cache: dict[str, str] = {}
        last_appid = ""
        output_lines: list[str] = []
        telemetry_lines = backend.format_telemetry_text(backend.collect_telemetry()).splitlines()
        sync_lines = ["Press [a] Report, [d] Sanitize Dry-Run, [s] Apply Sanitize, [m] Migrate cachy-run"]
        logs = backend.list_logs()
        log_idx = 0
        bench_lines = backend.format_benchmarks_text(backend.list_benchmarks()).splitlines()

        def get_filtered() -> list[dict[str, Any]]:
            q = search_query.lower()
            return [
                g for g in games
                if not q
                or q in g["appid"].lower()
                or q in g["name"].lower()
                or q in g["class"].lower()
                or q in g["source"].lower()
            ]

        while True:
            stdscr.erase()
            max_y, max_x = stdscr.getmaxyx()
            header = " Steam Auto-Profiler TUI  |  " + "  ".join(
                f"[{t}]" if i == active_tab else f" {t} " for i, t in enumerate(tab_names)
            )
            stdscr.addnstr(0, 0, header.ljust(max_x), max_x - 1, curses.A_REVERSE)

            body_h = max(1, max_y - 3)
            if active_tab == 0:
                filtered = get_filtered()
                if filtered:
                    selected_idx = max(0, min(selected_idx, len(filtered) - 1))
                    cur = filtered[selected_idx]
                    if cur["appid"] != last_appid:
                        profile_cache = backend.load_profile(cur["appid"])
                        last_appid = cur["appid"]
                else:
                    cur = None

                stdscr.addnstr(1, 0, f"Filter (/): {search_query or '(all)'} | Count: {len(filtered)}", max_x - 1)
                split_x = max(36, min(max_x // 2, 62))
                for row_i in range(body_h - 1):
                    idx = row_i + max(0, selected_idx - (body_h - 3))
                    if idx >= len(filtered):
                        break
                    g = filtered[idx]
                    mark = "*" if g["has_profile"] else " "
                    src = "[sc]" if g["source"] == "shortcut" else "    "
                    line = f"{mark}{g['appid']:>10} {src} {g['name'][:18]:<18} [{g['class'][:8]}] {g['synced']}"
                    attr = curses.A_REVERSE if idx == selected_idx else curses.A_NORMAL
                    stdscr.addnstr(2 + row_i, 0, line, split_x - 1, attr)

                if cur is not None and max_x > split_x + 10:
                    stdscr.addnstr(
                        2,
                        split_x,
                        f"AppID: {cur['appid']} ({cur['class']} | {cur['source']})",
                        max_x - split_x - 1,
                        curses.A_BOLD,
                    )
                    stdscr.addnstr(
                        3,
                        split_x,
                        f"SDK: {cur.get('upscaler_info', 'None detected')}",
                        max_x - split_x - 1,
                    )
                    hotkeys = ("x", "f", "m", "b", "d", "n", "l", "o", "u", "h")
                    for i, ((k, label), hk) in enumerate(zip(PROFILE_TOGGLES, hotkeys)):
                        if 4 + i >= max_y - 2:
                            break
                        val = "ON " if profile_cache.get(k, "0") == "1" else "OFF"
                        stdscr.addnstr(4 + i, split_x, f"[{hk}] {val} {label}", max_x - split_x - 1)
                    base_y = 4 + len(PROFILE_TOGGLES)
                    if base_y < max_y - 2:
                        stdscr.addnstr(
                            base_y,
                            split_x,
                            f"[v]VRR_CAP: {profile_cache.get('VRR_CAP') or 'Auto'} | [s]Save [p]DryRun [R]Reset",
                            max_x - split_x - 1,
                        )
                    for j, oline in enumerate(output_lines[: max(0, max_y - base_y - 3)]):
                        stdscr.addnstr(base_y + 1 + j, split_x, oline, max_x - split_x - 1)

            elif active_tab == 1:
                for row_i in range(body_h):
                    idx = scroll + row_i
                    if idx >= len(telemetry_lines):
                        break
                    stdscr.addnstr(1 + row_i, 0, telemetry_lines[idx], max_x - 1)

            elif active_tab == 2:
                steam_warn = "WARNING: Steam is running!" if backend.is_steam_running() else "Steam is closed (safe to sync)."
                stdscr.addnstr(1, 0, f"{steam_warn}  [a]Report [d]Sanitize Dry [s]Apply Sanitize [m]Migrate", max_x - 1, curses.A_BOLD)
                for row_i in range(body_h - 1):
                    idx = scroll + row_i
                    if idx >= len(sync_lines):
                        break
                    stdscr.addnstr(2 + row_i, 0, sync_lines[idx], max_x - 1)

            elif active_tab == 3:
                if logs:
                    log_idx = max(0, min(log_idx, len(logs) - 1))
                    ldata = backend.read_log(logs[log_idx])
                    hdr = f"Log ({log_idx + 1}/{len(logs)}): {ldata['name']} | AppID={ldata['appid']} | [n/p]Switch [S]Apply Safe Mode"
                    stdscr.addnstr(1, 0, hdr, max_x - 1, curses.A_BOLD)
                    log_lines = ldata["text"].splitlines()
                    if ldata["crash_hint"]:
                        log_lines = [f"!!! {ldata['crash_hint']} !!!", ""] + log_lines
                    for row_i in range(body_h - 1):
                        idx = scroll + row_i
                        if idx >= len(log_lines):
                            break
                        stdscr.addnstr(2 + row_i, 0, log_lines[idx], max_x - 1)
                else:
                    stdscr.addnstr(2, 0, "No launch logs found in state directory.", max_x - 1)

            elif active_tab == 4:
                stdscr.addnstr(1, 0, "Benchmarks (press [r] to refresh | record via BENCH=1 steam-auto-run %command%)", max_x - 1, curses.A_BOLD)
                for row_i in range(body_h - 1):
                    idx = scroll + row_i
                    if idx >= len(bench_lines):
                        break
                    stdscr.addnstr(2 + row_i, 0, bench_lines[idx], max_x - 1)

            stdscr.addnstr(max_y - 1, 0, status_msg.ljust(max_x), max_x - 1, curses.A_REVERSE)
            stdscr.refresh()

            ch = stdscr.getch()
            if ch in (ord("q"), ord("Q")):
                return 0
            if ch in (ord("1"), ord("2"), ord("3"), ord("4"), ord("5")):
                active_tab = ch - ord("1")
                scroll = 0
                continue
            if ch == 9:  # Tab
                active_tab = (active_tab + 1) % 5
                scroll = 0
                continue

            if active_tab == 0:
                filtered = get_filtered()
                if ch in (curses.KEY_DOWN, ord("j")) and filtered:
                    selected_idx = min(len(filtered) - 1, selected_idx + 1)
                elif ch in (curses.KEY_UP, ord("k")) and filtered:
                    selected_idx = max(0, selected_idx - 1)
                elif ch == ord("/"):
                    curses.echo()
                    stdscr.addnstr(max_y - 1, 0, "Filter: ".ljust(max_x), max_x - 1, curses.A_REVERSE)
                    raw = stdscr.getstr(max_y - 1, 8, 40)
                    curses.noecho()
                    search_query = raw.decode("utf-8", errors="ignore").strip()
                    selected_idx = 0
                elif filtered:
                    cur = filtered[selected_idx]
                    hk_map = {
                        ord("x"): "USE_XWAYLAND",
                        ord("f"): "USE_FSR4",
                        ord("m"): "USE_MLFG",
                        ord("b"): "USE_SHARPEN",
                        ord("d"): "USE_SAFEDX12",
                        ord("n"): "USE_NET_OPT",
                        ord("l"): "USE_SDL",
                        ord("o"): "USE_KEEP_OVERLAY",
                        ord("u"): "USE_OPTISCALER",
                        ord("h"): "AUTO_HDR_SWITCH",
                    }
                    if ch in hk_map:
                        k = hk_map[ch]
                        profile_cache[k] = "0" if profile_cache.get(k, "0") == "1" else "1"
                        profile_cache, warns = validate_profile(profile_cache, cur["class"])
                        status_msg = warns[0] if warns else f"Toggled {k}={profile_cache[k]}"
                    elif ch == ord("v"):
                        curses.echo()
                        stdscr.addnstr(max_y - 1, 0, "VRR_CAP (blank=Auto, 0=Off): ".ljust(max_x), max_x - 1, curses.A_REVERSE)
                        raw = stdscr.getstr(max_y - 1, 29, 10)
                        curses.noecho()
                        profile_cache["VRR_CAP"] = raw.decode("utf-8", errors="ignore").strip()
                        profile_cache, warns = validate_profile(profile_cache, cur["class"])
                        status_msg = warns[0] if warns else f"VRR_CAP={profile_cache['VRR_CAP'] or 'Auto'}"
                    elif ch == ord("s"):
                        path, warns = backend.save_profile(cur["appid"], profile_cache, cur["class"])
                        cur["has_profile"] = True
                        status_msg = f"Saved {path}" + (f" ({warns[0]})" if warns else "")
                    elif ch == ord("p"):
                        output_lines = backend.dry_run(cur["appid"], is_vr=cur["is_vr"]).splitlines()
                        status_msg = f"Dry-run refreshed for {cur['appid']}"
                    elif ch == ord("R"):
                        status_msg = backend.reset_profile(cur["appid"])
                        cur["has_profile"] = False
                        profile_cache = backend.load_profile(cur["appid"])

            elif active_tab == 1:
                if ch in (curses.KEY_DOWN, ord("j")):
                    scroll = min(max(0, len(telemetry_lines) - 1), scroll + 1)
                elif ch in (curses.KEY_UP, ord("k")):
                    scroll = max(0, scroll - 1)
                elif ch == ord("r"):
                    telemetry_lines = backend.format_telemetry_text(backend.collect_telemetry()).splitlines()
                    scroll = 0
                    status_msg = "Telemetry refreshed."

            elif active_tab == 2:
                if ch in (curses.KEY_DOWN, ord("j")):
                    scroll = min(max(0, len(sync_lines) - 1), scroll + 1)
                elif ch in (curses.KEY_UP, ord("k")):
                    scroll = max(0, scroll - 1)
                elif ch == ord("a"):
                    _, out = backend.run_sync("report")
                    sync_lines = out.splitlines() or ["(no output)"]
                    scroll = 0
                elif ch == ord("d"):
                    _, out = backend.run_sync("sanitize_dry")
                    sync_lines = out.splitlines() or ["(no output)"]
                    scroll = 0
                elif ch == ord("s"):
                    if backend.is_steam_running():
                        status_msg = "Refused: close Steam before running --sanitize."
                    else:
                        _, out = backend.run_sync("sanitize")
                        sync_lines = out.splitlines() or ["(no output)"]
                        scroll = 0
                elif ch == ord("m"):
                    _, out = backend.run_sync("migrate")
                    sync_lines = out.splitlines() or ["(no output)"]
                    scroll = 0

            elif active_tab == 3:
                if ch in (curses.KEY_DOWN, ord("j")):
                    scroll += 1
                elif ch in (curses.KEY_UP, ord("k")):
                    scroll = max(0, scroll - 1)
                elif ch == ord("n") and logs:
                    log_idx = (log_idx + 1) % len(logs)
                    scroll = 0
                elif ch == ord("p") and logs:
                    log_idx = (log_idx - 1) % len(logs)
                    scroll = 0
                elif ch == ord("r"):
                    logs = backend.list_logs()
                    scroll = 0
                elif ch == ord("S") and logs:
                    ldata = backend.read_log(logs[log_idx])
                    if ldata["appid"].isdigit():
                        path, _ = backend.apply_safe_mode(ldata["appid"])
                        status_msg = f"Applied Safe Mode for AppID {ldata['appid']} ({path})"
                    else:
                        status_msg = "Selected log has no numeric AppID."

            elif active_tab == 4:
                if ch in (curses.KEY_DOWN, ord("j")):
                    scroll = min(max(0, len(bench_lines) - 1), scroll + 1)
                elif ch in (curses.KEY_UP, ord("k")):
                    scroll = max(0, scroll - 1)
                elif ch == ord("r"):
                    bench_lines = backend.format_benchmarks_text(backend.list_benchmarks()).splitlines()
                    scroll = 0
                    status_msg = "Benchmarks refreshed."

    try:
        return curses.wrapper(_main)
    except KeyboardInterrupt:
        backend.cancel()
        return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Unified Qt6 GUI + curses TUI control center for Steam Auto-Profiler."
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--gui", action="store_true", help="Launch native Qt6 GUI (PySide6/PyQt6)")
    mode.add_argument("--tui", action="store_true", help="Launch terminal curses TUI")
    mode.add_argument("--check", action="store_true", help="Run headless CI self-check and exit")
    args = parser.parse_args()

    backend = ProfilerBackend()

    try:
        if args.check:
            return run_self_check(backend)
        if args.gui:
            return run_qt_gui(backend)
        if args.tui:
            return run_curses_tui(backend)

        qt_name, _ = detect_qt_binding()
        has_display = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
        if qt_name and has_display:
            return run_qt_gui(backend)
        if sys.stdin.isatty() and sys.stdout.isatty():
            return run_curses_tui(backend)
        print(
            "No graphical display or interactive TTY detected. Run with --check, --tui, or --gui.",
            file=sys.stderr,
        )
        return 1
    except KeyboardInterrupt:
        backend.cancel()
        return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
